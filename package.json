{
  "name": "india-atlas",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/fetch.mjs && node scripts/validate.mjs",
    "data:mock": "node scripts/fetch.mjs --mock && node scripts/validate.mjs",
    "dev": "npm run data && astro dev",
    "og": "node scripts/og.mjs",
    "build": "npm run data && npm run og && astro build",
    "preview": "astro preview",
    "qc": "node scripts/qc.mjs && node scripts/lint-charts.mjs",
    "gates": "node scripts/validate.mjs && node scripts/qc.mjs && node scripts/lint-charts.mjs",
    "test": "node --test",
    "facts": "node pipeline/facts.mjs --all",
    "prose": "npm run facts && node pipeline/generate.mjs --all",
    "prose:dry": "npm run facts && node pipeline/generate.mjs --all --dry-run",
    "prose:turing": "node pipeline/turing.mjs",
    "lint:charts": "node scripts/lint-charts.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@observablehq/plot": "0.6.17",
    "astro": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "wawoff2": "^2.0.1"
  }
}