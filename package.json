{
  "name": "india-atlas",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/fetch.mjs && node scripts/validate.mjs",
    "dev": "npm run data && astro dev",
    "og": "node scripts/og.mjs",
    "brand": "node scripts/brand.mjs",
    "build": "npm run data && npm run og && astro build",
    "preview": "astro preview",
    "qc": "node --max-old-space-size=6144 scripts/qc.mjs && node --max-old-space-size=6144 scripts/lint-charts.mjs && node --max-old-space-size=6144 scripts/lint-charts.mjs --width 390",
    "gates": "node scripts/validate.mjs && node scripts/kit-specimen-lint.mjs && node scripts/coverage.mjs && node pipeline/asof.mjs && node --max-old-space-size=6144 scripts/qc.mjs && node --max-old-space-size=6144 scripts/lint-charts.mjs && node --max-old-space-size=6144 scripts/lint-charts.mjs --width 390 && node scripts/masthead-fit.mjs && npm run explore:verify && npm run seo && npm run perf",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "facts": "node pipeline/facts.mjs --all",
    "asof": "node pipeline/asof.mjs",
    "census": "node scripts/census.mjs",
    "prose": "npm run facts && node pipeline/generate.mjs --all",
    "prose:dry": "npm run facts && node pipeline/generate.mjs --all --dry-run",
    "prose:turing": "node pipeline/turing.mjs",
    "lint:kit": "node scripts/kit-specimen-lint.mjs",
    "lint:masthead": "node scripts/masthead-fit.mjs",
    "lint:charts": "node --max-old-space-size=6144 scripts/lint-charts.mjs && node --max-old-space-size=6144 scripts/lint-charts.mjs --width 390",
    "coverage": "node scripts/coverage.mjs",
    "coverage:expansion": "node scripts/expansion-audit.mjs",
    "crosscheck:idh": "node scripts/crosscheck-idh.mjs",
    "archive": "node scripts/archive.mjs",
    "explore:verify": "node scripts/explore-verify.mjs",
    "perf": "npm run perf:static && node scripts/perf-browser.mjs",
    "perf:static": "node scripts/fonts-build.mjs --check && node scripts/perf-budget.mjs && node scripts/perf-search.mjs",
    "fonts": "node scripts/fonts-build.mjs",
    "seo": "node scripts/seo-check.mjs",
    "releases": "node scripts/releases.mjs",
    "perf:search-browser": "node scripts/perf-search-browser.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@observablehq/plot": "0.6.17",
    "astro": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "acorn": "8.18.0",
    "esbuild": "0.27.7",
    "jsdom": "^29.1.1",
    "parse5": "7.3.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.3",
    "subset-font": "2.9.0",
    "wawoff2": "^2.0.1"
  }
}
