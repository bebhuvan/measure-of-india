---
import Base from "../../layouts/Base.astro";
import GuideData from "../../components/GuideData.astro";
import EveryCut from "../../components/EveryCut.astro";
import { bySlug, kicker } from "../../dossiers/registry.js";
import { dateStamp } from "../../dossiers/display.js";
const D = bySlug["factories"];
// industry wages and plant size, read from the bundle (2-digit NIC, latest survey year)
import ind from "../../../data/series/asi-industries.json";
const II = ind.dates.length - 1, asiFy = `${ind.dates[II].slice(0, 4)}-${String((+ind.dates[II].slice(0, 4) + 1) % 100).padStart(2, "0")}`;
const SHORTN = { "12": "tobacco products", "19": "coke and refined petroleum", "29": "motor vehicles", "16": "wood products", "01": "crop and animal services", "21": "pharmaceuticals", "26": "electronics" };
const nicRows = [...new Set(Object.keys(ind.series).filter((k) => k.startsWith("persons_engaged_")).map((k) => k.slice(16)))].filter((c) => c !== "99998")
  .map((c) => { const g = (k) => ind.series[`${k}_${c}`]?.data[II]; return { c, wage: (g("emoluments") * 1e5) / g("persons_engaged"), size: g("persons_engaged") / g("factories_in_operation") }; })
  .filter((r) => Number.isFinite(r.wage) && Number.isFinite(r.size));
const byWage = [...nicRows].sort((a, b) => a.wage - b.wage), bySize = [...nicRows].sort((a, b) => a.size - b.size);
const inrK = (v) => v >= 1e5 ? `₹${(v / 1e5).toFixed(1)} lakh` : `₹${Math.round(v / 1000)},000`;
const nm = (c) => SHORTN[c] ?? c;
// the calendar-year 2025 ASUSE round: workers by detailed activity and gender
import u25 from "../../../data/series/asuse-2025-t26.json";
import ua from "../../../data/series/asuse-annual.json";
const NOT_ACT = new Set(["All India", "OAE", "HWE", "Urban", "Rural", "Other Services", "Trading Activities", "Manufacturing Activities"]);
const actW = {};
for (const s of Object.values(u25.series)) { const [a, g, w] = s.label.split(" · "); if (w === "working time: all") (actW[a] ??= {})[g] = s.data[0]; }
const u25All = actW["All India"]["gender: all"], u25F = actW["All India"].Female;
const trades = Object.entries(actW).filter(([a]) => !NOT_ACT.has(a)).map(([a, v]) => ({ a, n: v["gender: all"], f: v.Female })).sort((x, y) => y.n - x.n);
const nextThree = trades.slice(1, 4).reduce((t, r) => t + r.n, 0);
const lakhN = (v) => (v >= 1e7 ? `${(v / 1e7).toFixed(1)} crore` : `${Math.round(v / 1e5)} lakh`);
const wShare = trades.filter((r) => r.n >= 5e5).map((r) => ({ ...r, sh: r.f / r.n })).sort((x, y) => y.sh - x.sh);
const per = (x) => { const p = Math.round(x * 10); return p >= 1 ? `${["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"][p]} in ten` : `${Math.round(x * 1000)} in a thousand`; };
const lc = (t) => t.replace(/^Manufacture of /, "").toLowerCase();
const fyWorkers = ua.series.workers_all.data.filter((v) => v != null).at(-1);
const list3 = (rs) => rs.map((r) => `${lc(r.a)} (${(100 * r.sh).toFixed(100 * r.sh < 10 ? 1 : 0)}%)`).join(", ").replace(/, ([^,]*)$/, " and $1");
// the quarterly bulletin: its latest quarter and the same quarter a year earlier
import uq from "../../../data/series/asuse-quarterly.json";
const Q3 = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const qLab = (d) => `${Q3[+d.slice(5, 7) - 1]}–${Q3[+d.slice(5, 7) + 1]} ${d.slice(0, 4)}`;
const qNow = qLab(uq.dates.at(-1)), qPrev = uq.dates.length > 4 ? qLab(uq.dates.at(-5)) : null, qFirst = qLab(uq.dates[0]);
// industry (wave 2): the complete ASI tables, read at build time (the files are megabytes;
// the page carries only the picks its two plates draw)
import fs from "node:fs";
const rd = (f) => { try { return JSON.parse(fs.readFileSync(`data/series/${f}.json`, "utf8")); } catch { return null; } };
const n4 = rd("asi-nic4"), n2 = rd("asi-nic2"), accB = rd("asi-accounts"), stAll = rd("asi-states-all");
const last4 = (b, k) => { const s = b?.series[k]; if (!s) return null; const i = b.dates.length - 1; return s.data[i]; };
const tidyNic = (l) => l.split(" · ").slice(1).join(" · ").replace(/^(\d+) /, "$1 ").replace(/\s+/g, " ");
const gvaAll = last4(accB, "i19"), pAll = last4(accB, "i31");
const classes = n4 ? Object.keys(n4.series).filter((k) => k.startsWith("i19_")).map((k) => ({ code: k.slice(4), name: tidyNic(n4.series[k].label), gva: last4(n4, k), p: last4(n4, "i31_" + k.slice(4)) }))
  .filter((r) => r.gva != null).sort((a, b) => b.gva - a.gva) : [];
const topN = 20, topClasses = classes.slice(0, topN).map((r) => ({ ...r, sh: (100 * r.gva) / gvaAll, psh: r.p != null ? (100 * r.p) / pAll : null }));
const topShare = topClasses.reduce((a, r) => a + r.sh, 0);
// state x division mix: the twelve largest factory states, the eight largest divisions
const stRows = stAll ? Object.keys(stAll.series).filter((k) => k.startsWith("i19_")).map((k) => ({ state: stAll.series[k].label.split(" · ")[1], gva: last4(stAll, k) })).filter((r) => r.gva > 0).sort((a, b) => b.gva - a.gva).slice(0, 12) : [];
const divs = n2 ? Object.keys(n2.series).filter((k) => k.startsWith("i19_") && k !== "i19_99998").map((k) => ({ code: k.slice(4), name: tidyNic(n2.series[k].label), gva: last4(n2, k) })).filter((r) => r.gva > 0).sort((a, b) => b.gva - a.gva).slice(0, 8) : [];
const stSlug = (st) => st.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const mix = stRows.map((r) => { const b = rd(`asi-state-nic2-${stSlug(r.state)}`); const cells = divs.map((d) => ({ code: d.code, v: last4(b, "i19_" + d.code) })); const known = cells.reduce((a, c) => a + (c.v ?? 0), 0);
  return { state: r.state, gva: r.gva, cells: cells.map((c) => ({ code: c.code, sh: c.v != null ? (100 * c.v) / r.gva : null })), other: (100 * (r.gva - known)) / r.gva }; });
const peak = mix.flatMap((m) => m.cells.map((c) => ({ state: m.state, code: c.code, sh: c.sh }))).filter((c) => c.sh != null).sort((a, b) => b.sh - a.sh)[0];
const divName = (code) => divs.find((d) => d.code === code)?.name.replace(/^\d+ /, "").replace(/^Manufacture of /, "").toLowerCase() ?? code;
const asiTabFy = accB ? `${accB.dates.at(-1).slice(0, 4)}-${String((+accB.dates.at(-1).slice(0, 4) + 1) % 100).padStart(2, "0")}` : "";
---
<Base
  title="Enterprises · India Atlas"
  description={D.description}
  nav="guides"
  dateStamp={dateStamp(D)}
  crumbLeft={`<a href="/guides/">Guides</a> / ${D.section} / <b>${D.crumbTitle}</b>`}
  crumbRight={`${D.statusNote}, <b>${D.version}</b>`}
  canonical="https://atlas.thisindianlife.today/guides/factories/"
  ogImage={`/og/${D.slug}.png`}
>
<div class="page">

  <div class="titleblock break">
    <div class="kicker">{kicker(D)}</div>
    <div class="hero-grid">
      <h1 set:html={D.headline} />
      <p class="lede">India audits its registered factories to the last rupee and met the rest of its enterprises only in 2021. This guide puts the two counts on one page: side by side, never as one line.</p>
    </div>
    <div class="meta">
      <span>Source <b>MoSPI, NSO</b></span>
      <span>Instruments <b>ASI annual, ASUSE annual + quarterly</b></span>
      <span>Coverage <b>Registered factories, unincorporated establishments</b></span>
      <span>Latest ASI <b>2023-24</b></span>
      <span>Latest ASUSE <b>2023-24 and calendar 2025, bulletin {qNow}</b></span>
      <span>Rupees <b>Nominal, as published</b></span>
    </div>
    <div class="numbers">
      <div class="num"><div class="l">Factories in operation, lakh</div><div class="v" id="n-fact">–</div><div class="d" id="d-fact">–</div><div class="nspark" id="nspark-fact"></div></div>
      <div class="num"><div class="l">Persons engaged, ASI, crore</div><div class="v" id="n-pers">–</div><div class="d" id="d-pers">–</div></div>
      <div class="num"><div class="l">Informal establishments, crore</div><div class="v" id="n-inf">–</div><div class="d" id="d-inf">–</div></div>
      <div class="num"><div class="l">GVA per worker, factory ÷ informal</div><div class="v acc" id="n-mult">–</div><div class="d" id="d-mult">–</div></div>
    </div>
  </div>

  <!-- § 01 current reading -->
  <section>
    <div class="sec-head"><span class="no">01</span><h2>The current reading</h2><span class="line"></span><span class="unit">ASI &amp; ASUSE, 2023-24</span></div>
    <div class="reading-top">
      <div><span class="rk">Inside the Factories Act</span><div class="big" id="rb-formal">–</div></div>
      <p class="rt-cap">Persons engaged in registered factories in 2023-24: beside the workers of unincorporated establishments the same year. For every person inside the factory gate, about <b id="rt-ratio">–</b> work outside it, in enterprises the Act never sees.</p>
      <div class="rt-side"><span class="rk">Outside it</span><div class="rt-side-v" id="rb-informal">–</div></div>
    </div>
    <div class="reading-cols">
      <div class="reading-col">
        <span class="mk">What the print says</span>
        <p>The 2023-24 survey found <b id="cr-fop">–</b> factories in operation, of <b id="cr-freg">–</b> on the register. They engaged <b id="cr-pers">–</b> people and produced <b id="cr-fgva">–</b> of gross value added: <b id="cr-gpwf">–</b> per person, in the rupees of that year.</p>
        <p>ASUSE's third round counted <b id="cr-est">–</b> unincorporated establishments with <b id="cr-wrk">–</b> workers, adding <b id="cr-gpwi">–</b> of value per worker per year. Set one against the other and the factory multiple is <b id="cr-mult">–</b>.</p>
      </div>
      <div class="reading-col now">
        <span class="mk">What it does not say</span>
        <p>It does not say India makes things in only two lakh places. The ASI sees factories registered under the Factories Act: broadly, premises with ten or more workers using power, or twenty without. Everything smaller is invisible to it by design, and everything smaller is most of the country.</p>
        <p>Nor do the rupee figures say "growth" by themselves. ASI values are nominal, no deflator is published for them, and the informal count has no history: ASUSE first measured it in 2021-22. Whether there were more informal establishments a decade ago, we do not know.</p>
      </div>
    </div>
  </section>

  <!-- § 02 register -->
  <section>
    <div class="sec-head"><span class="no">02</span><h2>The register of series</h2><span class="line"></span><span class="unit">Latest round, vs previous</span></div>
    <div class="break ledger">
      <table>
        <thead>
          <tr><th>Series</th><th>Latest</th><th>vs prev. round</th><th>First round</th><th class="spark">History</th></tr>
        </thead>
        <tbody id="ledger-body"></tbody>
      </table>
    </div>
  </section>

  <!-- § 03 the long century: four classification blocks, never joined -->
  <section>
    <div class="sec-head"><span class="no">03</span><h2>Plate 1: the long century</h2><span class="line"></span><span class="unit">Four rulers, 1992-93 to 2023-24, never joined</span></div>
    <div class="break">
      <figure id="cb-long" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Thirty-two years, four rulers</h3>
            <div class="sub">Factories on the register &amp; persons engaged, NIC-1987, NIC-1998, NIC-2004 and NIC-2008 blocks, drawn as four separate lines</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-long">–</div><div class="c">1997-98 → 2023-24, factories on the register</div></div>
        </div>
        <div class="frame">
          <div class="legend" id="legend-long">
            <button class="chip" data-key="b1987"><i style="background:#C9CED6"></i>NIC-1987, to 1997-98</button>
            <button class="chip" data-key="b1998"><i style="background:#A3A9B4"></i>NIC-1998, to 2003-04</button>
            <button class="chip" data-key="b2004"><i style="background:#878D99"></i>NIC-2004, to 2007-08</button>
            <button class="chip" data-key="b2008"><i style="background:#2E4BD8"></i>NIC-2008, current</button>
          </div>
          <div class="plotzone">
            <div id="plot-long-fact" style="position:relative"></div>
            <div id="plot-long-pers" style="position:relative;margin-top:26px"></div>
          </div>
          <div class="plotfoot">
            <span class="src">Source: MoSPI, ASI classification blocks 1987 / 1998 / 2004 / 2008, each block is its own industrial classification and its own line, the seams are redefinitions, not events, 1993-94 is not served by the source at all, counts, free of prices</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The ASI is one survey published under four industrial classifications, and each classification is a different ruler. The lines are deliberately never joined: at every seam the survey re-sorted its factories, and a step across a seam measures the re-sorting as much as the economy. Read each segment's slope, not the jumps between segments.</p>
            <p>What the segments say is uncomfortable enough. The register drifted through the 1990s, fell in the early 2000s, and the people-panel is worse: factory employment went backwards for half a decade after 1997-98: the famous lost years of organised manufacturing, when output rose and jobs did not. The climb since is real; the 2010-11 step inside the current block is the frame revision, annotated in Plate 2.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2023-24</span>
            <p>The register: <b id="ex-l87">–</b> factories in 1992-93, <b id="ex-l98">–</b> at the 1997-98 end of that ruler, and a dip to <b id="ex-l02">–</b> in 2001-02. Persons engaged: <b id="ex-lp97">–</b> in 1997-98, down to <b id="ex-lp03">–</b> by 2003-04, and <b id="ex-lp23">–</b> today. It took organised manufacturing about a decade to re-employ the people it shed after 1998.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 04 the counts -->
  <section>
    <div class="sec-head"><span class="no">04</span><h2>Plate 2: sixteen years of counting factories</h2><span class="line"></span><span class="unit">counts, annual, ASI</span></div>
    <div class="break">
      <figure id="cb-count" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>The factories, and the people in them</h3>
            <div class="sub">Registered factories &amp; factories in operation, persons engaged &amp; workers, 2008-09 to 2023-24</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-count">–</div><div class="c">2023-24, factories in operation</div></div>
        </div>
        <div class="frame">
          <div class="legend" id="legend-count">
            <button class="chip" data-key="factories_in_operation"><i style="background:#2E4BD8"></i>In operation</button>
            <button class="chip" data-key="number_of_factories"><i style="background:#5F6675"></i>On the register</button>
            <button class="chip" data-key="persons_engaged"><i style="background:#5F6675"></i>Persons engaged</button>
            <button class="chip" data-key="workers"><i style="background:#A3A9B4"></i>of whom workers</button>
          </div>
          <div class="plotzone">
            <div id="plot-fact" style="position:relative"><div class="cb-tip"></div></div>
            <div id="plot-pers" style="position:relative;margin-top:26px"><div class="cb-tip"></div></div>
          </div>
          <div class="plotfoot">
            <span class="src">Source: MoSPI, Annual Survey of Industries, fiscal years plotted at April, the 2010-11 step is a sampling-frame revision, disclosed on the chart, not real growth</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Counts are the honest part of the ASI: a factory is a factory in any year's rupees. The one violent move in the upper panel is 2010-11, when the survey's sampling frame was rebuilt and tens of thousands of already-existing factories walked into view at once. The lower panel barely flinches at the same moment: the newly visible factories were small, so they carried few people with them.</p>
            <p>Everything else is slow. The register grows faster than the count in operation; the gap between the two lines is factories that exist on paper but reported no activity.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2023-24</span>
            <p>Factories in operation: <b id="ex-c1">–</b>, from <b id="ex-c0">–</b> at the start of the window. Persons engaged: <b id="ex-cp">–</b>, of whom <b id="ex-cw">–</b> are production workers. An average operating factory now holds <b id="ex-cavg">–</b> people: the factory sector is growing, and its factories are growing bigger.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 04 the money -->
  <section>
    <div class="sec-head"><span class="no">05</span><h2>Plate 3: the money, in the rupees of its day</h2><span class="line"></span><span class="unit">₹ lakh crore, nominal</span></div>
    <div class="break">
      <figure id="cb-money" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>What the factories added, and what they paid</h3>
            <div class="sub">Gross value added &amp; total emoluments, ₹ lakh crore, nominal, y/y change derived, 2008-09 to 2023-24</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-money">–</div><div class="c">2023-24, factory GVA, nominal</div></div>
        </div>
        <div class="frame">
          <div class="legend" id="legend-money">
            <button class="chip" data-key="gva"><i style="background:#2E4BD8"></i>Gross value added</button>
            <button class="chip" data-key="emoluments"><i style="background:#5F6675"></i>Emoluments</button>
            <button class="chip" data-key="gva_yoy"><i class="dash" style="border-color:#2E4BD8"></i>GVA y/y %, derived</button>
          </div>
          <div class="plotzone">
            <div id="plot-money" style="position:relative"><div class="cb-tip"></div></div>
            <div id="plot-grow" style="position:relative;margin-top:26px"></div>
          </div>
          <div class="plotfoot">
            <span class="src">Source: MoSPI, ASI, published in ₹ lakh, shown in ₹ lakh crore (1 lakh crore = 10¹² ₹), nominal, no deflator exists for ASI, y/y line derived, dashed</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Every rupee here is a rupee of its own year. The upper lines mix real expansion with fifteen years of inflation, and the survey publishes no deflator to separate them: so this plate states levels and refuses to call them growth. The dashed panel below is the honest companion: year-on-year change, which at least shows the rhythm: a pandemic dip, then a violent rebound that is part recovery and part the price surge of 2021-22.</p>
            <p>The steadier story is the gap between the lines: what factories add and what they pay out as wages and salaries. Emoluments have stayed near a third of value added through the whole window.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2023-24</span>
            <p>Factory GVA stands at <b id="ex-m1">–</b>, from <b id="ex-m0">–</b> in 2008-09: <b id="ex-mx">–</b> the nominal level, over years in which prices themselves roughly doubled. Emoluments: <b id="ex-me">–</b>, or about <b id="ex-mw">–</b> per person engaged per year.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 05 where -->
  <section>
    <div class="sec-head"><span class="no">06</span><h2>Plate 4: where the factory rupee is made</h2><span class="line"></span><span class="unit">share of factory GVA, 2023-24</span></div>
    <div class="break">
      <figure id="cb-states" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Three states, four rupees in ten</h3>
            <div class="sub">State share of all-India factory GVA, per cent, 2023-24, nominal</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-states">–</div><div class="c">Maharashtra + Gujarat + Tamil Nadu</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-states"></div>
          <div class="plotfoot">
            <span class="src">Source: MoSPI, ASI state tables, shares computed from published state GVA, ₹ lakh, Telangana reported from 2012-13, Ladakh from 2019-20</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Factory India is coastal and western. The long tail is the plate's second story: below the top ten states, shares fall under two per cent each, and the whole north-east together rounds to almost nothing. Concentration this steep is old, ports, power and supplier networks compound, and it moves only slowly, survey by survey.</p>
            <p>Share of value is not share of factories. Tamil Nadu runs the most factories; Maharashtra makes the most value per state. Capital-heavy industry, not counting, decides this ranking.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2023-24</span>
            <p>Maharashtra alone: <b id="ex-s1">–</b> of factory GVA. The top three states hold <b id="ex-s3">–</b>; the top five, <b id="ex-s5">–</b>. Tamil Nadu's <b id="ex-stn">–</b> operating factories are the country's largest count, against Maharashtra's <b id="ex-smh">–</b>.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 06 what they make -->
  <section>
    <div class="sec-head"><span class="no">07</span><h2>Plate 5: what the factories make</h2><span class="line"></span><span class="unit">GVA by NIC division, ₹ nominal</span></div>
    <div class="break">
      <figure id="cb-ind" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Twenty-nine industries, one shelf</h3>
            <div class="sub">Factory GVA by 2-digit NIC division, 16-year shape, each panel on its own scale, sorted by 2023-24 GVA</div>
          </div>
