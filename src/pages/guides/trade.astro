      </figure>
    </div>

    <div class="break" style="margin-top:88px">
      <figure id="cb-chapx" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3><span id="h-chapx">–</span></h3>
            <div class="sub">The twelve largest HS chapters (2 digits) of India's exports, US$ billion, {T.chapters.exports.fy} (bar), with {T.chapters.exports.prevFy} as a circle.</div>
