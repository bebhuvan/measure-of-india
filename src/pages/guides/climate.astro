---
import { mastheadStamp } from "../../dossiers/headline.js";
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import GuideData from "../../components/GuideData.astro";
import EveryCut from "../../components/EveryCut.astro";
import { bySlug, kicker } from "../../dossiers/registry.js";
import { dateStamp } from "../../dossiers/display.js";
import { climateData } from "../../dossiers/climate.data.js";
import * as fmt from "../../charts/format.js";
import { B } from "../../dossiers/climate.data.js";
import * as CH from "../../dossiers/climate.charts.js";
const D = bySlug["climate"];
// Every figure on this page is derived from the bundles at build time
// (src/dossiers/climate.data.js); qc.mjs recomputes the ones carrying ids.
const C = climateData();
const V = B(D.currentBundle).meta.vintage;
const W = C.WIN;
// "1951-80"; a window that crosses a century is written in full ("1996-2025", never "1996-25")
const w = (p) => `${p[0]}-${Math.floor(p[0] / 100) === Math.floor(p[1] / 100) ? String(p[1]).slice(2) : p[1]}`;
const sd2 = (v) => (v < 0 ? "−" : "+") + fmt.num2(Math.abs(v)) + "°C";
const sd1 = (v) => (v < 0 ? "−" : "+") + fmt.num1(Math.abs(v)) + "°C";
const d1 = (v) => fmt.num1(v) + "°C";
const days = (v) => fmt.count(v) + (Math.round(v) === 1 ? " day" : " days");
const ORD = ["first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth"];
const ord = (n) => ORD[n - 1] ?? n + (n % 100 >= 11 && n % 100 <= 13 ? "th" : ["th", "st", "nd", "rd"][n % 10] ?? "th");
const sgn1 = (v) => (v < 0 ? "−" : "+") + fmt.num1(Math.abs(v));
const M = C.month;
const heat = Object.fromEntries(C.heat.map((p) => [p.k, p]));
const st = [...C.states].sort((a, b) => b.tasCru - a.tasCru);
const st5 = [...C.states].sort((a, b) => b.tas - a.tas);
const listNames = (xs) => xs.slice(0, -1).join(", ") + " and " + xs.at(-1);
const stTop = st.slice(0, 3), stLow = st.slice(-3).reverse();
const delhi = C.states.find((s) => s.k === "delhi");
const wbtTop = [...C.states].sort((a, b) => b.wbt27 - a.wbt27).slice(0, 3);
const lowest40 = [...C.states].sort((a, b) => a.hd40 - b.hd40)[0];
const stProj = [...C.states].filter((s) => s.proj != null).sort((a, b) => b.proj - a.proj);
const nStates = C.states.length;
const allWarmer = C.states.every((s) => s.tasCru > 0);
const E = C.em, S = E.share;
const EN = C.energy, en = (f) => EN.primary.find((x) => x.f === f).last, el = (f) => EN.elec.find((x) => x.f === f).last;
const P = C.proj, pt = (s, y) => P.tas.find((x) => x.s === s).w.find((x) => x.y === y);
const pd = (k, s, y) => P.days.find((x) => x.k === k).s.find((x) => x.s === s).w.find((x) => x.y === y).med;
const pref = (k) => P.days.find((x) => x.k === k).ref;
const born = 2026;
const R = C.rain;
const monthsSorted = [...C.months].sort((a, b) => b.tas - a.tas);
const MN = { Jan: "January", Feb: "February", Mar: "March", Apr: "April", May: "May", Jun: "June", Jul: "July", Aug: "August", Sep: "September", Oct: "October", Nov: "November", Dec: "December" };
const fires = C.cost;
const cropShare = 100 * fires.firesCrop.at(-1)[1] / fires.firesAll.at(-1)[1];
const hdLast = C.cost.heatDeaths;
const lakh = (v) => fmt.num1(v / 1e5) + " lakh";
---
<Base
  title="Climate and temperature · India Atlas"
  description={D.description}
  nav="guides"
  dateStamp={mastheadStamp(D)}
  crumbLeft={`<a href="/guides/">Guides</a> / ${D.section} / <b>${D.crumbTitle}</b>`}
  crumbRight={`${D.statusNote}, <b>${D.version}</b>`}
  canonical="https://atlas.thisindianlife.today/guides/climate/"
  ogImage={`/og/${D.slug}.png`}
>
<div class="page">

  <div class="titleblock break">
    <div class="kicker">{kicker(D)}</div>
    <div class="hero-grid">
      <h1 set:html={D.headline} />
      <p class="lede">Heat, rain and the air are economic facts: they decide what a field yields, how many hours a labourer can work, how much power a city draws on a summer night. This guide reads India's climate from three instruments, kept apart: weather stations since 1901, a reanalysis since 1940, and the climate models that look ahead to 2100.</p>
    </div>
    <div class="meta">
      <span>Sources <b>CRU TS, Copernicus ERA5, CMIP6 (World Bank CCKP); Our World in Data</b></span>
      <span>Latest month <b>{M.label}</b></span>
      <span>Station record <b>1901 to {C.century.cruLast}</b></span>
      <span>Emissions <b>to {E.year}</b></span>
      <span>Projections <b>to 2100</b></span>
      <span>Baselines <b>1991-2020 for the month; 1951-1980 for change</b></span>
    </div>
    <div class="numbers">
      <div class="num"><div class="l">{M.label} against its 1991-2020 average</div><div class="v acc" id="n-anom">{sd2(M.anom)}</div><div class="d"><b id="n-rank">{ord(M.rank)}</b> warmest {M.monthName} of {M.of}</div><div class="nspark" id="nspark-anom"></div></div>
      <div class="num"><div class="l">Warmer than the early 1900s</div><div class="v" id="n-century">{sd1(C.century.change)}</div><div class="d">{w(W.decade)} against {w(W.early)}, station record</div></div>
      <div class="num"><div class="l">Nights of 26°C or more, a year</div><div class="v" id="n-nights">{days(heat.tr26.recent)}</div><div class="d">against <b id="d-nights">{days(heat.tr26.base)}</b> in {w(W.base)}</div></div>
      <div class="num"><div class="l">CO₂ per person, {E.year}</div><div class="v" id="n-pc">{fmt.num1(S.IND.pc)} t</div><div class="d">world <b id="d-pc">{fmt.num1(E.worldPc)} t</b>, US {fmt.num1(S.USA.pc)} t</div></div>
    </div>
  </div>

  <!-- § 01 the current reading: inputs climate-temp-monthly (both series), climate-temp-annual, climate-rain-owid; prose generated -->
  <section>
    <div class="sec-head"><span class="no">01</span><h2>The current reading</h2><span class="line"></span><span class="unit">ERA5, India's land, {M.label}</span></div>
    <div class="reading-top">
      <div><span class="rk">{M.label}, against 1991-2020</span><div class="big" id="rb-anom">{sd2(M.anom)}</div></div>
      <p class="rt-cap">How far India's average temperature for the month sat from the average for the same month in 1991 to 2020. The month itself averaged {d1(M.temp)} across the country.</p>
      <div class="rt-side"><span class="rk">Last twelve months</span><div class="rt-side-v" id="rb-12">{sd2(C.month.last12)}</div></div>
    </div>
    <div class="reading-cols">
      <div class="reading-col">
        <span class="mk">What the month says</span>
        <Prose slot="climate.current-reading.what-the-print-says" />
      </div>
      <div class="reading-col now">
        <span class="mk">What it does not say</span>
        <Prose slot="climate.current-reading.what-it-does-not-say" />
      </div>
    </div>

    <div class="break" style="margin-top:72px">
      <figure id="cb-stripes" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Since 2000, cool months have become rare</h3>
            <div class="sub">Every month since January 1940: India's average temperature against the 1991-2020 average for that month, °C. One column a year, one row a month.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-stripes">{sd2(M.anom)}</div><div class="c">{M.short}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-stripes" set:html={CH.stripes(C)} />
          <div class="plotfoot">
            <span class="src">Source: Copernicus Climate Change Service, ERA5, country average by Our World in Data (CC BY 4.0). Baseline: the same calendar month, 1991-2020.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ourworldindata.org/grapher/monthly-temperature-anomalies" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Read across for years, down for months. Blue cells were cooler than the 1991-2020 normal for that month, red cells warmer, white cells close to it. The baseline is itself recent: a white cell is a month as warm as the 1990s and 2000s, already warmer than the 1940s.</p>
            <p>ERA5 is a reanalysis: a weather model run backwards over every observation available (stations, balloons, satellites), producing a complete, consistent picture of each day. It is not a thermometer reading, and its early decades rest on far fewer observations than its recent ones.</p>
          </div>
          <div class="now">
            <span class="mk">As of {M.label}</span>
            <p>{M.label} sat <b id="ex-st-anom">{sd2(M.anom)}</b> from its normal, the {ord(M.rank)} warmest {M.monthName} in {M.of} years; the warmest was {M.warmest.y}. Of the {M.ytdN} months of {M.label.slice(-4)} so far, <b id="ex-st-above">{M.ytdAbove}</b> ran above normal.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 02 lived reality: inputs climate-era5-hotdays (hd40, tr26), climate-era5-heatstress (wbt27, hi41); evergreen + data-bound figures -->
  <section>
    <div class="sec-head"><span class="no">02</span><h2>What a hotter India feels like</h2><span class="line"></span><span class="unit">ERA5, India's land, days a year</span></div>
    <div class="wm-grid">
      <div>
        <p>A national average of half a degree sounds like nothing. Nobody lives in an average. What people live through is the hottest afternoon, the night that does not cool, the muggy day when sweat stops working. Those have changed far more than the average.</p>
        <p>In {w(W.base)}, an average spot in India had <b id="lr-nights0">{days(heat.tr26.base)}</b> a year when the night never fell below 26°C. In {w(W.recent)} it had <b id="lr-nights1">{days(heat.tr26.recent)}</b>. A night that stays at 26°C or more is a night a fan cannot fix, and a body that does not recover before the next day's work.</p>
        <p>Humid heat rose faster still. Days with a wet-bulb temperature of 27°C or more, the reading of a wet thermometer cooled by evaporation and so the limit of how well sweat can cool a body, went from <b id="lr-wbt0">{days(heat.wbt27.base)}</b> a year to <b id="lr-wbt1">{days(heat.wbt27.recent)}</b>. Days so hot and humid that the heat index passes 41°C, the band in which heat exhaustion becomes likely, went from <b id="lr-hi0">{fmt.num1(heat.hi41.base)}</b> to <b id="lr-hi1">{fmt.num1(heat.hi41.recent)}</b>.</p>
        <p>The scorching dry days have not multiplied the same way. Days of 40°C or more averaged <b id="lr-hd0">{days(heat.hd40.base)}</b> a year then and <b id="lr-hd1">{days(heat.hd40.recent)}</b> now, nationally. India's heat has become wetter and longer into the night, which is harder on bodies, on outdoor work and on power grids than a few more scorching afternoons would be.</p>
      </div>
      <div class="wm-rail">
        <aside class="margin-note">
          <span class="mk">Margin note, i</span>
          <b>Wet-bulb temperature.</b> Wrap a thermometer in a wet cloth and fan it. The reading it settles at is the coolest sweat can make your skin. A wet-bulb of 35°C is often cited as the point where even a resting person in shade cannot shed heat for long; heavy work becomes dangerous well below it.
        </aside>
        <aside class="margin-note">
          <span class="mk">Margin note, ii</span>
          <b>An area average.</b> These are averages over India's land. A coastal city, a desert town and a Himalayan valley sit inside one number. The state table further down breaks it apart.
        </aside>
      </div>
    </div>

    <div class="break" style="margin-top:56px">
      <figure id="cb-heat" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Warm nights and humid days have multiplied; 40°C days have not</h3>
            <div class="sub">Days a year at an average spot in India, 1950 to {C.century.era5Last}. The grey line is the {w(W.base)} average; the blue line, each year.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-heat">{days(heat.tr26.recent)}</div><div class="c">nights of 26°C or more, {w(W.recent)} average</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-heat" set:html={CH.heat(C)} />
          <div class="plotfoot">
            <span class="src">Source: Copernicus ERA5 reanalysis, indices and India area averages by the World Bank Climate Change Knowledge Portal (CCKP). Wet-bulb by the Stull formula; heat index by the US National Weather Service formula.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://climateknowledgeportal.worldbank.org/country/india" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Each panel counts days in a year above a line that matters for the body. The count is for an average spot: the days above the line in every quarter-degree cell of India's land, averaged. A count of 12 can mean 12 days everywhere or 60 days across a fifth of the country, mostly the Gangetic plain and the coasts.</p>
            <p>The panels share no common scale: each is drawn to its own range, so read the change within a panel, not the height across panels.</p>
          </div>
          <div class="now">
            <span class="mk">As of {C.century.era5Last}</span>
            <p>In {heat.tr26.last.y}: nights of 26°C or more, <b id="ex-h-tr">{days(heat.tr26.last.v)}</b>; wet-bulb days of 27°C or more, <b id="ex-h-wbt">{days(heat.wbt27.last.v)}</b>; heat-index days of 41°C or more, <b id="ex-h-hi">{days(heat.hi41.last.v)}</b>; days of 40°C or more, <b id="ex-h-hd">{days(heat.hd40.last.v)}</b>. {C.heat.every((p) => p.last.v < p.data.at(-2)[1]) ? `Every count was lower than in ${heat.tr26.last.y - 1}; ` : ""}the humid counts stay far above their 1950s level.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 03 how to read this: evergreen, human-written -->
  <section>
    <div class="sec-head"><span class="no">03</span><h2>How to read these numbers</h2><span class="line"></span></div>
    <div class="wm-grid">
      <div>
        <p><b>Three instruments, never joined.</b> The station record (CRU TS, from the University of East Anglia) interpolates thermometer and rain-gauge readings onto a half-degree grid and reaches back to 1901. The reanalysis (ERA5, from the European Copernicus service) runs a weather model over every available observation from 1940; the World Bank's portal aggregates it from 1950 and computes heat and rain indices from it. The projections (CMIP6) are about thirty climate models run forward under stated assumptions about emissions. They measure related things in different ways, so this guide shows them side by side and never splices one onto another.</p>
        <p><b>Anomalies and baselines.</b> An anomaly is a departure from an average for the same period: this August against the average August. The month on this page is measured against 1991-2020, Copernicus's standard. Long-run change is measured as the difference between two 30-year averages, {w(W.base)} and {w(W.recent)}, inside one instrument. Thirty years is long enough to wash out most year-to-year swings.</p>
        <p><b>Area averages.</b> Every figure for India or a state is an average over its land, weighted by area, not by people. Delhi and the Thar desert count by their size. The World Bank's portal publishes 35 state and union territory units; its boundary set has none for Jammu and Kashmir or Ladakh. Its all-India temperature runs about 0.7°C warmer than the station record's own country average for the same grid, which is what leaving out those cold Himalayan territories would do; we do not know that for certain. Changes over time agree within a few hundredths of a degree, and this guide reports changes.</p>
        <p><b>Projections are not forecasts.</b> A projection says what the models expect if emissions follow a stated pathway: SSP1-2.6 is rapid cuts, SSP2-4.5 roughly today's policies, SSP3-7.0 a fractured world, SSP5-8.5 fossil-fuelled growth. The range shown is the spread across models (the 10th to 90th percentile), not a probability. Projections are never joined to an observed line.</p>
      </div>
      <div class="wm-rail">
        <aside class="margin-note">
          <span class="mk">Margin note, iii</span>
          <b>Why the records differ.</b> Stations sit in towns and valleys; a reanalysis fills the gaps with physics. In heavily irrigated plains, the two disagree most on daytime heat. Neither is the truth; the gap is the uncertainty.
        </aside>
        <aside class="margin-note">
          <span class="mk">Margin note, iv</span>
          <b>Revisions.</b> ERA5's latest months are preliminary. CRU TS is re-issued as a new version each year, and each version can change earlier years slightly.
        </aside>
      </div>
    </div>
  </section>

  <!-- § 04 a century of warming: inputs climate-cru (tas), climate-era5-temp (tas) -->
  <section>
    <div class="sec-head"><span class="no">04</span><h2>A century of warming</h2><span class="line"></span><span class="unit">Annual mean temperature, °C, against each record's own 1951-1980 average</span></div>
    <div class="break">
      <figure id="cb-century" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>India has warmed about {fmt.num1(C.century.change)}°C since the early 1900s, and twice as fast since the 1970s</h3>
            <div class="sub">Annual mean temperature over India's land, against each record's own {w(W.base)} average, °C. Two instruments, drawn apart: the station record from 1901, the reanalysis from 1950.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-century">{fmt.num2(C.century.rate1976)}°C</div><div class="c">a decade since 1976, station record</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-century" set:html={CH.century(C)} />
          <div class="plotfoot">
            <span class="src">Source: CRU TS 4.10 (University of East Anglia) and Copernicus ERA5, India area averages by the World Bank CCKP. Each line against its own 1951-1980 mean; the two are never joined.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://climateknowledgeportal.worldbank.org/country/india" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Each line is one year's average temperature over India's land, minus that record's average for 1951-1980, so both start from the same zero. Year-to-year swings of half a degree are ordinary: El Niño years run hot, strong monsoons cool the summer. The signal is the drift underneath: flat for half a century, then climbing.</p>
            <p>The warming rate is a straight line fitted through the years: the average change per decade over the period named, not a prediction.</p>
          </div>
          <div class="now">
            <span class="mk">As of {C.century.cruLast}</span>
            <p>The last ten years averaged <b id="ex-c-dec">{d1(C.century.decade)}</b> in the station record, against <b id="ex-c-early">{d1(C.century.early)}</b> in {w(W.early)}. Warming ran at <b id="ex-c-r1901">{fmt.num2(C.century.rate1901)}°C</b> a decade over the whole record and <b id="ex-c-r1976">{fmt.num2(C.century.rate1976)}°C</b> since 1976; the reanalysis gives <b id="ex-c-e1976">{fmt.num2(C.century.rate1976era5)}°C</b> since 1976. The five warmest years in the station record, warmest first: {C.century.warmest.join(", ")}.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 05 anatomy: which months, days or nights: inputs climate-cru-monthly (tas, tasmax, tasmin), climate-cru (tasmax, tasmin) -->
  <section>
    <div class="sec-head"><span class="no">05</span><h2>Which months, and which hours</h2><span class="line"></span><span class="unit">Change from {w(W.base)} to {w(W.recent)}, °C, station record</span></div>
    <div class="break">
      <figure id="cb-months" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Winter and the months after the monsoon warmed most; nights more than days</h3>
            <div class="sub">Change in the average daily maximum (day) and minimum (night) temperature for each calendar month, {w(W.base)} to {w(W.recent)}, °C, India's land.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-months">{sd1(monthsSorted[0].tas)}</div><div class="c">{MN[monthsSorted[0].m]}, the month that warmed most</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-months" set:html={CH.months(C)} />
          <div class="plotfoot">
            <span class="src">Source: CRU TS 4.10, monthly, India area average by the World Bank CCKP. Change is the difference of two 30-year means.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://crudata.uea.ac.uk/cru/data/hrg/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>For each month, the hollow dot is how much warmer its days have become, the blue dot how much warmer its nights. The monsoon months, June and July, warmed least: cloud and rain cap the heat. The dry season, from November to March, warmed most. A warmer winter shortens the cool spell wheat needs to fill its grain, which is why a hot February or March worries farmers more than a hot May.</p>
          </div>
          <div class="now">
            <span class="mk">As of {C.century.cruLast}</span>
            <p>Over the whole year, nights warmed by <b id="ex-m-night">{sd1(C.dayNight.tmin)}</b> and days by <b id="ex-m-day">{sd1(C.dayNight.tmax)}</b>. {MN[monthsSorted[0].m]} warmed most (<b id="ex-m-top">{sd1(monthsSorted[0].tas)}</b>) and {MN[monthsSorted.at(-1).m]} least (<b id="ex-m-low">{sd1(monthsSorted.at(-1).tas)}</b>).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 06 granular: states: inputs climate-cru-states (tas), climate-era5-states-temp (tas), climate-era5-states-heatstress (wbt27), climate-era5-states-hotdays (hd40) -->
  <section>
    <div class="sec-head"><span class="no">06</span><h2>Which states</h2><span class="line"></span><span class="unit">{nStates} states and union territories, change from {w(W.base)} to {w(W.recent)}</span></div>
    <div class="break">
      <figure id="cb-states" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>{allWarmer ? "Every state is warmer by the station record, " : "By the station record, "}most of all {listNames(stTop.slice(0, 2).map((s) => s.name))}; the reanalysis puts {listNames(st5.slice(0, 2).map((s) => s.name))} first</h3>
            <div class="sub">Change in annual mean temperature, {w(W.base)} to {w(W.recent)}, °C. Filled dots: the station record; hollow dots: the reanalysis. Sorted by the station record.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-states">{sd1(stTop[0].tasCru)}</div><div class="c">{stTop[0].name}, the largest change</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-states" set:html={CH.states(C)} />
          <div class="plotfoot">
            <span class="src">Source: CRU TS 4.10 and Copernicus ERA5, area averages over CCKP's first-level boundaries. CCKP publishes no unit for Jammu and Kashmir or Ladakh. Small territories rest on few grid cells.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://climateknowledgeportal.worldbank.org/country/india" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Where the two dots sit close, the two instruments agree. Where they part, read the gap as uncertainty: the two records do not even agree on which regions warmed most. The station record, built from sparse gauges in hilly and remote states, leans on interpolation there; the reanalysis leans on its model. They also part in the irrigated north-west: canals and wet fields cool the afternoon there, aerosols from crop fires and traffic dim the sun, and the two records treat those effects differently. In Delhi the reanalysis finds days slightly cooler than in the 1950s and nights clearly warmer; the station record finds both warmer.</p>
          </div>
          <div class="now">
            <span class="mk">As of {C.century.cruLast}</span>
            <p>Largest changes in the station record: {stTop.map((s) => `${s.name} (${sd1(s.tasCru)})`).join(", ")}. Smallest: {stLow.map((s) => `${s.name} (${sd1(s.tasCru)})`).join(", ")}. Largest in the reanalysis: {st5.slice(0, 3).map((s) => `${s.name} (${sd1(s.tas)})`).join(", ")}. Delhi: <b id="ex-s-delhi">{sd1(delhi.tasCru)}</b> by the stations, <b id="ex-s-delhi5">{sd1(delhi.tas)}</b> by the reanalysis.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-states-humid" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Humid heat has spread across the Gangetic plain and the east</h3>
            <div class="sub">Change in days a year with a wet-bulb temperature of 27°C or more, {w(W.base)} to {w(W.recent)}, and change in days of 40°C or more, by state.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-humid">+{fmt.num1(wbtTop[0].wbt27)}</div><div class="c">more humid days, {wbtTop[0].name}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-states-humid" set:html={CH.statesHumid(C)} />
          <div class="plotfoot">
            <span class="src">Source: Copernicus ERA5 reanalysis, indices and state averages by the World Bank CCKP. Change in days a year between two 30-year averages.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://climateknowledgeportal.worldbank.org/country/india" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Two dots a state. The blue dot is how many more muggy days a year the state now has; the grey ring how many more (or fewer) scorching dry days. In the plains of the north, dry 40°C days have become fewer while wet-bulb days rose sharply: the heat did not leave, it took on water. Irrigation, which puts moisture into the air, is part of the reason.</p>
          </div>
          <div class="now">
            <span class="mk">As of {C.century.cruLast}</span>
            <p>The largest rises in humid days: {wbtTop.map((s) => `${s.name} (+${fmt.num1(s.wbt27)})`).join(", ")}. Days of 40°C or more fell most in {lowest40.name} (<b id="ex-sh-low">{sgn1(lowest40.hd40)}</b> a year). In Delhi, humid days rose by <b id="ex-sh-delhi">{fmt.num1(delhi.wbt27)}</b> a year while 40°C days changed by {sgn1(delhi.hd40)}.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 07 the monsoon: inputs climate-cru (pr), climate-cru-monthly (pr), climate-era5-rain (rx5day, r99ptot, r50mm, cdd), climate-cru-states (pr) -->
  <section>
    <div class="sec-head"><span class="no">07</span><h2>The monsoon</h2><span class="line"></span><span class="unit">Rainfall over India's land, millimetres</span></div>
    <div class="break">
      <figure id="cb-rain" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>A century of monsoons: no long decline in the national total, and the droughts stand out</h3>
            <div class="sub">Annual rainfall averaged over India's land, millimetres, 1901 to {C.century.cruLast}. The line marks the {w(W.base)} average; blue bars are years at least 10% below it.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-rain">{fmt.inr(R.annual.at(-1)[1])} mm</div><div class="c">{R.annual.at(-1)[0]}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-rain" set:html={CH.rain(C)} />
          <div class="plotfoot">
            <span class="src">Source: CRU TS 4.10 (rain-gauge record), India area average by the World Bank CCKP. The India Meteorological Department's own all-India series uses a different gauge network and differs in level.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://crudata.uea.ac.uk/cru/data/hrg/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Each bar is one year's rain. About four-fifths of it falls from June to September. A bar far below the line is a drought year, and in an economy where much of the farmland still depends on rain, it shows up within months in farm incomes, rural wages and food prices.</p>
          </div>
          <div class="now">
            <span class="mk">As of {C.century.cruLast}</span>
            <p>Average annual rain: <b id="ex-r-base">{fmt.inr(R.base)} mm</b> in {w(W.base)}, <b id="ex-r-recent">{fmt.inr(R.recent)} mm</b> in {w(W.recent)}. June to September brought <b id="ex-r-jjas">{fmt.num1(R.jjasRecent)}%</b> of the year's rain in the recent period, against {fmt.num1(R.jjasBase)}% before. The driest years on the record, driest first: {R.driest.map(([y]) => y).join(", ")}.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-rain-months" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>The season's shape has shifted only slightly: a little less in June, a little more in September</h3>
            <div class="sub">Average rainfall in each month, {w(W.base)} and {w(W.recent)}, millimetres, India's land.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-rmonths">{(() => { const s = R.months.find((x) => x.m === "Sep"); return (s.recent - s.base >= 0 ? "+" : "−") + Math.abs(s.recent - s.base) + " mm"; })()}</div><div class="c">September, change</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-rain-months" set:html={CH.rainMonths(C)} />
          <div class="plotfoot">
            <span class="src">Source: CRU TS 4.10, monthly, India area average by the World Bank CCKP.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://crudata.uea.ac.uk/cru/data/hrg/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The filled dots are the recent average for each month, the rings the old one. A shift in timing matters to a farmer even when the total does not move: a late June delays sowing, a wet September can flatten a ripe crop. Monthly averages over the whole country cannot show the onset date; the India Meteorological Department dates onset and withdrawal, and those dates are not in these sources. We do not know from this data whether the monsoon arrives later.</p>
          </div>
          <div class="now">
            <span class="mk">As of {C.century.cruLast}</span>
            <p>June: <b id="ex-rm-jun">{R.months[5].base} mm</b> then, {R.months[5].recent} mm now. September: <b id="ex-rm-sep">{R.months[8].base} mm</b> then, {R.months[8].recent} mm now. July and August, the core of the season: {R.months[6].base} and {R.months[7].base} mm then, {R.months[6].recent} and {R.months[7].recent} mm now.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-rain-extremes" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Across India as a whole, rain extremes have barely moved; the change is local</h3>
            <div class="sub">Four measures of how rain falls, India's land, 1950 to {C.century.era5Last}. The grey line marks the {w(W.base)} average.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-rext">{fmt.count(R.extremes[0].last.v)} mm</div><div class="c">wettest five days of {R.extremes[0].last.y}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-rain-extremes" set:html={CH.rainExtremes(C)} />
          <div class="plotfoot">
            <span class="src">Source: Copernicus ERA5 reanalysis, indices and India area averages by the World Bank CCKP.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://climateknowledgeportal.worldbank.org/country/india" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>An extreme downpour falls on a district, not on a country. Averaged over all of India, a cloudburst in one valley is diluted by dry days everywhere else, so national averages of extremes move slowly even when local floods grow more frequent. This national average can neither confirm nor rule out more frequent local downpours.</p>
          </div>
          <div class="now">
            <span class="mk">As of {C.century.era5Last}</span>
            <p>Wettest five days: <b id="ex-re-rx5">{fmt.num1(R.extremes[0].base)} mm</b> on average in {w(W.base)}, {fmt.num1(R.extremes[0].recent)} mm in {w(W.recent)}. Share of the year's rain on its wettest 1% of days: {fmt.num1(R.extremes[1].base)}% then, {fmt.num1(R.extremes[1].recent)}% now. Longest dry spell: {fmt.num1(R.extremes[3].base)} days then, {fmt.num1(R.extremes[3].recent)} days now.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 08 emissions: inputs climate-co2, climate-co2-chn, climate-co2-usa, climate-co2-world -->
  <section>
    <div class="sec-head"><span class="no">08</span><h2>What India emits</h2><span class="line"></span><span class="unit">Carbon dioxide and other greenhouse gases, to {E.year}</span></div>
    <div class="break">
      <figure id="cb-co2" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>India is the third-largest emitter, and its emissions are still rising</h3>
            <div class="sub">Carbon dioxide from fossil fuels and industry, million tonnes a year, 1950 to {E.year}: India, China and the United States.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-co2">{fmt.inr(E.india.co2)} Mt</div><div class="c">India, {E.year}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-co2" set:html={CH.co2(C)} />
          <div class="plotfoot">
            <span class="src">Source: Global Carbon Project, via Our World in Data (CC BY 4.0). Territorial emissions, excluding land-use change.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ourworldindata.org/co2-emissions" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>These are territorial emissions: the carbon dioxide released inside each country's borders, mostly by burning coal, oil and gas, and by making cement. They are estimated from fuel and production statistics, not measured in the air, and are revised each year as those statistics are revised.</p>
          </div>
          <div class="now">
            <span class="mk">As of {E.year}</span>
            <p>India emitted <b id="ex-e-co2">{fmt.inr(E.india.co2)} million tonnes</b>, <b id="ex-e-share">{fmt.num1(S.IND.annual)}%</b> of the world's, up <b id="ex-e-growth">{fmt.num1(E.india.growth)}%</b> on the year and {fmt.num1(E.india.co2 / E.india.co2_1990)} times its 1990 level. China emitted {fmt.num1(S.CHN.annual)}% of the world total, the United States {fmt.num1(S.USA.annual)}%. Coal alone produced <b id="ex-e-coal">{fmt.num1(E.india.coalShare)}%</b> of India's CO₂.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-percap" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Per person, India emits less than half the world average</h3>
            <div class="sub">Carbon dioxide from fossil fuels and industry per person, tonnes a year, 1950 to {E.year}.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-pc">{fmt.num2(S.IND.pc)} t</div><div class="c">India, per person, {E.year}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-percap" set:html={CH.percap(C)} />
          <div class="plotfoot">
            <span class="src">Source: Global Carbon Project, population from UN and OWID sources, via Our World in Data (CC BY 4.0).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ourworldindata.org/co2-emissions" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Divide a country's emissions by its people and the ranking turns over. India has as many people as China and four times as many as the United States, so its total is large while its share per person is small. A per-person average says nothing about how emissions split within India: a household with two air conditioners and a car emits many times what a household with one bulb does.</p>
          </div>
          <div class="now">
            <span class="mk">As of {E.year}</span>
            <p>Per person: India <b id="ex-pc-ind">{fmt.num2(S.IND.pc)} t</b>, China {fmt.num2(S.CHN.pc)} t, the United States <b id="ex-pc-usa">{fmt.num2(S.USA.pc)} t</b>, the world {fmt.num2(E.worldPc)} t. An average American emits as much in about {Math.round(365 * S.IND.pc / S.USA.pc)} days as an average Indian does in a year.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-stock" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>India's share of the warming so far is smaller than its share of today's emissions</h3>
            <div class="sub">Share of the world's annual CO₂ ({E.year}), of all CO₂ emitted since 1750, and of the global warming caused so far by greenhouse gases, per cent.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-stock">{fmt.num1(S.IND.warming)}%</div><div class="c">India's share of warming so far</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-stock" set:html={CH.stock(C)} />
          <div class="plotfoot">
            <span class="src">Source: Global Carbon Project (CO₂) and Jones et al. (contributions to warming, all greenhouse gases including land use), via Our World in Data (CC BY 4.0).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ourworldindata.org/contributed-most-global-co2" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Carbon dioxide stays in the air for centuries, so warming follows the total ever emitted, not this year's flow. Countries that industrialised early carry a larger share of the stock than of today's emissions; India, a late emitter, the reverse. The warming share also counts methane and nitrous oxide and emissions from clearing land, estimated by Jones and colleagues.</p>
          </div>
          <div class="now">
            <span class="mk">As of {E.year}</span>
            <p>India: <b id="ex-s-ann">{fmt.num1(S.IND.annual)}%</b> of the year's CO₂, <b id="ex-s-cum">{fmt.num1(S.IND.cumulative)}%</b> of all CO₂ since 1750, {fmt.num1(S.IND.warming)}% of the warming. United States: {fmt.num1(S.USA.annual)}%, {fmt.num1(S.USA.cumulative)}% and {fmt.num1(S.USA.warming)}%. China: {fmt.num1(S.CHN.annual)}%, {fmt.num1(S.CHN.cumulative)}% and {fmt.num1(S.CHN.warming)}%.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-fuels" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Coal makes two-thirds of India's carbon dioxide</h3>
            <div class="sub">India's CO₂ by source, million tonnes a year, 1950 to {E.year}.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-fuels">{fmt.num1(E.india.coalShare)}%</div><div class="c">from coal, {E.year}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-fuels" set:html={CH.fuels(C)} />
          <div class="plotfoot">
            <span class="src">Source: Global Carbon Project, via Our World in Data (CC BY 4.0). The Global Carbon Project reports no separate "other industry" CO₂ for India.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ourworldindata.org/co2-emissions" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Most of India's coal is burned in power stations, the rest in steel, cement and brick kilns. Oil goes mostly into transport and cooking gas; natural gas is a small fuel in India, unlike in the United States. Cement releases carbon dioxide twice: from the fuel that heats the kiln and from the limestone it bakes.</p>
          </div>
          <div class="now">
            <span class="mk">As of {E.year}</span>
            <p>Coal <b id="ex-f-coal">{fmt.inr(E.india.coal)} Mt</b>, oil {fmt.inr(E.fuels.find((f) => f.k === "oil_co2").data.at(-1)[1])} Mt, cement {fmt.inr(E.fuels.find((f) => f.k === "cement_co2").data.at(-1)[1])} Mt, gas {fmt.inr(E.fuels.find((f) => f.k === "gas_co2").data.at(-1)[1])} Mt.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-gases" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Methane from rice and cattle adds a quarter again to India's carbon dioxide</h3>
            <div class="sub">India's greenhouse gas emissions by gas, million tonnes of CO₂-equivalent a year, 1950 to {E.year}. Carbon dioxide here includes land-use change.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-gases">{fmt.inr(E.india.ghg)} Mt</div><div class="c">all greenhouse gases, {E.year}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-gases" set:html={CH.gases(C)} />
          <div class="plotfoot">
            <span class="src">Source: Jones et al. (2025) national contributions, via Our World in Data (CC BY 4.0). CO₂-equivalent over 100 years.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ourworldindata.org/greenhouse-gas-emissions" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Methane and nitrous oxide warm the air far more per tonne than carbon dioxide; they are converted to "CO₂-equivalent" tonnes so the gases can be added up. India's methane comes mostly from flooded rice paddies, cattle digesting fodder, and landfills; its nitrous oxide mostly from fertiliser on fields. These are farm emissions, tied to food and livelihoods, and much harder to cut than a coal plant's.</p>
          </div>
          <div class="now">
            <span class="mk">As of {E.year}</span>
            <p>Methane <b id="ex-g-ch4">{fmt.inr(E.india.methane)} Mt</b> and nitrous oxide {fmt.inr(E.india.n2o)} Mt of CO₂-equivalent, against {fmt.inr(E.india.co2)} Mt of fossil CO₂. Measured by what India's own consumption causes, wherever it is produced, CO₂ was <b id="ex-g-cons">{fmt.inr(E.consumption.last.v)} Mt</b> in {E.consumption.last.y}, against {fmt.inr(E.consumption.terrAt)} Mt emitted inside India: India exports more embodied carbon than it imports.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 09 energy: inputs climate-energy -->
  <section>
    <div class="sec-head"><span class="no">09</span><h2>The energy behind it</h2><span class="line"></span><span class="unit">Shares of primary energy and of electricity, per cent</span></div>
    <div class="break">
      <figure id="cb-energy" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Coal still supplies more than half of all the energy India uses</h3>
            <div class="sub">Share of India's primary energy by source, per cent, 1965 to {EN.year} (substitution method).</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-energy">{fmt.num1(en("coal"))}%</div><div class="c">coal, {EN.year}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-energy" set:html={CH.energy(C)} />
          <div class="plotfoot">
            <span class="src">Source: Energy Institute Statistical Review of World Energy, via Our World in Data (CC BY 4.0). Excludes firewood, crop waste and dung burned in homes. Sources under 2% are in the CSV download.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ourworldindata.org/energy/country/india" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Primary energy is everything a country uses before conversion: coal into a power station, crude into a refinery. Electricity from wind, sun and water is counted as the fossil fuel it would have taken to generate it (the "substitution method"), so its share is comparable with coal's. Traditional biomass, still the cooking fuel of many rural homes, is left out of these figures.</p>
          </div>
          <div class="now">
            <span class="mk">As of {EN.year}</span>
