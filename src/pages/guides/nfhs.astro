---
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import GuideData from "../../components/GuideData.astro";
import EveryCut from "../../components/EveryCut.astro";
import { bySlug, kicker } from "../../dossiers/registry.js";
import { dateStamp } from "../../dossiers/display.js";
import { load, val, states, strip, pairs, ruralUrban, directionRows, withheld, short, polarity, TABLE_ORDER, bundleOf } from "../../dossiers/nfhs.data.js";
const D = bySlug["nfhs"];

// ---- the figures the copy names, read from the bundles at build time ----
const f1 = (v) => (v == null ? "–" : v.toFixed(1));
const f0 = (v) => (v == null ? "–" : v.toFixed(0));
const f2 = (v) => (v == null ? "–" : v.toFixed(2));
const pt = (a, b) => `${b - a >= 0 ? "+" : "−"}${Math.abs(b - a).toFixed(1)} pt`;
const V5 = (t, re, o) => val(5, t, re, o), V4 = (t, re, o) => val(4, t, re, o);
const AN = /^Children age 6-59/;
const an5 = V5("anaemia", AN), an4 = V4("anaemia", AN);
const st5 = V5("child-nutrition", /are stunted/), st4 = V4("child-nutrition", /are stunted/);
const ib5 = V5("delivery", /^Institutional births \(in/), ib4 = V4("delivery", /^Institutional births \(in/);
const bpw = V5("blood-pressure", /^Women .*Elevated blood pressure \(Systolic ≥140/), bpm = V5("blood-pressure", /^Men .*Elevated blood pressure \(Systolic ≥140/);
const sgw = V5("blood-sugar", /^Women .*taking medicine/), sgm = V5("blood-sugar", /^Men .*taking medicine/);
const round5 = load("nfhs-5-anaemia").meta, round4 = load("nfhs-4-anaemia").meta;
const nWithheld = withheld().length;
const nBundles = TABLE_ORDER.filter((t) => bundleOf(5, t)).length + TABLE_ORDER.filter((t) => bundleOf(4, t)).length;
const nCells = TABLE_ORDER.reduce((n, t) => n + [4, 5].reduce((m, r) => m + Object.keys(bundleOf(r, t)?.series ?? {}).length, 0), 0);
const nStates = states(5, "anaemia", AN).length;

// §03 every per-cent measure taken in both rounds, with the direction a rise means
const dir = directionRows().map((r) => ({ ...r, short: short(r.label), dir: polarity(short(r.label)) })).sort((a, b) => b.change - a.change);
const better = dir.filter((r) => r.dir !== 0 && r.dir * r.change > 0), worse = dir.filter((r) => r.dir !== 0 && r.dir * r.change < 0).sort((a, b) => a.dir * a.change - b.dir * b.change);
const directed = dir.filter((r) => r.dir !== 0).length;

// §04 anaemia
const anaemia = pairs([["anaemia", AN, "Children 6-59 months"], ["anaemia", /^Non-pregnant women/, "Women, not pregnant"], ["anaemia", /^Pregnant women/, "Women, pregnant"],
  ["anaemia", /^All women age 15-49/, "All women 15-49"], ["anaemia", /^All women age 15-19/, "Girls 15-19"], ["anaemia", /^Men age 15-49/, "Men 15-49"], ["anaemia", /^Men age 15-19/, "Boys 15-19"]]);
const anS = strip("anaemia", AN);
const anRows = anS.rows.map((r) => ({ geo: r.geo, v: r.v, v4: r.v4, caution: r.caution }));
const anRose = anRows.filter((r) => r.v4 != null && r.v > r.v4), anBoth = anRows.filter((r) => r.v4 != null);
const anTop = anRows[0], anBot = anRows.at(-1);
const anW5 = V5("anaemia", /^All women age 15-49/), anM5 = V5("anaemia", /^Men age 15-49/), anG5 = V5("anaemia", /^All women age 15-19/);

// §05 children
const nutrition = pairs([["child-nutrition", /are stunted/, "Stunted (too short for age)"], ["child-nutrition", /are wasted/, "Wasted (too thin for height)"],
  ["child-nutrition", /severely wasted/, "Severely wasted"], ["child-nutrition", /are underweight/, "Underweight"], ["child-nutrition", /Children under 5 years who are overweight/, "Overweight"],
  ["child-nutrition", /breastfed within one hour/, "Breastfed in the first hour"], ["child-nutrition", /exclusively breastfed/, "Only breastmilk, under 6 months"],
  ["child-nutrition", /^Total children age 6-23 months receiving an adequate diet/, "Adequate diet, 6-23 months"]]);
const mortality = pairs([["mortality", /^Infant/, "Infant deaths"], ["mortality", /^Under-five/, "Under-five deaths"], ["mortality", /^Neonatal/, "Newborn deaths (first month)"]]);
const imr5 = V5("mortality", /^Infant/), imr4 = V4("mortality", /^Infant/);
const diet5 = V5("child-nutrition", /^Total children age 6-23 months receiving an adequate diet/);
const stS = states(5, "child-nutrition", /are stunted/);

// §06 vaccines
const vaccines = pairs([["vaccination", /fully vaccinated based on information from either/, "Fully vaccinated (card or recall)"], ["vaccination", /received BCG/, "BCG"],
  ["vaccination", /3 doses of polio/, "Polio, 3 doses"], ["vaccination", /3 doses of penta or DPT/, "DPT or penta, 3 doses"], ["vaccination", /first dose of measles/, "Measles, first dose"],
  ["vaccination", /second dose of measles/, "Measles, second dose"], ["vaccination", /3 doses of penta or hepatitis B/, "Hepatitis B or penta, 3 doses"], ["vaccination", /rotavirus/, "Rotavirus, 3 doses"],
  ["vaccination", /vitamin A dose/, "Vitamin A, last 6 months"], ["childhood-disease", /received oral rehydration salts/, "Diarrhoea treated with ORS"],
  ["childhood-disease", /received zinc/, "Diarrhoea treated with zinc"], ["childhood-disease", /fever or symptoms of ARI/, "Fever or chest infection taken to a provider"]]);
const fv5 = V5("vaccination", /fully vaccinated based on information from either/);
const fvS = states(5, "vaccination", /fully vaccinated based on information from either/);
const rota5 = V5("vaccination", /rotavirus/), mcv2 = V5("vaccination", /second dose of measles/);

// §07 births
const births = pairs([["maternity", /antenatal check-up in the first trimester/, "Antenatal check, first three months"], ["maternity", /at least 4 antenatal/, "Four or more antenatal visits"],
  ["maternity", /iron folic acid for 100 days/, "Iron and folic acid, 100+ days"], ["maternity", /iron folic acid for 180 days/, "Iron and folic acid, 180+ days"],
  ["delivery", /^Institutional births \(in/, "Born in a health facility"], ["delivery", /^Institutional births in public/, "Born in a public facility"],
  ["delivery", /^Births attended by skilled/, "Skilled attendant at birth"], ["maternity", /^Mothers who received postnatal care/, "Mother checked within 2 days"],
  ["maternity", /^Children who received postnatal care/, "Baby checked within 2 days"], ["delivery", /^Births delivered by caesarean/, "Caesarean births"]]);
const csP = states(5, "delivery", /private health facility/), csU = new Map(states(5, "delivery", /public health facility that were delivered/).map((c) => [c.geo, c.value]));
const csRows = csP.map((c) => ({ geo: c.geo, private: c.value, public: csU.get(c.geo) ?? null, caution: c.caution }));
const csp5 = V5("delivery", /private health facility/), csu5 = V5("delivery", /public health facility that were delivered/), cs5 = V5("delivery", /^Births delivered by caesarean/);
const oop5 = V5("maternity", /out-of-pocket/);
const ibS = states(5, "delivery", /^Institutional births \(in/);

// §08 blood pressure and sugar
const ncd = ruralUrban([["blood-pressure", /^Women .*Elevated blood pressure \(Systolic ≥140/, "Women: high blood pressure or on medicine"], ["blood-pressure", /^Men .*Elevated blood pressure \(Systolic ≥140/, "Men: high blood pressure or on medicine"],
  ["blood-sugar", /^Women .*taking medicine/, "Women: high blood sugar or on medicine"], ["blood-sugar", /^Men .*taking medicine/, "Men: high blood sugar or on medicine"],
  ["adult-nutrition", /^Women .*overweight or obese/, "Women 15-49: overweight or obese"], ["adult-nutrition", /^Men .*overweight or obese/, "Men 15-49: overweight or obese"],
  ["adult-nutrition", /^Women .*waist-to-hip/, "Women 15-49: high-risk waist"], ["adult-nutrition", /^Men .*waist-to-hip/, "Men 15-49: high-risk waist"]]);
const bpW = states(5, "blood-pressure", /^Women .*Elevated blood pressure \(Systolic ≥140/), bpM = new Map(states(5, "blood-pressure", /^Men .*Elevated blood pressure \(Systolic ≥140/).map((c) => [c.geo, c.value]));
const ncdRows = bpW.map((c) => ({ geo: c.geo, women: c.value, men: bpM.get(c.geo) ?? null, caution: c.caution }));
const sgS = states(5, "blood-sugar", /^Men .*taking medicine/);

// §09 cancer screening
const cvS = states(5, "cancer-screening", /cervical/), brS = new Map(states(5, "cancer-screening", /breast/).map((c) => [c.geo, c.value]));
const cancerRows = cvS.map((c) => ({ geo: c.geo, cervical: c.value, breast: brS.get(c.geo) ?? null, caution: c.caution }));
const cv5 = V5("cancer-screening", /cervical/), br5 = V5("cancer-screening", /breast/), or5 = V5("cancer-screening", /^Women .*oral/);
const cvBelow1 = cvS.filter((c) => c.value < 1).length;

// §10 women's lives
const women = ruralUrban([["empowerment", /bank or savings/, "Bank account she uses"], ["empowerment", /mobile phone/, "Phone she uses"], ["adults", /^Women \(age 15-49\) who have ever used the internet/, "Has used the internet"],
  ["empowerment", /house and\/or land/, "Owns a house or land"], ["empowerment", /paid in cash/, "Worked and paid in cash"], ["empowerment", /three household decisions/, "Has a say in household decisions"],
  ["empowerment", /hygienic methods/, "Hygienic period protection (15-24)"], ["adults", /^Women \(age 15-49\) with 10 or more years/, "10 or more years of school"]]);
const phS = states(5, "empowerment", /mobile phone/), bkS = new Map(states(5, "empowerment", /bank or savings/).map((c) => [c.geo, c.value]));
const womenRows = phS.map((c) => ({ geo: c.geo, phone: c.value, bank: bkS.get(c.geo) ?? null, caution: c.caution }));
const bank5 = V5("empowerment", /bank or savings/), phone5 = V5("empowerment", /mobile phone/), cash5 = V5("empowerment", /paid in cash/), cash4 = V4("empowerment", /paid in cash/);
const net5w = V5("adults", /^Women \(age 15-49\) who have ever used the internet/), net5m = V5("adults", /^Men \(age 15-49\) who have ever used the internet/);
const phoneR = V5("empowerment", /mobile phone/, { sector: "rural" }), phoneU = V5("empowerment", /mobile phone/, { sector: "urban" });

// §11 violence
const vS = states(5, "violence", /spousal violence/);
const violenceRows = vS.map((c) => ({ geo: c.geo, v: c.value, caution: c.caution }));
const sv5 = V5("violence", /spousal violence/), pv5 = V5("violence", /violence during any pregnancy/), sx5 = V5("violence", /sexual violence by age 18/);
const svR = V5("violence", /spousal violence/, { sector: "rural" }), svU = V5("violence", /spousal violence/, { sector: "urban" });
const gCompendium = load("gender-t143-nfhs4"), gC5 = load("gender-t143-nfhs5");
const ps4 = gCompendium?.series?.physical_or_sexual__all_india?.data[0] ?? null, ps5 = gC5?.series?.physical_or_sexual__all_india?.data[0] ?? null;

// §12 tobacco and alcohol
const tbM = new Map(states(5, "tobacco-alcohol", /^Men .*use any kind of tobacco/).map((c) => [c.geo, c.value])), tbW = states(5, "tobacco-alcohol", /^Women .*use any kind of tobacco/);
const tobaccoRows = states(5, "tobacco-alcohol", /^Men .*use any kind of tobacco/).map((c) => ({ geo: c.geo, men: c.value, women: tbW.find((w) => w.geo === c.geo)?.value ?? null, caution: c.caution }));
const tm5 = V5("tobacco-alcohol", /^Men .*use any kind of tobacco/), tw5 = V5("tobacco-alcohol", /^Women .*use any kind of tobacco/), am5 = V5("tobacco-alcohol", /^Men .*consume alcohol/), aw5 = V5("tobacco-alcohol", /^Women .*consume alcohol/);
const twTop = tbW[0];

// §13 household
const household = pairs([["household", /households with electricity/, "Living with electricity"], ["household", /improved drinking-water/, "Improved drinking water"],
  ["household", /improved sanitation/, "Improved toilet"], ["household", /clean fuel/, "Cooking with clean fuel"], ["household", /iodized salt/, "Iodised salt"],
  ["household", /health insurance/, "Someone covered by health insurance"], ["household", /birth was registered/, "Births registered, under-5s"],
  ["household", /^Deaths in the last 3 years/, "Deaths registered"], ["household", /pre-primary school/, "Five-year-olds in pre-school"]]);
const san5 = V5("household", /improved sanitation/), san4 = V4("household", /improved sanitation/), fuel5 = V5("household", /clean fuel/), fuelR = V5("household", /clean fuel/, { sector: "rural" });
const ins5 = V5("household", /health insurance/), ins4 = V4("household", /health insurance/);

// §14 fertility
const tfS = strip("marriage-fertility", /Total Fertility/);
const tfRows = tfS.rows.map((r) => ({ geo: r.geo, v: r.v, v4: r.v4 }));
const tfr5 = V5("marriage-fertility", /Total Fertility/), tfr4 = V4("marriage-fertility", /Total Fertility/);
const tfAbove = tfRows.filter((r) => r.v > 2.1);
const fp = pairs([["family-planning", /: Any method/, "Any method"], ["family-planning", /: Any modern method/, "A modern method"], ["family-planning", /Female sterilization/, "Female sterilisation"],
  ["family-planning", /: Condom/, "Condom"], ["family-planning", /: Pill/, "Pill"], ["family-planning", /IUD/, "IUD"], ["family-planning", /Male sterilization/, "Male sterilisation"],
  ["family-planning", /Injectables/, "Injectables"], ["unmet-need", /^Unmet need for spacing/, "Unmet need for spacing"], ["unmet-need", /^Total Unmet/, "Unmet need, total"]]);
const fst5 = V5("family-planning", /Female sterilization/), mst5 = V5("family-planning", /Male sterilization/), cm5 = V5("marriage-fertility", /married before age 18/), cm4 = V4("marriage-fertility", /married before age 18/);

// §15 village and town: every per-cent measure, NFHS-5
const gap = [];
for (const t of TABLE_ORDER) {
  const b = bundleOf(5, t);
  for (const s of Object.values(b.series)) if (s.geo === "All India" && s.sector === "total" && s.unit === "percent") {
    const ru = val(5, t, new RegExp("^" + s.group.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "$"), { sector: "rural" }), ur = val(5, t, new RegExp("^" + s.group.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "$"), { sector: "urban" });
    if (ru != null && ur != null) gap.push({ label: s.group, short: short(s.group), rural: ru, urban: ur, gap: Math.round((ur - ru) * 10) / 10 });
  }
}
gap.sort((a, b) => b.gap - a.gap);
const gapTop = gap[0], gapBot = gap.at(-1), ruralAhead = gap.filter((g) => g.gap < 0);

// §16 the state table, NFHS-5
const COLS = [["anaemia", AN, "Child anaemia", true], ["child-nutrition", /are stunted/, "Stunted", true], ["mortality", /^Infant/, "Infant deaths /1,000", true],
  ["delivery", /^Institutional births \(in/, "Born in a facility", false], ["vaccination", /fully vaccinated based on information from either/, "Fully vaccinated", false],
  ["blood-pressure", /^Women .*Elevated blood pressure \(Systolic ≥140/, "Women, high BP", true], ["blood-sugar", /^Women .*taking medicine/, "Women, high sugar", true],
  ["empowerment", /mobile phone/, "Women with a phone", false], ["violence", /spousal violence/, "Spousal violence", true], ["tobacco-alcohol", /^Men .*use any kind of tobacco/, "Men, tobacco", true],
  ["household", /clean fuel/, "Clean cooking fuel", false], ["marriage-fertility", /Total Fertility/, "Children per woman", null]];
const geos = states(5, "anaemia", AN).map((c) => c.geo).sort();
const table = {
  cols: COLS.map(([t, re, label, bad]) => ({ short: label, label, bad })),
  india: { geo: "India", v: COLS.map(([t, re]) => val(5, t, re)) },
  rows: geos.map((g) => ({ geo: g, v: COLS.map(([t, re]) => val(5, t, re, { geo: g })) })),
};

const DATA = {
  direction: dir.map((r) => ({ label: r.label, short: r.short, a: r.a, b: r.b, change: r.change, dir: r.dir })),
  anaemia, nutrition, mortality, vaccines, births, household, fp, ncd, women,
  "anaemia-states": { rows: anRows, ref: an5 },
  "ncd-states": { rows: ncdRows, ref: bpw, refLabel: "India, women" },
  "cancer-states": { rows: cancerRows, ref: cv5, refLabel: "India, cervical" },
  "women-states": { rows: womenRows, ref: phone5, refLabel: "India, phone" },
  "violence-states": { rows: violenceRows, ref: sv5 },
  "tobacco-states": { rows: tobaccoRows, ref: tm5, refLabel: "India, men" },
  "tfr-states": { rows: tfRows, ref: tfr5, fmt: "2" },
  "cs-states": { rows: csRows, ref: csp5, refLabel: "India, private" },
  gap, table,
};
const asOf = "NFHS-5";
---
<Base
  title="Family health · India Atlas"
  description={D.description}
  nav="guides"
  dateStamp={dateStamp(D)}
  crumbLeft={`<a href="/guides/">Guides</a> / ${D.section} / <b>${D.crumbTitle}</b>`}
  crumbRight={`${D.statusNote}, <b>${D.version}</b>`}
  canonical="https://atlas.thisindianlife.today/guides/nfhs/"
  ogImage={`/og/${D.slug}.png`}
>
<script type="application/json" id="nfhs-data" is:inline set:html={JSON.stringify(DATA)}></script>
<style is:global>
  .nf-table-wrap{overflow-x:auto}
  .nf-table{border-collapse:collapse;font-family:var(--sans);font-size:.8rem;font-variant-numeric:tabular-nums;width:100%;min-width:980px}
  .nf-table th{font-weight:500;color:var(--ink-soft);text-align:right;padding:6px 6px;border-bottom:1px solid var(--rule-2);vertical-align:bottom;line-height:1.25}
  .nf-table th:first-child,.nf-table td:first-child{text-align:left;white-space:nowrap}
  .nf-table td{text-align:right;padding:4px 6px;border-bottom:1px solid var(--rule);color:var(--ink)}
  .nf-table tr.ai td{font-weight:600;border-bottom:1px solid var(--rule-2)}
  .nf-withheld{font-family:var(--sans);font-size:.85rem;color:var(--ink-soft)}
  .nf-withheld li{margin:.2rem 0}
</style>
<div class="page">

  <div class="titleblock break">
    <div class="kicker">{kicker(D)}</div>
    <div class="hero-grid">
      <h1 set:html={D.headline} />
      <p class="lede">India's largest health survey visits about six lakh homes, weighs the children, takes a drop of blood and a blood-pressure reading, and asks women about their bank accounts and their husbands. Between 2015-16 and 2019-21 it found fewer babies dying, more births in hospitals and cleaner toilets. It also found more children anaemic, and, for the first time across all adults, one in five with high blood pressure.</p>
    </div>
    <div class="meta">
      <span>Source <b>IIPS for the Ministry of Health and Family Welfare, via MoSPI</b></span>
      <span>Instrument <b>Household sample survey, two rounds</b></span>
      <span>Rounds <b>NFHS-4 (2015-16), NFHS-5 (2019-21)</b></span>
      <span>Coverage <b>India and {nStates} states and UTs, rural and urban</b></span>
      <span>Tables <b>21, every one baked</b></span>
      <span>Unit <b>Per cent unless noted</b></span>
    </div>
    <div class="numbers">
      <div class="num"><div class="l">Children 6-59 months anaemic</div><div class="v acc" id="n-anaemia">{f1(an5)}<span class="pc">%</span></div><div class="d" id="d-anaemia">{f1(an4)}% in NFHS-4</div></div>
      <div class="num"><div class="l">Children under 5 stunted</div><div class="v" id="n-stunting">{f1(st5)}<span class="pc">%</span></div><div class="d" id="d-stunting">{f1(st4)}% in NFHS-4</div></div>
      <div class="num"><div class="l">Births in a health facility</div><div class="v" id="n-institutional">{f1(ib5)}<span class="pc">%</span></div><div class="d" id="d-institutional">{f1(ib4)}% in NFHS-4</div></div>
      <div class="num"><div class="l">Men 15+ with high blood pressure or on medicine</div><div class="v" id="n-bp">{f1(bpm)}<span class="pc">%</span></div><div class="d" id="d-bp">women {f1(bpw)}%, first measured for all adults</div></div>
    </div>
  </div>

  <!-- § 01 the current reading. Inputs: nfhs-5-* and nfhs-4-* (All India), via pipeline/lib/facts-health-gender.mjs. Prose: generated slots. -->
  <section>
    <div class="sec-head"><span class="no">01</span><h2>The current reading</h2><span class="line"></span><span class="unit">NFHS-5, {round5.latestPeriod}</span></div>
    <div class="reading-top">
      <div><span class="rk">Children anaemic, NFHS-5</span><div class="big" id="rb-anaemia">{f1(an5)}<span class="pc">%</span></div></div>
      <p class="rt-cap">Children aged six months to five years whose haemoglobin is below 11 grams per decilitre, from a drop of blood taken at home. In the round before, NFHS-4, the share was <b id="rt-anaemia-prev">{f1(an4)}%</b>.</p>
      <div class="rt-side"><span class="rk">Women 15-49 anaemic</span><div class="rt-side-v" id="rb-women">{f1(anW5)}<span class="pc">%</span></div></div>
    </div>
    <div class="reading-cols">
      <div class="reading-col">
        <span class="mk">What the survey says</span>
        <Prose slot="nfhs.current-reading.what-the-print-says" />
      </div>
      <div class="reading-col now">
        <span class="mk">What it does not say</span>
        <Prose slot="nfhs.current-reading.what-it-does-not-say" />
      </div>
    </div>
  </section>

  <!-- § 02 how to read the survey: evergreen, human-written -->
  <section>
    <div class="sec-head"><span class="no">02</span><h2>How to read the survey</h2><span class="line"></span></div>
    <div class="wm-grid">
      <div>
        <p>The National Family Health Survey is a door-to-door visit. Field teams working for the International Institute for Population Sciences, on behalf of the Ministry of Health and Family Welfare, sit with a sample of households in every district, ask about births and deaths, vaccines and contraception, money and violence, and measure what a clinic would: height, weight, waist, a drop of blood for haemoglobin and sugar, three blood-pressure readings. Each round publishes a fact sheet for India and for every state and union territory, split by village and town. This guide holds every line of those fact sheets that MoSPI serves: 21 tables, two rounds, {nCells.toLocaleString("en-IN")} figures in {nBundles} files.</p>
        <p>Every figure is a share of people at the time of the survey, not a count of new cases. "Two in three children anaemic" means two in three children had low haemoglobin on the day the blood was taken. Mortality rates are the exception: they count deaths in the five years before the interview, per 1,000 births.</p>
        <p><b>The two rounds are two rulers.</b> NFHS-4 ({round4.fieldwork}) and NFHS-5 ({round5.fieldwork}) used different samples, and several questions changed. NFHS-5 measured blood pressure and blood sugar, and asked about tobacco and alcohol, for everyone 15 and over; NFHS-4 for ages 15 to 49. Its cancer questions changed too. This guide puts the two rounds side by side, a grey dot and a blue one, and never draws them as a trend: two surveys are a before and an after, not a line.</p>
        <p><b>A figure in brackets</b> in the fact sheet rests on 25 to 49 people; this guide marks it with an asterisk. A figure based on fewer than 25 is not published at all. Small union territories (Lakshadweep, Ladakh, the Andaman and Nicobar Islands) often sit at the edges of a ranking for this reason.</p>
        <!-- profiles (lb/profiles): NFHS-6, the third round, from the IIPS fact sheets -->
        <p><b>NFHS-6 (2023-24), the third round,</b> is not on MoSPI's API, so it comes from the IIPS fact sheets themselves (the 182-page PDF IIPS published in May 2026), read table by table into data and checked before use: the NFHS-5 figures those fact sheets print beside each indicator agree with MoSPI's NFHS-5 to the fact sheet's rounding in 2,486 of 2,499 state figures, every total lies between its urban and rural figures, and Bihar's pages were checked by hand against the PDF. Its 101 indicators for India and every state and UT are in this guide's data and every-cut table as their own ruler, with the NFHS-5 column the fact sheets print beside them; the plates above still compare NFHS-4 and NFHS-5. The state profiles use NFHS-6 where its fact sheets carry a measure.</p>
        <p><b>What we withhold.</b> MoSPI's copy of the survey files some NFHS-4 figures against the wrong line. For India it gives 3.3 per cent of women with a bank account; the NFHS-5 national report says 53 per cent. The error shifts whole columns in the tables on unmet need for contraception, anaemia, blood pressure, women's lives and violence, and it repeats in every state. (MoSPI corrected its maternity-care table between August and October 2026; we check every withheld line against what MoSPI serves on each fetch.) We checked each NFHS-4 line against the DHS Program's own tabulation of the same survey and against the national report, and we do not use the {nWithheld} NFHS-4 lines that fail or that measured a different group of people. NFHS-5 checks clean. The list is below the provenance notes.</p>
      </div>
      <div class="wm-rail">
        <aside class="margin-note"><span class="mk">Margin note, i</span><b>The pandemic split the survey.</b> NFHS-5 surveyed 22 states and UTs between June 2019 and January 2020. The other 14 began in January 2020 and, interrupted by the pandemic, finished by April 2021. A state's figure belongs to the months its own fieldwork ran.</aside>
        <aside class="margin-note"><span class="mk">Margin note, ii</span><b>Borders moved.</b> Ladakh was part of Jammu and Kashmir in NFHS-4; Dadra and Nagar Haveli and Daman and Diu were two territories, now one. Each round keeps its own map; nothing here re-adds them.</aside>
        <aside class="margin-note"><span class="mk">Margin note, iii</span><b>Rounds, not a trend.</b> Two surveys show a change, not a trend. NFHS-6, the third point, is in the data below; the plates here compare the first two.</aside>
      </div>
    </div>
  </section>

  <!-- § 03 what changed. Inputs: every per-cent sub-indicator of every nfhs-4-* and nfhs-5-* bundle, All India total. Prose: evergreen + as-of. -->
  <section>
    <div class="sec-head"><span class="no">03</span><h2>What changed between the rounds</h2><span class="line"></span><span class="unit">Every measure taken both times, percentage points</span></div>
    <div class="break">
      <figure id="cb-direction" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Of {directed} measures with a right direction, {better.length} moved the right way; anaemia leads the {worse.length} that did not</h3>
            <div class="sub">Change from NFHS-4 to NFHS-5, India, every per-cent measure the fact sheet carries in both rounds. Blue bars moved the wrong way; light grey bars have no right direction.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-direction">{worse.length}</div><div class="c">measures moved the wrong way</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="background:#A3A9B4;height:8px"></i>Moved the right way</button>
            <button class="chip"><i style="background:#2E4BD8;height:8px"></i>Moved the wrong way</button>
            <button class="chip"><i style="background:#C9CED6;height:8px"></i>No right direction</button>
          </div>
          <div class="plotzone" id="plot-direction"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 fact sheets (IIPS, MoHFW), via MoSPI. India, rural and urban together. NFHS-4 lines MoSPI misfiles are left out. Which way is right is our judgement: more anaemia, stunting, unmet need or child marriage is worse; caesarean births, family-planning methods and the sex ratio of the population have no right direction here.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>One bar for each measure, the change in percentage points from the first round to the second. A bar to the right means the share rose. Whether a rise is good depends on the measure: more vaccinated children is good, more anaemic children is not. The blue bars are the ones that went the wrong way for the family.</p>
            <p>A point is a point of the whole population, not a per cent change. Ten points on a measure that starts at 20 is a large change; ten points on one that starts at 80 is a smaller one in proportion.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>The largest rise is <b id="ex-dir-top">{dir[0].short.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())}, {pt(dir[0].a, dir[0].b)}</b>; the largest fall, <b id="ex-dir-bot">{dir.at(-1).short.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())}, {pt(dir.at(-1).a, dir.at(-1).b)}</b>. Of the measures that went the wrong way, the worst is {worse[0].short.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())} ({f1(worse[0].a)}% to {f1(worse[0].b)}%), then {worse[1].short.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())} ({f1(worse[1].a)}% to {f1(worse[1].b)}%).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 04 anaemia. Inputs: nfhs-4-anaemia, nfhs-5-anaemia (All India, every state). -->
  <section>
    <div class="sec-head"><span class="no">04</span><h2>Anaemia, the measure that went the wrong way</h2><span class="line"></span><span class="unit">Per cent anaemic, NFHS-4 and NFHS-5</span></div>
    <div class="break">
      <figure id="cb-anaemia" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Two in three young children and more than half of women are anaemic, and every group measured twice got worse</h3>
            <div class="sub">Share anaemic, India, NFHS-4 (grey) and NFHS-5 (blue). MoSPI's copy has no NFHS-4 figure for men and boys, and its figure for girls 15-19 is withheld.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-anaemia">{f1(an5)}<span class="pc">%</span></div><div class="c">children 6-59 months, NFHS-5</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#5F6675"></i>NFHS-4, 2015-16</button>
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#2E4BD8"></i>NFHS-5, 2019-21</button>
          </div>
          <div class="plotzone" id="plot-anaemia"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 (IIPS, MoHFW), via MoSPI. Anaemic: haemoglobin below 11 g/dl for children and pregnant women, 12 for other women, 13 for men, adjusted for altitude and, for adults, smoking. The NFHS-4 figure for girls 15-19 is withheld (MoSPI files the men's figure under it).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Anaemia means too little haemoglobin to carry oxygen. A child with it tires easily and learns more slowly; a pregnant woman with it is more likely to bleed dangerously at birth. The usual causes in India are a diet short of iron, folate and vitamin B12, worms and malaria, and blood lost in childbirth and menstruation.</p>
            <p>Both rounds measured haemoglobin the same way, from a drop of blood from a finger. Experts have argued that a finger-prick reads lower than blood drawn from a vein, which would overstate anaemia in both rounds alike; it would not explain a rise between them.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Children <b id="ex-an-children">{f1(an5)}%</b>, up from {f1(an4)}%. All women 15-49 <b id="ex-an-women">{f1(anW5)}%</b>, girls 15-19 {f1(anG5)}%, men {f1(anM5)}%. Anaemia rose among children in <b id="ex-an-rose">{anRose.length}</b> of the {anBoth.length} states and UTs measured in both rounds.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-anaemia-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>From {anBot.geo} at {f1(anBot.v)}% to {anTop.geo} at {f1(anTop.v)}%, and higher than in NFHS-4 in {anRose.length} of {anBoth.length} states</h3>
            <div class="sub">Children 6-59 months anaemic, by state and UT, NFHS-5 (blue) with NFHS-4 (grey) where the state existed in both rounds. Sorted by NFHS-5.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-anaemia-states">{anRose.length} of {anBoth.length}</div><div class="c">states where it rose</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-anaemia-states"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI. * an estimate on 25 to 49 children. Ladakh and Dadra and Nagar Haveli and Daman and Diu have no NFHS-4 figure of their own.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Each row is a state; the blue dot is NFHS-5 and the grey dot, where there is one, NFHS-4. The dashed rule is India. Anaemia does not sort states the way income does: some richer states sit near the top and several north-eastern states near the bottom. Diet, water and sanitation, worm infections, inherited blood disorders and the reach of iron supplements all play a part.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Highest: <b id="ex-ans-top">{anTop.geo}, {f1(anTop.v)}%</b>. Lowest: <b id="ex-ans-bot">{anBot.geo}, {f1(anBot.v)}%</b>. {anRows.filter((r) => r.v > an5).length} of {anRows.length} states and UTs sit above India's {f1(an5)}%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 05 children: survival and growth. Inputs: nfhs-*-child-nutrition, nfhs-*-mortality. -->
  <section>
    <div class="sec-head"><span class="no">05</span><h2>Children: surviving and growing</h2><span class="line"></span><span class="unit">Children under 5, NFHS-4 and NFHS-5</span></div>
    <div class="break">
      <figure id="cb-nutrition" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Stunting fell {f1(st4 - st5)} points, but a third of children under five are still too short for their age</h3>
            <div class="sub">Nutrition of children under 5 and how they are fed, India, NFHS-4 (grey) and NFHS-5 (blue). MoSPI's copy has no NFHS-4 figure for overweight children.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-nutrition">{f1(st5)}<span class="pc">%</span></div><div class="c">stunted, NFHS-5</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-nutrition"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 (IIPS, MoHFW), via MoSPI. Stunted, wasted and underweight against the WHO child growth standards. Adequate diet: enough meals and enough kinds of food for the child's age.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Stunting is the long story: a child too short for her age has gone without enough food, or lost it to infection, for months or years, often since the womb. Wasting is the short story: too thin for her height, usually from recent hunger or illness. Underweight mixes the two.</p>
            <p>The feeding lines explain part of it. Most children get breastmilk; few get enough meals of enough kinds of food once they are past six months.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Stunted <b id="ex-nu-stunted">{f1(st5)}%</b>, from {f1(st4)}%. Only <b id="ex-nu-diet">{f1(diet5)}%</b> of children aged 6 to 23 months get an adequate diet. Stunting is highest in {stS[0].geo} ({f1(stS[0].value)}%) and lowest in {stS.at(-1).geo} ({f1(stS.at(-1).value)}%).</p>
          </div>
        </div>
      </figure>

      <figure id="cb-mortality" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Infant deaths fell from {f0(imr4)} to {f0(imr5)} for every 1,000 births</h3>
            <div class="sub">Deaths per 1,000 live births in the five years before each survey, India, NFHS-4 (grey) and NFHS-5 (blue). MoSPI's copy has no NFHS-4 newborn rate.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-mortality">{f1(imr5)}</div><div class="c">infant deaths per 1,000, NFHS-5</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-mortality"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 (IIPS, MoHFW), via MoSPI. NFHS-4 rates are printed to the whole number. The Sample Registration System's annual rates are in the Women and men guide.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The survey counts deaths from mothers' birth histories, so each rate describes the five years before the interview, not the survey year itself. The Registrar General's Sample Registration System counts deaths every year and is the better source for a single year.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Infant deaths <b id="ex-mo-imr">{f1(imr5)}</b> per 1,000 births, under-five deaths {f1(val(5, "mortality", /^Under-five/))}, newborn deaths {f1(val(5, "mortality", /^Neonatal/))}.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 06 vaccines and childhood illness. Inputs: nfhs-*-vaccination, nfhs-*-childhood-disease. -->
  <section>
    <div class="sec-head"><span class="no">06</span><h2>Vaccines and childhood illness</h2><span class="line"></span><span class="unit">Children 12-23 months, NFHS-4 and NFHS-5</span></div>
    <div class="break">
      <figure id="cb-vaccines" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Three in four children are fully vaccinated; the newer vaccines reach far fewer</h3>
            <div class="sub">Vaccination of children 12-23 months and treatment of childhood illness, India, NFHS-4 (grey) and NFHS-5 (blue). Rotavirus, the second measles dose and the NFHS-5 definition of full vaccination have no NFHS-4 figure.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-vaccines">{f1(fv5)}<span class="pc">%</span></div><div class="c">fully vaccinated, NFHS-5</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-vaccines"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 (IIPS, MoHFW), via MoSPI. Fully vaccinated: BCG, measles and three doses each of polio and DPT, from the vaccination card or the mother's recall.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The first doses come at a clinic soon after birth and almost every child gets them. The later doses need the family to come back, again and again, and that is where children drop out. Rotavirus vaccine, which prevents the commonest cause of severe diarrhoea, joined the public programme state by state from 2016.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Fully vaccinated <b id="ex-va-full">{f1(fv5)}%</b>; rotavirus <b id="ex-va-rota">{f1(rota5)}%</b>; second measles dose {f1(mcv2)}%. Full vaccination is lowest in {fvS.at(-1).geo} ({f1(fvS.at(-1).value)}%).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 07 births and mothers. Inputs: nfhs-*-maternity, nfhs-*-delivery. -->
  <section>
    <div class="sec-head"><span class="no">07</span><h2>Births and mothers</h2><span class="line"></span><span class="unit">Births in the five years before the survey</span></div>
    <div class="break">
      <figure id="cb-births" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Nine in ten babies are now born in a health facility; the care before and after birth lags</h3>
            <div class="sub">Care before, during and after birth, India, NFHS-4 (grey) and NFHS-5 (blue). Lines with only a blue dot have no NFHS-4 figure in MoSPI's copy, or it is withheld.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-births">{f1(ib5)}<span class="pc">%</span></div><div class="c">born in a health facility</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-births"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 (IIPS, MoHFW), via MoSPI. Postnatal checks: a doctor, nurse, ANM or other health worker within two days of the birth.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Since 2005 the Janani Suraksha Yojana has paid mothers to deliver in a facility, and the Janani Shishu Suraksha Karyakram has made the delivery, the medicines and the ambulance free in public hospitals. The rise in facility births is their mark. Iron tablets and four antenatal visits depend on the months before the birth, when the system reaches women less reliably.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Born in a facility <b id="ex-bi-inst">{f1(ib5)}%</b>, from {f1(ib4)}%; lowest in {ibS.at(-1).geo} ({f1(ibS.at(-1).value)}%). A delivery in a public facility still cost a family ₹<span id="ex-bi-oop">{Math.round(oop5).toLocaleString("en-IN")}</span> on average from its own pocket.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-cs-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Almost half of private-hospital births are by caesarean, against {f1(csu5)}% in public hospitals</h3>
            <div class="sub">Share of births in each kind of facility delivered by caesarean section, by state and UT, NFHS-5: private (marigold) and public (blue).</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-cs">{f1(csp5)}<span class="pc">%</span></div><div class="c">of private-facility births</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#C47A16"></i>Private facilities</button>
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#2E4BD8"></i>Public facilities</button>
          </div>
          <div class="plotzone" id="plot-cs-states"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI. * an estimate on 25 to 49 births.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>A caesarean saves lives when a birth goes wrong. The World Health Organization has long said that rates above 10 to 15 per cent of all births bring no further benefit to mothers or babies. Private hospitals are paid more for an operation than for a normal birth, and many women ask for one; the survey cannot say which births needed it.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Caesarean births are <b id="ex-cs-all">{f1(cs5)}%</b> of all births: <b id="ex-cs-priv">{f1(csp5)}%</b> in private facilities and {f1(csu5)}% in public ones. The private share is highest in {csRows[0].geo} ({f1(csRows[0].private)}%).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 08 blood pressure and blood sugar. Inputs: nfhs-5-blood-pressure, nfhs-5-blood-sugar, nfhs-*-adult-nutrition. -->
  <section>
    <div class="sec-head"><span class="no">08</span><h2>Blood pressure and blood sugar</h2><span class="line"></span><span class="unit">Adults 15 and over, NFHS-5</span></div>
    <div class="break">
      <figure id="cb-ncd" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>One adult in five has high blood pressure, and towns run higher than villages on every measure</h3>
            <div class="sub">Adults with high blood pressure or blood sugar (or taking medicine for it), and overweight and waist measures, India, NFHS-5: villages (grey) and towns (blue).</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-ncd">{f1(bpm)}<span class="pc">%</span></div><div class="c">men with high blood pressure or on medicine</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#5F6675"></i>Villages</button>
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#2E4BD8"></i>Towns</button>
          </div>
          <div class="plotzone" id="plot-ncd"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 (IIPS, MoHFW), via MoSPI. High blood pressure: 140/90 mm Hg or above, or on medicine. High blood sugar: above 140 mg/dl at a random reading, or on medicine. Weight and waist: ages 15-49. NFHS-4 measured ages 15-49 only, so it is not shown.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The interviewer takes three blood-pressure readings and a finger-prick for sugar, at whatever time of day the visit happens. A single random sugar reading is a screen, not a diagnosis of diabetes. People already taking medicine count, whatever their reading that day, because their condition is known.</p>
            <p>High blood pressure and diabetes cause no pain for years, then cause strokes, heart attacks and kidney failure.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>High blood pressure or on medicine: men <b id="ex-ncd-bpm">{f1(bpm)}%</b>, women <b id="ex-ncd-bpw">{f1(bpw)}%</b>. High blood sugar or on medicine: men {f1(sgm)}%, women {f1(sgw)}%; highest among men in {sgS[0].geo} ({f1(sgS[0].value)}%).</p>
          </div>
        </div>
      </figure>

      <figure id="cb-ncd-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>High blood pressure ranges from {f1(ncdRows.at(-1).women)}% of women in {ncdRows.at(-1).geo} to {f1(ncdRows[0].women)}% in {ncdRows[0].geo}</h3>
            <div class="sub">Adults 15 and over with high blood pressure or on medicine, by state and UT, NFHS-5: women (blue) and men (marigold). Sorted by women.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-ncd-states">{f1(ncdRows[0].women)}<span class="pc">%</span></div><div class="c">women, {ncdRows[0].geo}</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#2E4BD8"></i>Women</button>
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#C47A16"></i>Men</button>
          </div>
          <div class="plotzone" id="plot-ncd-states"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The states with the most high blood pressure are mostly the richer, older, more urban ones: the condition rises with age, weight and salt. A state low on the list is not necessarily healthier; it may simply be younger.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Men run above women in {ncdRows.filter((r) => r.men != null && r.men > r.women).length} of {ncdRows.length} states and UTs. Highest for men: <b id="ex-ncds-men">{[...ncdRows].sort((a, b) => b.men - a.men)[0].geo}, {f1([...ncdRows].sort((a, b) => b.men - a.men)[0].men)}%</b>.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 09 cancer screening. Inputs: nfhs-5-cancer-screening. -->
  <section>
    <div class="sec-head"><span class="no">09</span><h2>Cancer screening</h2><span class="line"></span><span class="unit">Women and men 30-49, NFHS-5</span></div>
    <div class="break">
      <figure id="cb-cancer-states" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Fewer than two women in a hundred have ever been screened for cervical cancer</h3>
            <div class="sub">Women 30-49 who have ever had a screening test for cervical cancer (blue) or a breast examination (marigold), by state and UT, NFHS-5.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-cancer">{f1(cv5)}<span class="pc">%</span></div><div class="c">women 30-49 ever screened for cervical cancer</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#2E4BD8"></i>Cervical</button>
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#C47A16"></i>Breast</button>
          </div>
          <div class="plotzone" id="plot-cancer-states"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI. NFHS-4 asked women 15-49 about any examination of the cervix or breast, a different question, so it is not shown.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Cervical cancer is the second most common cancer among Indian women, and among the most preventable: a simple test every few years finds the changes before they become cancer. India began offering routine screening to people over 30 only in the late 2010s, so NFHS-5 caught the programme early. A higher dot is better here.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Ever screened for cervical cancer: <b id="ex-ca-cv">{f1(cv5)}%</b>; breast examination {f1(br5)}%; mouth examination {f1(or5)}%. The highest is {cancerRows[0].geo} at {f1(cancerRows[0].cervical)}%; {cvBelow1} states and UTs are below 1%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 10 women's lives. Inputs: nfhs-5-empowerment, nfhs-5-adults (and nfhs-4 where baked). -->
  <section>
    <div class="sec-head"><span class="no">10</span><h2>Women's money, phones and say at home</h2><span class="line"></span><span class="unit">Women 15-49, NFHS-5</span></div>
    <div class="break">
      <figure id="cb-women" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Four in five women have a bank account they use; half have a phone, and village women lag furthest on phones and the internet</h3>
            <div class="sub">Women 15-49, India, NFHS-5: villages (grey) and towns (blue).</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-women">{f1(bank5)}<span class="pc">%</span></div><div class="c">have a bank account they use</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#5F6675"></i>Villages</button>
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#2E4BD8"></i>Towns</button>
          </div>
          <div class="plotzone" id="plot-women"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 (IIPS, MoHFW), via MoSPI. Household decisions: married women who usually take part in decisions on their own health care, large purchases and visits to family. MoSPI's NFHS-4 figures for the bank, phone, property and period lines are withheld; the NFHS-5 national report puts bank accounts at 53 per cent in NFHS-4.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The survey asks whether a woman has an account that she herself uses, and a phone that she herself uses, not one in the house. It cannot say who decides what is withdrawn, or who reads her messages.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Bank account <b id="ex-wo-bank">{f1(bank5)}%</b>; phone <b id="ex-wo-phone">{f1(phone5)}%</b>, {f1(phoneR)}% in villages and {f1(phoneU)}% in towns. {f1(net5w)}% of women have ever used the internet, against {f1(net5m)}% of men. Paid in cash for work: {f1(cash5)}%, against {f1(cash4)}% in NFHS-4.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-women-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>A woman's phone depends on her state: {f1(womenRows.at(-1).phone)}% in {womenRows.at(-1).geo}, {f1(womenRows[0].phone)}% in {womenRows[0].geo}</h3>
            <div class="sub">Women 15-49 with a phone (blue) and a bank account (marigold) they themselves use, by state and UT, NFHS-5. Sorted by phone.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-women-states">{f1(phone5)}<span class="pc">%</span></div><div class="c">India, phone</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#2E4BD8"></i>Phone</button>
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#C47A16"></i>Bank account</button>
          </div>
          <div class="plotzone" id="plot-women-states"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Bank accounts are spread far more evenly than phones. An account can be opened for a woman by a government scheme; a phone is something her household decides to buy for her.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Bank accounts range from {f1(Math.min(...womenRows.map((r) => r.bank).filter((v) => v != null)))}% to {f1(Math.max(...womenRows.map((r) => r.bank).filter((v) => v != null)))}% across states; phones from <b id="ex-wos-lo">{f1(womenRows.at(-1).phone)}%</b> to {f1(womenRows[0].phone)}%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 11 violence at home. Inputs: nfhs-5-violence; gender-t143 (the compendium's NFHS reprint). -->
  <section>
    <div class="sec-head"><span class="no">11</span><h2>Violence at home</h2><span class="line"></span><span class="unit">Ever-married women 18-49, NFHS-5</span></div>
    <div class="break">
      <figure id="cb-violence-states" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Nearly three married women in ten say a husband has hurt them; in {violenceRows[0].geo}, {f1(violenceRows[0].v)}%</h3>
            <div class="sub">Ever-married women 18-49 who have ever experienced physical, sexual or emotional violence from a husband, by state and UT, NFHS-5.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-violence">{f1(sv5)}<span class="pc">%</span></div><div class="c">India, NFHS-5</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-violence-states"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI. MoSPI's NFHS-4 figures for this table are misfiled and withheld; the Women and Men in India compendium prints NFHS-4 for physical or sexual violence by a husband (see the Women and men guide).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The questions are asked of one woman per household, alone, by a trained woman interviewer, and only if privacy can be ensured. Even so, every survey of this kind undercounts: women who are afraid, ashamed or still living with the man do not always say. A low figure can mean less violence, or less telling.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Ever hurt by a husband: <b id="ex-vi-all">{f1(sv5)}%</b>, {f1(svR)}% in villages and {f1(svU)}% in towns; hurt during a pregnancy {f1(pv5)}%. In the compendium's reprint, physical or sexual violence by a husband was {f1(ps4)}% in NFHS-4 and {f1(ps5)}% in NFHS-5.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 12 tobacco and alcohol. Inputs: nfhs-5-tobacco-alcohol. -->
  <section>
    <div class="sec-head"><span class="no">12</span><h2>Tobacco and alcohol</h2><span class="line"></span><span class="unit">Adults 15 and over, NFHS-5</span></div>
    <div class="break">
      <figure id="cb-tobacco-states" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>{f1(tm5)}% of men use tobacco; among women it is {f1(tw5)}% nationally but {f1(twTop.value)}% in {twTop.geo}</h3>
            <div class="sub">Adults 15 and over who use any kind of tobacco, men (marigold) and women (blue), by state and UT, NFHS-5. Sorted by men.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-tobacco">{f1(tm5)}<span class="pc">%</span></div><div class="c">men using tobacco</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#C47A16"></i>Men</button>
            <button class="chip"><i style="width:9px;height:9px;border-radius:50%;background:#2E4BD8"></i>Women</button>
          </div>
          <div class="plotzone" id="plot-tobacco-states"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI. Tobacco includes smoking, chewing, gutkha, khaini and snuff. NFHS-4 asked ages 15-49, so it is not shown.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>In most of India tobacco is a man's habit and chewing is as common as smoking. The north-east is different: there women chew betel and tobacco too, and the gap between the sexes narrows.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Tobacco: men <b id="ex-to-men">{f1(tm5)}%</b>, women <b id="ex-to-women">{f1(tw5)}%</b>. Alcohol: men {f1(am5)}%, women {f1(aw5)}%. Men's tobacco use is highest in {tobaccoRows[0].geo} ({f1(tobaccoRows[0].men)}%).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 13 the household. Inputs: nfhs-*-household. -->
  <section>
    <div class="sec-head"><span class="no">13</span><h2>The household</h2><span class="line"></span><span class="unit">NFHS-4 and NFHS-5</span></div>
    <div class="break">
      <figure id="cb-household" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Toilets spread fastest: improved sanitation rose from {f1(san4)}% to {f1(san5)}%</h3>
            <div class="sub">Household conditions, India, NFHS-4 (grey) and NFHS-5 (blue). MoSPI's copy has no NFHS-4 figure for death registration or pre-school.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-household">{f1(san5)}<span class="pc">%</span></div><div class="c">live with an improved toilet</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-household"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 (IIPS, MoHFW), via MoSPI. Improved toilet: one that separates waste from human contact, such as a flush to a septic tank or a pit with a slab. Clean fuel: electricity, LPG, natural gas or biogas.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>These are the conditions children grow up in. Toilets and clean water decide how often a child gets diarrhoea; a smoky kitchen decides how often she coughs. The Swachh Bharat Mission built toilets between the two rounds and Ujjwala gave LPG connections; the survey counts whether a household uses them, not whether it has one.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Improved toilet <b id="ex-hh-san">{f1(san5)}%</b>. Clean cooking fuel {f1(fuel5)}%, only {f1(fuelR)}% in villages. Households with any member covered by health insurance {f1(ins5)}%, from {f1(ins4)}%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 14 fertility and family planning. Inputs: nfhs-*-marriage-fertility, nfhs-*-family-planning, nfhs-*-unmet-need. -->
  <section>
    <div class="sec-head"><span class="no">14</span><h2>Children per woman, and how families plan them</h2><span class="line"></span><span class="unit">NFHS-4 and NFHS-5</span></div>
    <div class="break">
      <figure id="cb-tfr-states" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>India fell below two children per woman; {tfAbove.length} states and UTs are still above replacement</h3>
            <div class="sub">Total fertility rate, by state and UT, NFHS-5 (blue) and NFHS-4 (grey). Replacement is about 2.1 children per woman.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-tfr">{f2(tfr5)}</div><div class="c">children per woman, NFHS-5</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-tfr-states"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI. Fertility from births in the three years before the survey. NFHS-4 rates are printed to one decimal.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The total fertility rate is how many children a woman would have if she lived through today's birth rates at each age. About 2.1 keeps a population the same size in the long run. Below it, the population still grows for decades, because many young women are now in their childbearing years.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>India <b id="ex-tf-india">{f2(tfr5)}</b>, from {f1(tfr4)}. Highest: {tfRows[0].geo} ({f2(tfRows[0].v)}). Lowest: {tfRows.at(-1).geo} ({f2(tfRows.at(-1).v)}). Women 20-24 married before 18: {f1(cm5)}%, from {f1(cm4)}%.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-fp" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Family planning still means a woman's operation: female sterilisation at {f1(fst5)}%, male at {f1(mst5)}%</h3>
            <div class="sub">Currently married women 15-49 using each method, and unmet need, India, NFHS-4 (grey) and NFHS-5 (blue).</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-fp">{f1(fst5)}<span class="pc">%</span></div><div class="c">rely on female sterilisation</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-fp"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-4 and NFHS-5 (IIPS, MoHFW), via MoSPI. Unmet need: married women who want no more children, or want to wait, and use nothing. MoSPI's NFHS-4 figure for total unmet need is misfiled and withheld; the Women and Men in India compendium prints 12.9% for NFHS-4.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>More than half of the couples who use any method rely on sterilising the woman, usually once they have the children they want; few space births with temporary methods. Vasectomy is a simpler operation, and almost no men have one.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Any method <b id="ex-fp-any">{f1(val(5, "family-planning", /: Any method/))}%</b>, from {f1(val(4, "family-planning", /: Any method/))}%. Unmet need {f1(val(5, "unmet-need", /^Total Unmet/))}%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 15 village and town. Inputs: every per-cent sub-indicator of every nfhs-5-* bundle, rural and urban. -->
  <section>
    <div class="sec-head"><span class="no">15</span><h2>Village and town</h2><span class="line"></span><span class="unit">NFHS-5, town minus village, percentage points</span></div>
    <div class="break">
      <figure id="cb-gap" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>The widest gap between town and village is {gapTop.short.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())}, {f1(gapTop.gap)} points; {ruralAhead.length} measures run higher in villages</h3>
            <div class="sub">Every per-cent measure in NFHS-5, India: the urban figure minus the rural one. Bars to the right are higher in towns; marigold bars are higher in villages.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-gap">{f1(gapTop.gap)}</div><div class="c">points, the widest gap</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-gap"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 (IIPS, MoHFW), via MoSPI. Rural and urban as the survey's sample defines them.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>A gap is not always a disadvantage, and it does not always favour towns. A bar to the right can be a good thing that towns have more of, such as toilets or schooling, or a bad thing, such as obesity. Read the measure before the direction.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf}</span>
            <p>Widest gap: <b id="ex-gap-top">{gapTop.short.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())}</b>, {f1(gapTop.rural)}% in villages and {f1(gapTop.urban)}% in towns. Furthest the other way: {gapBot.short.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())}, {f1(gapBot.rural)}% in villages against {f1(gapBot.urban)}% in towns.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 16 state by state. Inputs: twelve sub-indicators of the nfhs-5-* bundles, every state. -->
  <section>
    <div class="sec-head"><span class="no">16</span><h2>State by state</h2><span class="line"></span><span class="unit">Twelve measures, NFHS-5</span></div>
    <div class="break">
      <figure id="cb-table" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>No state does well on everything: the twelve measures, side by side</h3>
            <div class="sub">Twelve NFHS-5 measures for every state and UT, per cent unless named. Each column is shaded on its own range; darker is the worse end (children per woman is not shaded).</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-table">{table.rows.length}</div><div class="c">states and UTs</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-table"></div>
          <div class="plotfoot">
            <span class="src">Source: NFHS-5 state fact sheets (IIPS, MoHFW), via MoSPI. Every other measure, for every state, village and town, is in the table at the end of this guide and in the downloads.</span>
            <span class="dl"><button data-dl="csv">CSV</button><a href="https://rchiips.org/nfhs/" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Read across a row to see one state's profile, down a column to see where a problem is worst. The states that have largely left undernutrition behind tend to carry more of the diseases of plenty, high blood pressure and blood sugar; others carry both at once.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 17 how to misread: evergreen -->
  <section>
    <div class="sec-head"><span class="no">17</span><h2>How to misread this survey</h2><span class="line"></span></div>
    <ul class="misread">
      <li><span class="no">i.</span><div>
        <h3>"Women's bank accounts jumped from 3% to 79% in five years."</h3>
        <p>That figure circulates because MoSPI's copy of NFHS-4 files another line's value against bank accounts. The NFHS-5 national report puts NFHS-4 at 53 per cent. The rise was real and large, about 26 points, but it did not start from nothing. This guide withholds every NFHS-4 line it could not confirm.</p>
      </div></li>
      <li><span class="no">ii.</span><div>
        <h3>"Anaemia rose from 58% to 67%, so children's health got worse."</h3>
        <p>Anaemia did rise, in most states and every group measured twice. But stunting, wasting and child deaths fell over the same years. Anaemia is one measure, with its own causes (iron, worms, malaria, inherited blood disorders), and a finger-prick that may overstate its level in both rounds alike.</p>
      </div></li>
      <li><span class="no">iii.</span><div>
        <h3>"High blood pressure doubled between the rounds."</h3>
        <p>MoSPI's tables print NFHS-4 beside NFHS-5 for blood pressure and blood sugar, but NFHS-4 measured only ages 15 to 49 and NFHS-5 everyone over 15. Older people have far more high blood pressure, so the rise is mostly the change in who was measured. We do not compare the two.</p>
      </div></li>
      <li><span class="no">iv.</span><div>
        <h3>"Fertility is below replacement, so India's population has stopped growing."</h3>
        <p>A fertility rate below 2.1 means each generation of mothers will, in time, be smaller than the last. Today's large cohort of young women keeps the number of births high for years to come, so India's population keeps growing for decades (the Population guide carries the UN's projections), and several states are still above replacement.</p>
      </div></li>
      <li><span class="no">v.</span><div>
        <h3>"Nine in ten births are in hospitals, so maternal care is solved."</h3>
        <p>The survey records where a baby was born, not what happened there. A facility birth can still come with no antenatal care, an unneeded caesarean or no check-up afterwards, and the out-of-pocket cost in a public hospital is not zero.</p>
      </div></li>
      <li><span class="no">vi.</span><div>
        <h3>"Lakshadweep has almost no infant deaths."</h3>
        <p>The smallest union territories rest on a few dozen births and a few hundred households. Their figures swing on a handful of cases and the fact sheets mark many of them as uncertain. Read them, but do not rank on them.</p>
      </div></li>
      <li><span class="no">vii.</span><div>
        <h3>"These two rounds show a trend."</h3>
        <p>They show a change between two surveys, taken five years apart with different samples, and in some states on either side of a lockdown. NFHS-6 will be the third point.</p>
      </div></li>
    </ul>
  </section>

