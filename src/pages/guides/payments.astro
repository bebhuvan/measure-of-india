---
import { mastheadStamp } from "../../dossiers/headline.js";
// Guide 26, how Indians pay. Data: data/series/payments-*.json (RBI payment system statistics
// via the local Data Bank, scripts/lib/products/payments.mjs) and, read-only, the credit guide's
// credit-money bundle for currency with the public. The plates' series are cut here at build
// time and embedded as one JSON block (#payments-data); the client never fetches a series.
import fs from "node:fs";
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import GuideData from "../../components/GuideData.astro";
import EveryCut from "../../components/EveryCut.astro";
import { bySlug, kicker } from "../../dossiers/registry.js";
import { dateStamp } from "../../dossiers/display.js";
import { period } from "../../dossiers/periods.js";
const D = bySlug["payments"];
const B = (s) => JSON.parse(fs.readFileSync(`data/series/${s}.json`, "utf8"));
const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const fyOf = (iso) => `${+iso.slice(0, 4) - 1}-${iso.slice(2, 4)}`;   // "2026-03-01" -> "2025-26"

const PM = period("payments-monthly");
const m = B("payments-monthly"), t = B("payments-ticket"), inf = B("payments-infra"), a = B("payments-annual");
const o = B("payments-monthly-2004"), h = B("payments-cheques-1970"), c = B("payments-cheques-centres");
const ch = B("payments-clearing-houses"), e = B("payments-erupee"), cash = B("credit-money");
const pick = (b, keys) => Object.fromEntries(keys.map((k) => [k, b.series[k].data]));

/* ---- the plates' data ---- */
const LINES = ["upi", "imps", "neft", "rtgs", "cards", "credit_cards", "debit_cards", "credit_cards_pos", "credit_cards_other", "debit_cards_pos", "debit_cards_other",
  "ppi", "ppi_wallets", "ppi_cards", "paper", "nach_cr", "nach_dr", "apbs", "netc", "bhim_aadhaar_pay", "upi_ussd", "aeps_transfer", "microatm_cash", "atm_cash",
  "mobile", "internet", "retail_total", "total", "digital_total", "retail_credit", "debits", "ecs_cr", "ecs_dr"];
const P = {
  vintage: m.meta.vintage,
  m: { dates: m.dates, ...pick(m, LINES.flatMap((k) => [k + "_volume", k + "_value"])) },
  t: { dates: t.dates, ...pick(t, Object.keys(t.series)) },
  i: { dates: inf.dates, ...pick(inf, Object.keys(inf.series)) },
  a: { dates: a.dates, ...pick(a, ["upi_volume", "upi_value", "total_volume", "digital_total_volume", "retail_total_volume", "paper_volume", "cards_volume", "neft_volume", "imps_volume", "rtgs_value", "total_value"]) },
  o: { dates: o.dates, ...pick(o, ["neft_volume", "credit_cards_pos_volume", "debit_cards_pos_volume", "debit_cards_atm_volume", "cards_volume", "imps_volume", "mobile_banking_volume", "paper_volume"]) },
  h: { dates: h.dates, ...pick(h, ["all_india_number", "all_india_amount"]) },
  c: { dates: c.dates, ...pick(c, ["mumbai_number", "new_delhi_number", "chennai_number", "national_grid_number"]) },
  ch: { dates: ch.dates, ...pick(ch, ["total", "micr"]) },
  e: { dates: e.dates, ...pick(e, Object.keys(e.series)) },
  // currency with the public, every reporting fortnight since January 2016 (the credit guide's bundle)
  cash: (() => { const i0 = cash.dates.findIndex((d) => d >= "2016-01-01"); return { dates: cash.dates.slice(i0), cwp: cash.series.currency_with_public.data.slice(i0), vintage: cash.meta.vintage }; })(),
};
const lastFy = fyOf(a.dates.at(-1)), firstFy = fyOf(a.dates[0]);
const erLast = `March ${e.dates.at(-1).slice(0, 4)}`;
const chFirst = ch.dates[0].slice(0, 4), chLast = ch.dates.at(-1).slice(0, 4), gridFy = fyOf(c.dates.at(-1));
const cashLast = (() => { const d = P.cash.dates.at(-1); return `${+d.slice(8, 10)} ${MONTHS[+d.slice(5, 7) - 1]} ${d.slice(0, 4)}`; })();
---
<Base
  title="How Indians Pay · India Atlas"
  description={D.description}
  nav="guides"
  dateStamp={mastheadStamp(D)}
  crumbLeft={`<a href="/guides/">Guides</a> / ${D.section} / <b>${D.crumbTitle}</b>`}
  crumbRight={`${D.statusNote}, <b>${D.version}</b>`}
  canonical="https://atlas.thisindianlife.today/guides/payments/"
  ogImage={`/og/${D.slug}.png`}
>
<div class="page">

  <div class="titleblock break">
    <div class="kicker">{kicker(D)}</div>
    <div class="hero-grid">
      <h1 set:html={D.headline} />
      <p class="lede">Every month the Reserve Bank counts the payments that pass through India's banks and payment networks: each UPI scan, card swipe, bank transfer, cheque and ATM withdrawal, and the money each one moved. Those counts describe how a country buys tea, pays rent, receives a pension and settles a business deal.</p>
    </div>
    <div class="meta">
      <span>Source <b>Reserve Bank of India, Payment System Indicators</b></span>
      <span>Frequency <b>Monthly; some tables yearly</b></span>
      <span>Window <b>Monthly since April 2004; cheques since 1970-71</b></span>
      <span>Latest <b>{PM.long}</b></span>
      <span>Unit <b>Number of payments; rupees</b></span>
    </div>
    <div class="numbers">
      <div class="num"><div class="l">UPI payments, {PM.long}</div><div class="v acc" id="n-upi">–</div><div class="d" id="d-upi">–</div><div class="nspark" id="nspark-upi"></div></div>
      <div class="num"><div class="l">Money moved by UPI, {PM.long}</div><div class="v" id="n-upiv">–</div><div class="d" id="d-upiv">–</div></div>
      <div class="num"><div class="l">The average UPI payment</div><div class="v" id="n-avg">–</div><div class="d" id="d-avg">–</div></div>
      <div class="num"><div class="l">Cash withdrawals at ATMs</div><div class="v" id="n-atm">–</div><div class="d" id="d-atm">–</div></div>
    </div>
  </div>

  <!-- § 01 current reading. Inputs: payments-monthly (upi, imps, neft, rtgs, cards, ppi, paper, atm_cash, retail_total), proseInputs payments-ticket, payments-infra. Prose: generated slots. -->
  <section>
    <div class="sec-head"><span class="no">01</span><h2>The current reading</h2><span class="line"></span><span class="unit">{PM.long}, RBI payment system indicators</span></div>
    <div class="reading-top">
      <div><span class="rk">UPI payments in {PM.month}</span><div class="big" id="rb-upi">–</div></div>
      <p class="rt-cap">Payments made over the Unified Payments Interface in {PM.long}: scans of a QR code at a shop, transfers to a friend's phone number, bills paid from an app. Each one is counted once, whatever its size.</p>
      <div class="rt-side"><span class="rk">Of all retail payments</span><div class="rt-side-v" id="rb-share">–</div></div>
    </div>
    <div class="reading-cols">
      <div class="reading-col">
        <span class="mk">What the figures say</span>
        <Prose slot="payments.current-reading.what-the-print-says" />
      </div>
      <div class="reading-col now">
        <span class="mk">What they do not say</span>
        <Prose slot="payments.current-reading.what-it-does-not-say" />
      </div>
    </div>
  </section>

  <!-- § 02 lived reality. Inputs: payments-ticket (every line), payments-monthly (volumes). Prose: evergreen; governed As-of notes. -->
  <section>
    <div class="sec-head"><span class="no">02</span><h2>What one payment is worth</h2><span class="line"></span><span class="unit">Average value of one transaction, {PM.long}</span></div>
    <div class="prose">
      <p>Each payment system has a job, and the size of a typical payment shows what it is. UPI carries the small, everyday spending: vegetables, an auto fare, a mobile recharge, money sent home. A FASTag toll is smaller still. Cards are used for bigger shopping and online orders. NEFT moves rent, fees and supplier bills. NACH is the machinery behind salaries, pensions, dividends, loan instalments and mutual fund SIPs, collected or paid in bulk on a fixed date. RTGS, open only to large amounts, is where companies and banks settle with each other.</p>
      <p>Aadhaar-based payments are the welfare state's plumbing. APBS carries government benefits into the bank accounts linked to a person's Aadhaar number, and AePS lets someone draw that money from a banking correspondent in the village, with a thumbprint, where there is no ATM.</p>
    </div>
    <div class="break">
      <figure id="cb-ticket" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3 id="h-ticket">UPI carries small payments; RTGS carries very large ones</h3>
            <div class="sub">Average value of one transaction, by payment system, {PM.long}. Value divided by the number of transactions; the scale is logarithmic, each step ten times the last.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-ticket">–</div><div class="c">the average UPI payment</div></div>
        </div>
        <div class="frame">
          <div class="plotzone"><div id="plot-ticket" style="position:relative"></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (Bulletin Table 45, DBIE report 612). Averages derived by India Atlas: the value of each line divided by its number of transactions in the same month.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Each dot is one payment system. The further right, the larger an average payment. The scale jumps by ten at each gridline, because the systems differ by that much: an RTGS transfer is thousands of times a UPI payment.</p>
            <p>An average is pulled up by a few very large payments, so it can sit well above what an ordinary payment looks like. The RBI does not publish the typical (median) payment, so we do not know it.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>An average UPI payment was <b id="ex-tk-upi">–</b>, a debit card payment <b id="ex-tk-dc">–</b>, a credit card payment <b id="ex-tk-cc">–</b>, a cash withdrawal at an ATM <b id="ex-tk-atm">–</b>, a FASTag toll <b id="ex-tk-netc">–</b>, a NEFT transfer <b id="ex-tk-neft">–</b>, a cheque <b id="ex-tk-chq">–</b> and an RTGS transfer <b id="ex-tk-rtgs">–</b>.</p>
          </div>
        </div>
      </figure>
    </div>
    <div class="break">
      <figure id="cb-upi-ticket" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>As UPI spread, the average payment got smaller</h3>
            <div class="sub">Average value of one UPI payment, rupees, monthly, {PM.firstLong} to {PM.long}.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-upi-ticket">–</div><div class="c">{PM.long}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone"><div id="plot-upi-ticket" style="position:relative"><div class="cb-tip"></div></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (DBIE report 612). UPI value divided by the number of UPI transactions, India Atlas.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>A falling average does not mean people spend less. It means UPI took over smaller and smaller payments, the ones once made in coins and small notes, so each added payment pulls the average down. A rising number of payments with a falling average is what a habit spreading looks like.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>The average was <b id="ex-ut-now">–</b> in {PM.month}, against <b id="ex-ut-first">–</b> in {PM.firstLong} and a high of <b id="ex-ut-max">–</b> in <span id="ex-ut-maxm">–</span>.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 03 how to read this: evergreen, human-written -->
  <section>
    <div class="sec-head"><span class="no">03</span><h2>How to read the RBI's payment tables</h2><span class="line"></span></div>
    <div class="prose">
      <p><b>Two numbers for every system.</b> Volume is the number of transactions; value is the rupees they moved. They tell different stories. UPI carries most of India's payments by number and a small part of the money. RTGS is the opposite: a few lakh transfers a month that move most of the money in the economy, because companies, banks and the government settle there.</p>
      <p><b>Who reports.</b> The National Payments Corporation of India runs UPI, IMPS, NACH, AePS, APBS, NETC and the cheque clearing system; the RBI runs RTGS and NEFT; banks and card networks report card payments; prepaid instrument issuers report wallets. The RBI gathers all of it into one monthly table, printed in its Bulletin about six weeks after the month ends. Recent months can be revised in later Bulletins.</p>
      <p><b>The table changed in November 2019.</b> The RBI re-organised it into settlement systems, payment systems, channels, cash withdrawals and infrastructure. Some lines were redefined on the way: card figures stopped counting cash drawn at ATMs, which became a line of its own, and UPI, AePS and APBS each got their own line. So the table before November 2019 and the table after are two different rulers. This guide draws them side by side and never joins them into one line. The RBI's Handbook restates the new classification back to 2015-16 for whole years, and this guide uses that too.</p>
      <p><b>What is not here.</b> Cash payments between people are not counted anywhere: the closest measures are cash withdrawals at ATMs and the currency the public holds, both shown below. Payments inside a bank's own systems that never reach a network are left out. The RBI's table has no state or district detail, and NPCI's figures by app and by bank are not part of it. Nor is there a comparison with other countries here yet: the official source for that, the payment statistics of the Bank for International Settlements' payments committee, is not yet in the data this site reads, so we do not show it.</p>
    </div>
  </section>

  <!-- § 04 the scale of it. Inputs: payments-monthly (upi, retail_total, every line's volume and value share; rtgs, neft, imps, paper values). Prose: evergreen + governed As-of. -->
  <section>
    <div class="sec-head"><span class="no">04</span><h2>UPI and everything else</h2><span class="line"></span><span class="unit">Monthly, crore transactions and ₹ lakh crore</span></div>
    <div class="break">
      <figure id="cb-upi" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>UPI now carries more payments than every other system put together, many times over</h3>
            <div class="sub">Number of payments a month, crore: UPI, and all other retail payment systems combined (cards, wallets, IMPS, NEFT, NACH, Aadhaar payments, cheques), {PM.firstLong} to {PM.long}.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-upi">–</div><div class="c">UPI payments, {PM.long}</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="background:#2E4BD8"></i>UPI</button>
            <button class="chip"><i style="background:#A3A9B4"></i>All other retail systems</button>
          </div>
          <div class="plotzone"><div id="plot-upi" style="position:relative"><div class="cb-tip"></div></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (DBIE report 612). "All other retail systems" is total retail payments less UPI, India Atlas.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Two lines: UPI in blue, and every other retail system added together in grey. The grey line has grown too, but UPI's has grown so much faster that the rest looks flat beside it. A crore is ten million, so 100 crore payments a month is a billion.</p>
            <p>This is a count of payments, not of people. One shopkeeper receiving a hundred payments a day adds a hundred; we do not know from this table how many Indians use UPI.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>UPI carried <b id="ex-upi-n">–</b> payments in {PM.month} worth <b id="ex-upi-v">–</b>, against <b id="ex-upi-n0">–</b> in {PM.firstLong}. All other retail systems together carried <b id="ex-upi-rest">–</b>. UPI's number of payments was <b id="ex-upi-g">–</b> on a year earlier.</p>
          </div>
        </div>
      </figure>
    </div>
    <div class="break">
      <figure id="cb-share" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>UPI carries most of the payments; RTGS carries most of the money</h3>
            <div class="sub">Each system's share of the number of payments, and of their value, {PM.long}, per cent. Retail systems and RTGS; CCIL's securities and foreign exchange settlement left out.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-share">–</div><div class="c">RTGS's share of the money</div></div>
        </div>
        <div class="frame">
          <div class="plotzone"><div id="plot-share" class="sm-grid two" role="img" aria-label="Shares of the number and value of payments by system"></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (DBIE report 612). Shares of total payments (RTGS and retail), India Atlas. "Bulk and Aadhaar" is NACH credit and debit, APBS, AePS, BHIM Aadhaar Pay, ECS and NETC.</span>
            <span class="dl"><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The left panel counts payments, the right panel counts rupees. The same systems sit in the same order in both, so read across: a long bar on the left and a short one on the right is a system of many small payments; the reverse is a system of few large ones.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>UPI was <b id="ex-sh-upi-n">–</b> of all payments by number and <b id="ex-sh-upi-v">–</b> by value. RTGS was <b id="ex-sh-rtgs-n">–</b> by number and <b id="ex-sh-rtgs-v">–</b> by value. NEFT was <b id="ex-sh-neft-v">–</b> of the money.</p>
          </div>
        </div>
      </figure>
    </div>
    <div class="break">
      <figure id="cb-value" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Where the money moves: RTGS, then NEFT, then UPI</h3>
            <div class="sub">Value of payments a month, ₹ lakh crore, {PM.firstLong} to {PM.long}.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-value">–</div><div class="c">moved by RTGS, {PM.long}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone"><div id="plot-value" style="position:relative"><div class="cb-tip"></div></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (DBIE report 612). Cheques: the Cheque Truncation System and other paper instruments.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Each line is the rupees a system moved in a month. RTGS sits far above the rest because it carries the settlements of companies, banks and governments; a single transfer can be crores. March towers each year: it is when the financial year closes, taxes fall due and accounts are squared.</p>
            <p>These sums dwarf India's GDP because the same rupee is counted every time it changes hands, and much of it is money moving between financial institutions. They measure how busy the plumbing is, not the size of the economy.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>In {PM.month}, RTGS moved <b id="ex-v-rtgs">–</b>, NEFT <b id="ex-v-neft">–</b>, UPI <b id="ex-v-upi">–</b>, IMPS <b id="ex-v-imps">–</b> and cheques <b id="ex-v-chq">–</b>.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 05 anatomy: cards, cash, machines. Inputs: payments-monthly (credit_cards, debit_cards and their PoS/other lines, atm_cash), payments-infra (every line), credit-money (currency_with_public, read-only). Prose: evergreen + governed As-of. -->
  <section>
    <div class="sec-head"><span class="no">05</span><h2>Cards, cash and the machines</h2><span class="line"></span><span class="unit">Monthly</span></div>
    <div class="break">
      <figure id="cb-cards" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Credit cards overtook debit cards, as debit card payments shrank</h3>
            <div class="sub">Card payments a month, crore, by kind of card, {PM.firstLong} to {PM.long}. Payments at shops' card machines (PoS) and elsewhere, mostly online; cash withdrawals not included.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-cards">–</div><div class="c">credit card payments, {PM.long}</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="background:#2E4BD8"></i>Credit cards</button>
            <button class="chip"><i style="background:#A3A9B4"></i>Debit cards</button>
          </div>
          <div class="plotzone"><div id="plot-cards" style="position:relative"><div class="cb-tip"></div></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (DBIE report 612), lines 4.1 and 4.2. Cards in issue: the infrastructure lines of the same table.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Most Indians with a bank account have a debit card; far fewer have a credit card. Yet credit cards now carry more payments. The debit card's everyday work, paying a shop from your own account, went to UPI, which does the same thing from a phone. Credit cards kept what UPI did not offer at first: credit, reward points and online shopping.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>Credit cards carried <b id="ex-cd-cc">–</b> payments in {PM.month} and debit cards <b id="ex-cd-dc">–</b>, against <b id="ex-cd-cc0">–</b> and <b id="ex-cd-dc0">–</b> in {PM.firstLong}. Banks had issued <b id="ex-cd-ncc">–</b> credit cards and <b id="ex-cd-ndc">–</b> debit cards.</p>
          </div>
        </div>
      </figure>
    </div>
    <div class="break">
      <figure id="cb-cash" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Fewer trips to the ATM, but more cash in people's hands</h3>
            <div class="sub">Left: cash withdrawals at ATMs, number a month, crore, {PM.firstLong} to {PM.long}. Right: currency with the public, ₹ lakh crore, every reporting fortnight from January 2016 to {cashLast}.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-cash">–</div><div class="c">currency with the public</div></div>
        </div>
        <div class="frame">
          <div class="plotzone"><div id="plot-cash" class="sm-grid two" role="img" aria-label="ATM cash withdrawals a month and currency with the public"></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI. ATM withdrawals: Payment System Indicators (DBIE report 612), line 3. Currency with the public: RBI money supply statistics, the same series the credit guide draws.</span>
            <span class="dl"><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The left panel counts trips to the ATM; the right panel is all the notes and coins held outside banks. If digital payments had replaced cash, both would fall. Only the first has. People draw cash less often but in larger amounts, and the stock of cash has kept growing with the economy. The deep dip in the right panel is November 2016, when old ₹500 and ₹1,000 notes were withdrawn.</p>
            <p>Cash held is not cash spent: much of it is savings kept at home, or money held for weddings, farming and travel. We do not know how many payments are still made in cash.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>Indians drew cash from ATMs <b id="ex-cs-n">–</b> times in {PM.month}, against <b id="ex-cs-n0">–</b> in {PM.firstLong}, taking out <b id="ex-cs-v">–</b>. Currency with the public was <b id="ex-cs-cwp">–</b> on {cashLast}, against <b id="ex-cs-cwp0">–</b> in November 2019.</p>
          </div>
        </div>
      </figure>
    </div>
    <div class="break">
      <figure id="cb-machines" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3 id="h-machines">Many more QR codes than card machines, and far more card machines than ATMs</h3>
            <div class="sub">The payment infrastructure at the end of each month, {PM.firstLong} to {PM.long}. Each panel has its own scale.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-machines">–</div><div class="c">UPI QR codes, {PM.long}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone"><div id="plot-machines" class="sm-grid" role="img" aria-label="Eight small line charts of payment infrastructure"></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (DBIE report 612), infrastructure lines. UPI QR codes reported from September 2020.</span>
            <span class="dl"><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>A QR code costs a shopkeeper nothing but a printed sticker; a card machine has to be bought or rented. That difference is much of why UPI spread to vegetable carts and tea stalls that never took cards. White-label ATMs are run by companies that are not banks. Micro ATMs are the handheld devices of banking correspondents, the agents who bring banking to villages.</p>
            <p>These are counts of things in place, not of things in use. A QR code printed once and never scanned is still counted.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>There were <b id="ex-mc-qr">–</b> UPI QR codes, <b id="ex-mc-pos">–</b> card machines, <b id="ex-mc-atm">–</b> ATMs (<b id="ex-mc-wl">–</b> of them white-label) and <b id="ex-mc-micro">–</b> micro ATMs. Card machines were <b id="ex-mc-posg">–</b> on a year earlier.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 06 granular: every system. Inputs: payments-monthly (imps, neft, rtgs, nach_cr, nach_dr, apbs, microatm_cash, ppi_wallets, ppi_cards, netc, bhim_aadhaar_pay, upi_ussd, mobile, internet). Prose: evergreen + governed As-of. -->
  <section>
    <div class="sec-head"><span class="no">06</span><h2>Every other way money moves</h2><span class="line"></span><span class="unit">Monthly, number of payments</span></div>
    <div class="break">
      <figure id="cb-systems" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Twelve payment systems, each on its own scale</h3>
            <div class="sub">Number of payments a month, {PM.firstLong} to {PM.long}. Each panel has its own scale; the figure in the corner is the latest month.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-systems">–</div><div class="c">NACH debits (EMIs, SIPs), {PM.long}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone"><div id="plot-systems" class="sm-grid" role="img" aria-label="Twelve small line charts, one per payment system"></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (DBIE report 612).</span>
            <span class="dl"><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>IMPS was the instant transfer before UPI, and much of its work has moved to UPI. NACH debits are payments you agreed to once and that then repeat: loan instalments, insurance premiums, SIPs, utility bills. NACH credits and APBS go the other way, from employers and governments to people. AePS cash withdrawals are rural India taking benefit money out at a banking correspondent. UPI over USSD works on a basic phone with no internet, and is used very little.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>In {PM.month}: NACH debits <b id="ex-sy-nachdr">–</b>, APBS benefit credits <b id="ex-sy-apbs">–</b>, AePS cash withdrawals <b id="ex-sy-aeps">–</b>, IMPS <b id="ex-sy-imps">–</b>, NEFT <b id="ex-sy-neft">–</b>, wallets <b id="ex-sy-wallets">–</b> and FASTag tolls <b id="ex-sy-netc">–</b>. IMPS was <b id="ex-sy-impsg">–</b> on a year earlier.</p>
          </div>
        </div>
      </figure>
    </div>
    <div class="break">
      <figure id="cb-channels" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Phones carry the payments; net banking still carries more of the money</h3>
            <div class="sub">Value of payments a month, ₹ lakh crore, by channel: mobile apps and internet banking (browser), {PM.firstLong} to {PM.long}.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-channels">–</div><div class="c">mobile payments, {PM.long}</div></div>
        </div>
        <div class="frame">
          <div class="legend">
            <button class="chip"><i style="background:#2E4BD8"></i>Mobile</button>
            <button class="chip"><i style="background:#A3A9B4"></i>Internet banking</button>
          </div>
          <div class="plotzone"><div id="plot-channels" style="position:relative"><div class="cb-tip"></div></div></div>
          <div class="plotfoot">
            <span class="src">Source: RBI, Payment System Indicators (DBIE report 612), "other payment channels". The channel lines count payments by how they were started; they overlap with the system lines above.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://data.rbi.org.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The channel is the screen a payment starts on, not the system that carries it: a UPI payment from an app is a mobile payment, and so is a NEFT transfer made in a bank's app. Businesses still move large sums through net banking on a computer, which is why internet banking carries few payments but a great deal of money.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PM.long}</span>
            <p>Mobile payments moved <b id="ex-ch-mv">–</b> in <b id="ex-ch-mn">–</b> transactions; internet banking moved <b id="ex-ch-iv">–</b> in <b id="ex-ch-in">–</b>.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 07 the long view. Inputs: payments-annual (upi, digital_total, total, paper), payments-monthly-2004 (neft, credit/debit cards at PoS), payments-monthly (neft, credit/debit cards at PoS), payments-cheques-1970 (all India), payments-cheques-centres (Mumbai, New Delhi, Chennai, national grid), payments-clearing-houses (total, MICR). Prose: evergreen + governed As-of. -->
