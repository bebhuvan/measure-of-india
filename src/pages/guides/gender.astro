---
import { mastheadStamp } from "../../dossiers/headline.js";
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import GuideData from "../../components/GuideData.astro";
import EveryCut from "../../components/EveryCut.astro";
import { bySlug, kicker } from "../../dossiers/registry.js";
import { dateStamp } from "../../dossiers/display.js";
import { load, points, last, first, value, states, share, r1 } from "../../dossiers/gender.data.js";
import { GENDER as CH } from "../../dossiers/health-gender.charts.js";
const D = bySlug["gender"];

// ---- the figures the copy names, read from the bundles at build time ----
const f1 = (v) => (v == null ? "–" : v.toFixed(1));
const f0 = (v) => (v == null ? "–" : Math.round(v).toLocaleString("en-IN"));
const pts = (slug, key) => points(slug, key).map((p) => ({ iso: p.iso, period: p.period, value: p.value }));
const nTables = new Set(D.bundles.map((b) => b.replace(/-[a-z0-9]+$/, "").replace(/^(gender-t\d{3}).*/, "$1"))).size;
const compendium = load("gender-t007").meta;

// § 03 the count: sex ratio at birth (SRS), the census sex ratio
const srb = pts("gender-t007", "total__all_india"), srbR = pts("gender-t007", "rural__all_india"), srbU = pts("gender-t007", "urban__all_india");
const srbNow = srb.at(-1), srbThen = srb[0];
const srbS = states("gender-t007", "total__");
const sr = pts("gender-t002", "all_india");
const srLow = sr.reduce((a, p) => (p.value < a.value ? p : a));
const crs = states("gender-t006", "");

// § 04 survival
const imrF = pts("gender-t015", "female__all_india"), imrM = pts("gender-t015", "male__all_india");
const imrCross = imrF.find((p, i) => p.value <= imrM[i].value);
const mmr = pts("gender-t021", "all_india"), mmrS = states("gender-t021", "");
const le = load("gender-t018");
const leF = pts("gender-t018", "female__all_india"), leM = pts("gender-t018", "male__all_india");
const leEst = new Set(le.series.female__all_india.estimated ?? []);
const leLastMeasured = leF.filter((p) => !leEst.has(p.iso)).at(-1), leLastMeasuredM = leM.filter((p) => !leEst.has(p.iso)).at(-1);
const u5F = value("gender-t017", "female__all_india"), u5M = value("gender-t017", "male__all_india");

// § 05 fertility and marriage
const EDU = [["illiterate", "Never went to school"], ["literate_below_primary", "Below primary"], ["literate_primary", "Primary"], ["literate_middle", "Middle school"],
  ["literate_class_x", "Class 10"], ["literate_class_xii", "Class 12"], ["literate_graduate_and_above", "Graduate and above"]];
const tfrEdu = EDU.map(([k, label]) => ({ label, v: value("gender-t010", `total__${k}__all_india`) }));
const tfrAll = value("gender-t010", "total__total_literate__all_india");
const marS = states("gender-t014", "total__"), mar = value("gender-t014", "total__all_india");
const adol = value("gender-t012", "total__all_india"), adolS = states("gender-t012", "total__");

// § 06 school and college
const LEVELS = [["primary_i_v", "Primary (classes 1-5)"], ["upper_primary_vi_viii", "Upper primary (6-8)"], ["secondary_ix_x", "Secondary (9-10)"], ["higher_secondary_xi_xii", "Higher secondary (11-12)"], ["higher_education_graduation_and_above", "College and university"]];
const ger = LEVELS.map(([k, label]) => ({ label, a: value("gender-t060", `male__${k}__all_india`), b: value("gender-t060", `female__${k}__all_india`) }));
const gerPeriod = last("gender-t060", "female__primary_i_v__all_india").period;
const DROP = [["primary_i_v", "Primary"], ["upper_primary_vi_viii", "Upper primary"], ["secondary_ix_x", "Secondary"]];
const drop = DROP.map(([k, label]) => ({ label: `Dropout, ${label.toLowerCase()}`, a: value("gender-t074", `male__${k}__all_india`), b: value("gender-t074", `female__${k}__all_india`) }));
const dropPeriod = last("gender-t074", "female__secondary_ix_x__all_india").period;
const litF = pts("gender-t055-census", "total__female__all_india"), litM = pts("gender-t055-census", "total__male__all_india");
const litNssF = pts("gender-t055-nss", "total__female__all_india"), litNssM = pts("gender-t055-nss", "total__male__all_india");
const ysF = states("gender-t070", "total__female__"), ysM = new Map(states("gender-t070", "total__male__").map((r) => [r.geo, r.v]));
const ysRows = ysF.map((r) => ({ geo: r.geo, women: r.v, men: ysM.get(r.geo) ?? null }));
const ysWomen = value("gender-t070", "total__female__all_india"), ysMen = value("gender-t070", "total__male__all_india");
const ysAhead = ysRows.filter((r) => r.men != null && r.women > r.men);

// § 07 work and pay: PLFS, three rulers
const wpr = (r, sex) => pts(`gender-t085-${r}`, `total__${sex}__all_india`);
const wprAyF = wpr("ay", "female"), wprCyF = wpr("cy", "female"), wpr25F = wpr("cy25", "female");
const wprAyM = wpr("ay", "male"), wprCyM = wpr("cy", "male"), wpr25M = wpr("cy25", "male");
const lfF = states("gender-t082-cy25", "total__female__"), lfM = new Map(states("gender-t082-cy25", "total__male__").map((r) => [r.geo, r.v]));
const lfRows = lfF.map((r) => ({ geo: r.geo, women: r.v, men: lfM.get(r.geo) ?? null }));
const lfW = value("gender-t082-cy25", "total__female__all_india"), lfMen = value("gender-t082-cy25", "total__male__all_india");
const wgF = states("gender-t087-cy25", "rural__female__"), wgM = new Map(states("gender-t087-cy25", "rural__male__").map((r) => [r.geo, r.v]));
// the table prints 0 where the survey has no estimate (no women in rural casual work sampled): not a wage
const wageRows = wgF.filter((r) => r.v > 0).map((r) => ({ geo: r.geo, women: r.v, men: wgM.get(r.geo) || null }));
const wageNone = wgF.filter((r) => !(r.v > 0)).map((r) => r.geo);
const wF = value("gender-t087-cy25", "rural__female__all_india"), wM = value("gender-t087-cy25", "rural__male__all_india");
const informalF = value("gender-t092-cy25", "total__female__all_india"), informalM = value("gender-t092-cy25", "total__male__all_india");

// § 08 time: Time Use Survey 2019 and 2024, minutes a day per person (two rounds, side by side)
const T19 = (sex, k) => value("gender-t103", `${sex}__${k}__all_india`);
const T24 = (sex, k) => value("gender-t104", `average_time_in_minutes_spent_in_a_day_per_person__${sex}__${k}__all_india`);
const time = [
  { label: "Women: unpaid work at home", a: T19("female", "unpaid_activity_non_sna") + T19("female", "unpaid_activity_sna"), b: T24("female", "unpaid_activity") },
  { label: "Men: unpaid work at home", a: T19("male", "unpaid_activity_non_sna") + T19("male", "unpaid_activity_sna"), b: T24("male", "unpaid_activity") },
  { label: "Women: paid work", a: T19("female", "paid_activity"), b: T24("female", "paid_activity") },
  { label: "Men: paid work", a: T19("male", "paid_activity"), b: T24("male", "paid_activity") },
];
const careF = value("gender-t098", "average_time_in_minutes_spent_in_a_day_per_participant__female__unpaid_domestic_services_for_household_members__all_india");
const careM = value("gender-t098", "average_time_in_minutes_spent_in_a_day_per_participant__male__unpaid_domestic_services_for_household_members__all_india");

// § 09 money: women's share of each scheme or account (derived: the women's count over the total)
const sh = (slug, f, t) => share(value(slug, f), value(slug, t));
const money = [
  { label: "Jan Dhan accounts (PMJDY)", v: sh("gender-t111", "female__all_india", "total__all_india"), period: last("gender-t111", "total__all_india").period },
  { label: "Stand-Up India loans", v: sh("gender-t114", "female__account_sanctioned__all_india", "total__account_sanctioned__all_india"), period: last("gender-t114", "total__account_sanctioned__all_india").period },
  { label: "Life cover (PMJJBY)", v: sh("gender-t109", "female__pmjjby__all_india", "total__pmjjby__all_india"), period: last("gender-t109", "total__pmjjby__all_india").period },
  { label: "Accident cover (PMSBY)", v: sh("gender-t109", "female__pmsby__all_india", "total__pmsby__all_india"), period: last("gender-t109", "total__pmsby__all_india").period },
  { label: "Atal Pension Yojana", v: sh("gender-t113", "female__all_india", "total__all_india"), period: last("gender-t113", "total__all_india").period },
  { label: "Individuals' bank deposit accounts", v: sh("gender-t108", "females_out_of_individuals__no_of_accounts_in_thousand__all_india", "individuals__no_of_accounts_in_thousand__all_india"), period: last("gender-t108", "individuals__no_of_accounts_in_thousand__all_india").period },
  { label: "Individuals' bank deposits, by value", v: sh("gender-t108", "females_out_of_individuals__amount_in_crore__all_india", "individuals__amount_in_crore__all_india"), period: last("gender-t108", "individuals__amount_in_crore__all_india").period },
  { label: "Demat accounts (CDSL)", v: sh("gender-t115", "female__all_india", "total__all_india"), period: last("gender-t115", "total__all_india").period },
  { label: "Individual investors (NSE)", v: value("gender-t118", "female__all_india"), period: last("gender-t118", "female__all_india").period },
].sort((a, b) => b.v - a.v);
const demat = pts("gender-t115", "female__all_india"), dematT = pts("gender-t115", "total__all_india");
const dematShare0 = share(demat[0].value, dematT[0].value), dematShare1 = share(demat.at(-1).value, dematT.at(-1).value);

// § 10 voice: women's share of Lok Sabha seats since 1957 (derived: women elected over seats)
const lsW = pts("gender-t124", "elected_female__all_india__count"), lsSeats = new Map(pts("gender-t124", "number_of_seats_available_for_election__all_india").map((p) => [p.iso, p.value]));
const lsShare = lsW.filter((p) => lsSeats.has(p.iso)).map((p) => ({ iso: p.iso, period: p.period, value: share(p.value, lsSeats.get(p.iso)) }));
const lsNow = lsShare.at(-1), lsFirst = lsShare[0];
const lsCand = pts("gender-t124", "total_number_contesting_female__all_india");
const voice = [
  { label: "Panchayat members", v: value("gender-t127", "percentage_of_women_elected_representatives__all_india") },
  { label: "Lok Sabha members, 2024", v: value("gender-t125", "women__all_india") },
  { label: "High Court and Supreme Court judges", v: value("gender-t130", "female__total__percent") },
  { label: "Police (civil, armed and reserve)", v: value("gender-t172", "percentage_of_women_police_civil_district_armed_reserve__all_india") },
  { label: "Union Council of Ministers", v: value("gender-t123", "women_in_central_council_of_ministers__all_india") },
  { label: "State legislative assembly members", v: share(value("gender-t126-total", "female__all_india"), value("gender-t126-total", "total__all_india")) },
  { label: "Company boards of directors", v: share(value("gender-t131", "board_of_directors__female__all_india"), value("gender-t131", "board_of_directors__female__all_india") + value("gender-t131", "board_of_directors__male__all_india") + value("gender-t131", "board_of_directors__transgender__all_india")) },
  { label: "Senior management in companies", v: share(value("gender-t131", "senior_management_positions__female__all_india"), value("gender-t131", "senior_management_positions__female__all_india") + value("gender-t131", "senior_management_positions__male__all_india") + value("gender-t131", "senior_management_positions__transgender__all_india")) },
].sort((a, b) => b.v - a.v);

// § 11 safety
const crimeK = "rates_of_crimes__total_crimes_against_women__";
const crimeS = states("gender-t141", crimeK), crimeAI = value("gender-t141", crimeK + "all_india");
const crimeYear = last("gender-t141", crimeK + "all_india").period;
const HEADS = [["cruelty_by_husband_and_relatives_sec_498_a_ipc", "Cruelty by husband or relatives"], ["kidnapping_abduction_sec_363_to_373_ipc", "Kidnapping and abduction"],
  ["assault_on_women_with_intent_to_outrage_her_modesty_sec_354_ipc", "Assault on modesty"], ["rape_sec_376_ipc", "Rape"], ["dowry_prohibition_act_1961", "Dowry Prohibition Act"],
  ["insult_to_the_modesty_of_women_sec_509_ipc", "Insult to modesty"]];
const ck = (h) => Object.keys(load("gender-t140").series).find((k) => k.startsWith("no_of_cases__" + h.slice(0, 40)));
const heads = HEADS.map(([h, label]) => { const k = ck(h); const p = pts("gender-t140", k); return { label, a: p[0].value, b: p.at(-1).value, from: p[0].period, to: p.at(-1).period }; });
const allCases = pts("gender-t140", ck("total_crime_against_women"));
const convK = (h) => Object.keys(load("gender-t145").series).find((k) => k.startsWith("percentage_of_cases_convicted") && k.includes(h));
const CONV = [["__rape__", "Rape"], ["dowry_deaths", "Dowry deaths"], ["cruelty_by_husband", "Cruelty by husband or relatives"], ["kidnapping_abduction_of_women", "Kidnapping and abduction"],
  ["assault_on_women_with_intent", "Assault on modesty"], ["insult_to_the_modesty", "Insult to modesty"], ["dowry_prohibition_act", "Dowry Prohibition Act"], ["total_crimes_against_women", "All crimes against women"]];
const conv = CONV.map(([h, label]) => ({ label, v: value("gender-t145", convK(h)) })).sort((a, b) => b.v - a.v);
const convAll = conv.find((c) => c.label === "All crimes against women").v;
const sv4 = value("gender-t143-nfhs4", "physical_or_sexual__all_india"), sv5 = value("gender-t143-nfhs5", "physical_or_sexual__all_india");

// § 12 health, briefly: causes of death by sex (SRS)
const CAUSE = [["non_communicable_diseases", "Non-communicable diseases"], ["communicable_maternal_perinatal_and_nutritional_conditions", "Communicable, maternal, newborn and nutritional"], ["injuries", "Injuries"], ["symptoms_signs_and_ill_defined_conditions", "Ill-defined causes"]];
const cdk = (c, sex) => Object.keys(load("gender-t160").series).find((k) => k.startsWith(c.slice(0, 50)) && k.includes("__percentage__" + sex + "__all_india"));
const causes = CAUSE.map(([c, label]) => ({ label, a: value("gender-t160", cdk(c, "male")), b: value("gender-t160", cdk(c, "female")) }));
const causePeriod = last("gender-t160", cdk("injuries", "female")).period;

const iso = (p) => p.map((x) => ({ iso: x.iso, value: x.value }));
const DATA = {
  srb: { series: [{ label: "India", color: "#2E4BD8", points: iso(srb) }, { label: "Towns", color: "#5F6675", points: iso(srbU), width: 1.5 }, { label: "Villages", color: "#A3A9B4", points: iso(srbR), width: 1.5 }], periods: Object.fromEntries(srb.map((p) => [p.iso, p.period])) },
  "srb-states": { rows: srbS.map((r) => ({ geo: r.geo, v: r.v })), ref: srbNow.value, fmt: "0" },
  census: { series: [{ label: "Women per 1,000 men", color: "#2E4BD8", points: iso(sr) }] },
  imr: { series: [{ label: "Girls", color: "#2E4BD8", points: iso(imrF) }, { label: "Boys", color: "#5F6675", points: iso(imrM), width: 1.5 }] },
  mmr: { series: [{ label: "India", color: "#2E4BD8", points: iso(mmr) }], periods: Object.fromEntries(mmr.map((p) => [p.iso, p.period])) },
  "mmr-states": { rows: mmrS.map((r) => ({ geo: r.geo, v: r.v })), ref: mmr.at(-1).value, fmt: "0" },
  life: { series: [{ label: "Women", color: "#2E4BD8", points: iso(leF), est: [...leEst] }, { label: "Men", color: "#5F6675", points: iso(leM), est: [...leEst], width: 1.5 }], periods: Object.fromEntries(leF.map((p) => [p.iso, p.period])) },
  "tfr-edu": { rows: tfrEdu, ref: tfrAll },
  "marriage-states": { rows: marS.map((r) => ({ geo: r.geo, v: r.v })), ref: mar },
  school: [...ger, ...drop],
  literacy: { census: [{ label: "Women", color: "#2E4BD8", points: iso(litF) }, { label: "Men", color: "#5F6675", points: iso(litM) }], nss: [{ label: "Women, NSS", color: "#2E4BD8", points: iso(litNssF) }, { label: "Men, NSS", color: "#5F6675", points: iso(litNssM) }] },
  "schooling-states": { rows: ysRows, ref: ysWomen, refLabel: "India, women" },
  work: { rulers: [[wprAyF, wprCyF, wpr25F], [wprAyM, wprCyM, wpr25M]].map((g, gi) => g.map((p) => ({ label: gi ? "Men" : "Women", color: gi ? "#5F6675" : "#2E4BD8", points: iso(p) }))) },
  "lfpr-states": { rows: lfRows, ref: lfW, refLabel: "India, women" },
  "wage-states": { rows: wageRows, ref: wF, refLabel: "India, women", fmt: "0" },
  time,
  money: money.map((m) => ({ label: m.label, v: m.v })),
  "lok-sabha": { series: [{ label: "Women's share of seats", color: "#2E4BD8", points: iso(lsShare) }] },
  voice,
  "crime-states": { rows: crimeS.map((r) => ({ geo: r.geo, v: r.v })), ref: crimeAI },
  "crime-heads": heads.map((h) => ({ label: h.label, a: h.a, b: h.b })),
  conviction: conv,
  causes,
};
const asOf = (slug) => { const b = load(slug); return b.meta.periodLabels?.[b.dates.at(-1)] ?? b.meta.latestPeriod; };
---
<Base
  title="Women and men · India Atlas"
  description={D.description}
  nav="guides"
  dateStamp={mastheadStamp(D)}
  crumbLeft={`<a href="/guides/">Guides</a> / ${D.section} / <b>${D.crumbTitle}</b>`}
  crumbRight={`${D.statusNote}, <b>${D.version}</b>`}
  canonical="https://atlas.thisindianlife.today/guides/gender/"
  ogImage={`/og/${D.slug}.png`}
>
<div class="page">

  <div class="titleblock break">
    <div class="kicker">{kicker(D)}</div>
    <div class="hero-grid">
      <h1 set:html={D.headline} />
      <p class="lede">Every year MoSPI gathers what India's agencies know about women and men into one book: how many girls are born, how long women live, how far they study, whether they work and for how much, who holds the money and the seats, and how safe women are. This guide holds every table of the 2025 edition, each figure kept to the agency that measured it.</p>
    </div>
    <div class="meta">
      <span>Source <b>MoSPI, Women and Men in India 2025</b></span>
      <span>Released <b>29 April 2026</b></span>
      <span>Instruments <b>Census, SRS, NFHS, PLFS, Time Use Survey, NCRB, RBI and others</b></span>
      <span>Tables <b>{D.bundles.length} files from {nTables} tables</b></span>
      <span>Window <b>1951 to 2026</b></span>
      <span>Unit <b>As each table states</b></span>
    </div>
    <div class="numbers">
      <div class="num"><div class="l">Girls born for every 1,000 boys</div><div class="v acc" id="n-srb">{f0(srbNow.value)}</div><div class="d" id="d-srb">{srbThen.period}: {f0(srbThen.value)}; SRS, {srbNow.period}</div></div>
      <div class="num"><div class="l">Women 15+ in the labour force</div><div class="v" id="n-lfpr">{f1(lfW)}<span class="pc">%</span></div><div class="d" id="d-lfpr">men {f1(lfMen)}%, PLFS 2025</div></div>
      <div class="num"><div class="l">Women's share of Lok Sabha seats</div><div class="v" id="n-ls">{f1(lsNow.value)}<span class="pc">%</span></div><div class="d" id="d-ls">{lsNow.period} election; {f1(lsFirst.value)}% in {lsFirst.period}</div></div>
      <div class="num"><div class="l">Minutes a day women spend on unpaid work at home</div><div class="v" id="n-time">{f0(time[0].b)}</div><div class="d" id="d-time">men {f0(time[1].b)}, Time Use Survey 2024</div></div>
    </div>
  </div>

  <!-- § 01 the current reading. Inputs: gender-t007 and the bundles named in pipeline/lib/facts-health-gender.mjs. Prose: generated slots. -->
  <section>
    <div class="sec-head"><span class="no">01</span><h2>The current reading</h2><span class="line"></span><span class="unit">Women and Men in India 2025</span></div>
    <div class="reading-top">
      <div><span class="rk">Girls born per 1,000 boys</span><div class="big" id="rb-srb">{f0(srbNow.value)}</div></div>
      <p class="rt-cap">The Sample Registration System's sex ratio at birth for {srbNow.period}, a three-year average. Nature produces about 950 girls for every 1,000 boys; a lower figure means girls are missing at birth.</p>
      <div class="rt-side"><span class="rk">In {srbThen.period}</span><div class="rt-side-v" id="rb-srb-then">{f0(srbThen.value)}</div></div>
    </div>
    <div class="reading-cols">
      <div class="reading-col">
        <span class="mk">What the tables say</span>
        <Prose slot="gender.current-reading.what-the-print-says" />
      </div>
      <div class="reading-col now">
        <span class="mk">What they do not say</span>
        <Prose slot="gender.current-reading.what-it-does-not-say" />
      </div>
    </div>
  </section>

  <!-- § 02 how to read the compendium: evergreen -->
  <section>
    <div class="sec-head"><span class="no">02</span><h2>How to read the compendium</h2><span class="line"></span></div>
    <div class="wm-grid">
      <div>
        <p>Women and Men in India is a reprint, not a survey. MoSPI's Social Statistics Division collects tables from the agencies that measure each thing: the Registrar General for births, deaths and the census, the National Family Health Survey for health, the Periodic Labour Force Survey for work, the Time Use Survey for unpaid work, the National Crime Records Bureau for crime, the Reserve Bank, ministries and regulators for money and office. Every figure here is that agency's figure, and the guide names the agency on every chart.</p>
        <p>Because each table comes from a different instrument, each has its own calendar. The census counts once a decade; the Sample Registration System reports three-year averages; school data run by school year, labour data by agricultural year until 2022 and by calendar year since; schemes report "as on" a date. The guide keeps each table on its own axis and labels each period as its source names it.</p>
        <p><b>Where a table joins two instruments, we split it.</b> The compendium prints census literacy beside a 2017-18 sample survey figure, and labour rates from the old and the revamped Labour Force Survey in one column. Those are different rulers; here they are separate files, drawn side by side with the changeover marked, never as one line. The compendium's NFHS tables are split by round the same way.</p>
        <p>Some cuts are not published: a state the survey could not cover, a crime head a state did not report. Where a table prints "-" or "NR", the guide shows nothing rather than a zero.</p>
      </div>
      <div class="wm-rail">
        <aside class="margin-note"><span class="mk">Margin note, i</span><b>Twelve tables have gone.</b> MoSPI's own definitions list twelve indicators the service no longer returns: disease cases by sex, school costs per student, ownership of assets and an earlier adolescent fertility table. We record them as unavailable.</aside>
        <aside class="margin-note"><span class="mk">Margin note, ii</span><b>Other guides go deeper.</b> Work by sex, state, age and industry is in the Jobs guide; the ILO's estimates in Work, as the ILO counts it; fertility and life expectancy from the UN in Population; the full health survey in Family health.</aside>
      </div>
    </div>
  </section>

  <!-- § 03 the count. Inputs: gender-t007 (SRS sex ratio at birth), gender-t002 (census), gender-t006 (CRS). -->
  <section>
    <div class="sec-head"><span class="no">03</span><h2>The count</h2><span class="line"></span><span class="unit">Girls born per 1,000 boys; women per 1,000 men</span></div>
    <div class="break">
      <figure id="cb-srb" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Fewer girls are missing at birth: {f0(srbThen.value)} per 1,000 boys in {srbThen.period}, {f0(srbNow.value)} in {srbNow.period}</h3>
            <div class="sub">Sex ratio at birth, girls born per 1,000 boys, three-year averages from the Sample Registration System: India, towns and villages. Each window is placed at its middle year.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-srb">{f0(srbNow.value)}</div><div class="c">India, {srbNow.period}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-srb" set:html={CH["srb"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Sample Registration System, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (table 1.6).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Left alone, about 105 boys are born for every 100 girls, roughly 950 girls per 1,000 boys. A ratio well below that means girls are being selected out before birth; telling parents the sex of a foetus has been illegal since 1994. Each point averages three years, so a change shows up slowly.</p>
            <p>In the first windows towns ran lower than villages; the lines have since crossed.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf("gender-t007")}</span>
            <p>India <b id="ex-srb-now">{f0(srbNow.value)}</b>, towns {f0(srbU.at(-1).value)}, villages {f0(srbR.at(-1).value)}. In {srbThen.period} towns stood at {f0(srbU[0].value)} and villages at {f0(srbR[0].value)}.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-srb-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>{srbS.at(-1).geo} has {f0(srbS.at(-1).v)} girls born per 1,000 boys; {srbS[0].geo} has {f0(srbS[0].v)}</h3>
            <div class="sub">Sex ratio at birth, {srbNow.period}, the larger states the Sample Registration System reports separately.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-srb-states">{srbS.filter((r) => r.v < srbNow.value).length}</div><div class="c">states below India's {f0(srbNow.value)}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-srb-states" set:html={CH["srb-states"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Sample Registration System, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (table 1.6). The Civil Registration System's count of registered births by state (table 1.5) is in the data downloads.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The Sample Registration System follows a fixed sample of households and records every birth, so its ratio is the steadier one. The Civil Registration System counts births registered with the state; where registration is incomplete, and girls go unregistered more often, its ratio can mislead.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf("gender-t007")}</span>
            <p>Lowest: <b id="ex-srbs-lo">{srbS.at(-1).geo}, {f0(srbS.at(-1).v)}</b>. Highest: {srbS[0].geo}, {f0(srbS[0].v)}. {srbS.filter((r) => r.v >= 950).length} of {srbS.length} states reach 950.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-census" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Seven censuses: the count of women per 1,000 men fell to {f0(srLow.value)} in {srLow.period} and recovered to {f0(sr.at(-1).value)}</h3>
            <div class="sub">Sex ratio of the whole population, women per 1,000 men, India, census years 1951 to 2011. The 2021 census has not been taken.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-census">{f0(sr.at(-1).value)}</div><div class="c">Census {sr.at(-1).period}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-census" set:html={CH["census"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Census of India, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (table 1.3). Every state's census ratio is in the data downloads.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>This ratio counts everyone alive, not births. It moves with births, with who dies young (for decades more girls died in childhood than boys) and with migration. Women outlive men, so an ageing population pushes it up even when births stay unequal.</p>
          </div>
          <div class="now">
            <span class="mk">As of Census {sr.at(-1).period}</span>
            <p>Census {sr[0].period}: <b>{f0(sr[0].value)}</b>. Low point {srLow.period}: <b id="ex-cen-low">{f0(srLow.value)}</b>. Census {sr.at(-1).period}: {f0(sr.at(-1).value)}.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 04 survival. Inputs: gender-t015, gender-t017, gender-t018, gender-t021. -->
  <section>
    <div class="sec-head"><span class="no">04</span><h2>Survival</h2><span class="line"></span><span class="unit">Sample Registration System</span></div>
    <div class="break">
      <figure id="cb-imr" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Baby girls used to die more often than baby boys; {imrCross ? `since ${imrCross.period} they no longer do` : "the gap is closing"}</h3>
            <div class="sub">Infant deaths per 1,000 live births, girls and boys, India, {imrF[0].period} to {imrF.at(-1).period}.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-imr">{f0(imrF.at(-1).value)}</div><div class="c">girls, {imrF.at(-1).period}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-imr" set:html={CH["imr"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Sample Registration System, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (tables 2.5, 2.6). Rates by state, village and town are in the data downloads.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Newborn boys are biologically frailer, so where girls are cared for equally, slightly more boys die in the first year. A higher death rate for girls is a sign of neglect: less food, later treatment, fewer trips to the doctor. The crossing of these lines is one of the quieter changes in Indian family life.</p>
          </div>
          <div class="now">
            <span class="mk">As of {imrF.at(-1).period}</span>
            <p>Girls <b id="ex-imr-f">{f0(imrF.at(-1).value)}</b>, boys {f0(imrM.at(-1).value)} per 1,000 births; in {imrF[0].period}, girls {f0(imrF[0].value)} and boys {f0(imrM[0].value)}. Before the fifth birthday: girls {f0(u5F)}, boys {f0(u5M)}.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-mmr" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Maternal deaths fell from {f0(mmr[0].value)} to {f0(mmr.at(-1).value)} for every 1,00,000 births</h3>
            <div class="sub">Maternal mortality ratio, deaths of women from pregnancy and childbirth per 1,00,000 live births, India, three-year windows from {mmr[0].period} to {mmr.at(-1).period}.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-mmr">{f0(mmr.at(-1).value)}</div><div class="c">{mmr.at(-1).period}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-mmr" set:html={CH["mmr"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Sample Registration System special bulletins on maternal mortality, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (table 2.9).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Maternal deaths are rare enough that one year's sample cannot measure them, so the Registrar General pools three years. The windows overlap, and the gaps between them are uneven, which is why the points are not evenly spaced.</p>
          </div>
          <div class="now">
            <span class="mk">As of {mmr.at(-1).period}</span>
            <p>India <b id="ex-mmr-now">{f0(mmr.at(-1).value)}</b>. Highest among the states reported: {mmrS[0].geo} ({f0(mmrS[0].v)}); lowest: {mmrS.at(-1).geo} ({f0(mmrS.at(-1).v)}).</p>
          </div>
        </div>
      </figure>

      <figure id="cb-mmr-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>A mother in {mmrS[0].geo} is about {Math.round(mmrS[0].v / mmrS.at(-1).v)} times as likely to die in childbirth as one in {mmrS.at(-1).geo}</h3>
            <div class="sub">Maternal mortality ratio, {mmr.at(-1).period}, the states the Sample Registration System reports separately (some smaller states are pooled with a neighbour).</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-mmr-states">{f0(mmrS[0].v)}</div><div class="c">{mmrS[0].geo}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-mmr-states" set:html={CH["mmr-states"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Sample Registration System, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (table 2.9).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The ratio is per 1,00,000 births, not per woman. A state with fewer births and a high ratio may still lose fewer mothers in all than a populous state with a middling one.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-life" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Women outlive men by {f1(leLastMeasured.value - leLastMeasuredM.value)} years: {f1(leLastMeasured.value)} against {f1(leLastMeasuredM.value)}</h3>
            <div class="sub">Life expectancy at birth, women and men, India, five-year windows placed at their middle year. The pale stretch is the Technical Group on Population Projections' projection, not a measurement.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-life">{f1(leLastMeasured.value)}</div><div class="c">women, {leLastMeasured.period}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-life" set:html={CH["life"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Sample Registration System abridged life tables, Office of the Registrar General of India; projections from the Report of the Technical Group on Population Projections (July 2020); as reprinted in MoSPI's Women and Men in India 2025 (table 2.8). The UN's estimates are in the Population guide.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Life expectancy at birth is how long a baby would live if today's death rates at every age held for her whole life. In the early 1990s women and men lived about as long as each other in India; the women's advantage seen in most of the world opened up only as maternal deaths fell.</p>
          </div>
          <div class="now">
            <span class="mk">As of {leLastMeasured.period}</span>
            <p>Women <b id="ex-le-f">{f1(leLastMeasured.value)}</b> years, men {f1(leLastMeasuredM.value)}. In {leF[0].period}, women {f1(leF[0].value)} and men {f1(leM[0].value)}.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 05 fertility and marriage. Inputs: gender-t010, gender-t012, gender-t014. -->
  <section>
    <div class="sec-head"><span class="no">05</span><h2>Children and marriage</h2><span class="line"></span><span class="unit">Sample Registration System, {asOf("gender-t010")}</span></div>
    <div class="break">
      <figure id="cb-tfr-edu" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>A woman who never went to school has {f1(tfrEdu[0].v)} children on average; a graduate has {f1(tfrEdu.at(-1).v)}</h3>
            <div class="sub">Total fertility rate by the mother's schooling, India, {asOf("gender-t010")}. The rule marks all literate women.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-tfr-edu">{f1(tfrEdu[0].v)}</div><div class="c">children per woman, no schooling</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-tfr-edu" set:html={CH["tfr-edu"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Sample Registration System, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (table 2.1). Rates for villages and towns, and by age, are in the data downloads.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Schooling and fewer children travel together: a woman in school marries later, knows more about contraception and has more say. The link is not only cause and effect; the women who stay in school also tend to come from richer, more urban families.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf("gender-t010")}</span>
            <p>No schooling <b id="ex-tfr-ill">{f1(tfrEdu[0].v)}</b>; graduate {f1(tfrEdu.at(-1).v)}; all literate women {f1(tfrAll)}. Births per 1,000 girls aged 15-19: {f1(adol)}.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-marriage-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Women marry at {f1(mar)} on average, from {f1(marS.at(-1).v)} in {marS.at(-1).geo} to {f1(marS[0].v)} in {marS[0].geo}</h3>
            <div class="sub">Women's mean age at effective marriage, years, by state, {asOf("gender-t014")}.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-marriage">{f1(mar)}</div><div class="c">years, India</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-marriage-states" set:html={CH["marriage-states"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Sample Registration System, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (table 2.4). The NFHS's share of women married before 18 is in Family health.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>An average hides the girls married young. A state with an average of 22 can still have many brides under 18; the share married before 18, from the health survey, tells that story.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf("gender-t014")}</span>
            <p>India <b id="ex-mar">{f1(mar)}</b> years. Youngest: {marS.at(-1).geo} ({f1(marS.at(-1).v)}). Oldest: {marS[0].geo} ({f1(marS[0].v)}).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 06 school and college. Inputs: gender-t060, gender-t074, gender-t055-census, gender-t055-nss, gender-t070. -->
  <section>
    <div class="sec-head"><span class="no">06</span><h2>School and college</h2><span class="line"></span><span class="unit">UDISE+, AISHE, Census, NSS</span></div>
    <div class="break">
      <figure id="cb-school" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Girls now enrol at least as much as boys at every level, and drop out less</h3>
            <div class="sub">Gross enrolment ratio ({gerPeriod}) and dropout rate ({dropPeriod}), per cent: boys and girls.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-school">{f1(ger.at(-1).b)}<span class="pc">%</span></div><div class="c">women's enrolment in higher education</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-school" set:html={CH["school"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: UDISE+, Department of School Education and Literacy, and the All India Survey on Higher Education, Ministry of Education, as reprinted in MoSPI's Women and Men in India 2025 (tables 3.5, 3.15).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://udiseplus.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The gross enrolment ratio divides everyone enrolled at a level, whatever their age, by the children of the age for that level. It can pass 100 when older children repeat a class, and it says nothing about attendance or learning. The dropout rate is the share of a year's pupils who do not come back the next year.</p>
          </div>
          <div class="now">
            <span class="mk">As of {gerPeriod}</span>
            <p>Higher education: women <b id="ex-ger-he">{f1(ger.at(-1).b)}%</b>, men {f1(ger.at(-1).a)}%. Secondary dropout: girls {f1(drop.at(-1).b)}%, boys {f1(drop.at(-1).a)}%.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-literacy" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Census literacy: women went from {f1(litF[0].value)}% to {f1(litF.at(-1).value)}% in thirty years, and still trailed men by {f1(litM.at(-1).value - litF.at(-1).value)} points</h3>
            <div class="sub">Literacy rate, people 7 and over, women and men, India: census years 1981 to 2011, and the NSS's 2017-18 survey drawn apart as a separate measure.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-literacy">{f1(litF.at(-1).value)}<span class="pc">%</span></div><div class="c">women, Census 2011</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-literacy" set:html={CH["literacy"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Census of India, Office of the Registrar General of India; 2017-18 from the National Sample Survey's 75th round, National Statistics Office; as reprinted in MoSPI's Women and Men in India 2025 (table 3.1). The two are different instruments and are not joined.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Both ask whether a person can read and write a simple message with understanding, but the census asks everyone in the household and the survey asks a sample, with a different questionnaire. The gap between the 2011 census and the 2017-18 survey is not a measured change.</p>
          </div>
          <div class="now">
            <span class="mk">As of Census 2011</span>
            <p>Census 2011: women <b id="ex-lit-f">{f1(litF.at(-1).value)}%</b>, men {f1(litM.at(-1).value)}%. NSS 2017-18: women {f1(litNssF.at(-1).value)}%, men {f1(litNssM.at(-1).value)}%.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-schooling-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>An Indian woman over 15 has {f1(ysWomen)} years of schooling, a man {f1(ysMen)}; {ysAhead.length ? `women lead in ${ysAhead.length} states and UTs` : "men have more in every state and UT"}</h3>
            <div class="sub">Mean years of schooling, people 15 and over, women and men, by state and UT, 2022-23.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-schooling">{f1(ysWomen)}</div><div class="c">years, women, India</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-schooling-states" set:html={CH["schooling-states"](DATA, { a: ysMen, b: ysWomen })} />
          <div class="plotfoot">
            <span class="src">Source: Comprehensive Annual Modular Survey 2022-23 (NSS 79th round), National Statistics Office, as reprinted in MoSPI's Women and Men in India 2025 (table 3.12.3).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://mospi.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Mean years of schooling counts every adult, including the grandmothers who never went to school, so it moves slowly and records the past as much as the present. Enrolment shows today's children; this shows the stock of education in a state's adults.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2022-23</span>
            <p>Women <b id="ex-ys-w">{f1(ysWomen)}</b> years, men {f1(ysMen)}. Most, women: {ysRows[0].geo} ({f1(ysRows[0].women)}); fewest: {ysRows.at(-1).geo} ({f1(ysRows.at(-1).women)}).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 07 work and pay. Inputs: gender-t085-ay/-cy/-cy25 (WPR, three rulers), gender-t082-cy25, gender-t087-cy25, gender-t092-cy25. -->
  <section>
    <div class="sec-head"><span class="no">07</span><h2>Work and pay</h2><span class="line"></span><span class="unit">Periodic Labour Force Survey</span></div>
    <div class="break">
      <figure id="cb-work" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Women at work rose from {f1(wprAyF[0].value)}% in {wprAyF[0].period} to {f1(wprAyF.at(-1).value)}% in {wprAyF.at(-1).period} on the old survey's measure, and stands at {f1(wpr25F[0].value)}% on the new one</h3>
            <div class="sub">Worker population ratio, people 15 and over at work, usual status, women and men, India, on three rulers: agricultural years (July to June) and calendar years on the survey's original design, and the revamped design from 2025. Each drawn on its own, with the changeovers marked.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-work">{f1(wpr25F[0].value)}<span class="pc">%</span></div><div class="c">women at work, 2025</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-work" set:html={CH["work"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Periodic Labour Force Survey, National Statistics Office, MoSPI, as reprinted in MoSPI's Women and Men in India 2025 (table 4.6.1). The Jobs guide carries every PLFS cut by state, age, sector and industry.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://mospi.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>"At work" in usual status means a person's main activity over the past year, or a subsidiary one for at least 30 days, was work for pay, profit or the family's own farm or business. Much of the rise in women's work since 2017-18 is unpaid help in a family enterprise and self-employment, not wage jobs.</p>
            <p>The survey changed twice in this window: from agricultural to calendar years, and in 2025 to a new sample design. Change is read within a ruler, never across the marked lines.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2025</span>
            <p>2025: women <b id="ex-wk-f">{f1(wpr25F[0].value)}%</b>, men {f1(wpr25M[0].value)}%. Calendar years: women {f1(wprCyF[0].value)}% in {wprCyF[0].period} and {f1(wprCyF.at(-1).value)}% in {wprCyF.at(-1).period}. Of women at work, {f1(informalF)}% are in the informal sector, against {f1(informalM)}% of men.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-lfpr-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Women's labour force participation runs from {f1(lfRows.at(-1).women)}% in {lfRows.at(-1).geo} to {f1(lfRows[0].women)}% in {lfRows[0].geo}</h3>
            <div class="sub">Labour force participation rate, people 15 and over, women and men, by state and UT, 2025, usual status.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-lfpr">{f1(lfW)}<span class="pc">%</span></div><div class="c">women, India</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-lfpr-states" set:html={CH["lfpr-states"](DATA, { a: lfMen, b: lfW })} />
          <div class="plotfoot">
            <span class="src">Source: Periodic Labour Force Survey 2025, National Statistics Office, MoSPI, as reprinted in MoSPI's Women and Men in India 2025 (table 4.3).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://mospi.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The states with the most women in the labour force are mostly hill and north-eastern states, where women farm; the fewest are in the north-west and in cities, where paid work for women outside the home is scarcer. Men's rates vary far less from state to state.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2025</span>
            <p>India: women <b id="ex-lf-w">{f1(lfW)}%</b>, men {f1(lfMen)}%. Highest for women: {lfRows[0].geo} ({f1(lfRows[0].women)}%). Lowest: {lfRows.at(-1).geo} ({f1(lfRows.at(-1).women)}%).</p>
          </div>
        </div>
      </figure>

      <figure id="cb-wage-states" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>A village woman doing casual work earns ₹{f0(wF)} a day, a man ₹{f0(wM)}: {Math.round((100 * wF) / wM)} rupees for every 100</h3>
            <div class="sub">Average daily wage of casual labourers in work other than public works, rural, women and men, by state and UT, 2025, rupees. {wageNone.length} states and UTs with no estimate for women are left out: {wageNone.join(", ")}.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-wage">₹{f0(wF)}</div><div class="c">a day, rural women</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-wage-states" set:html={CH["wage-states"](DATA, { a: wM, b: wF })} />
          <div class="plotfoot">
            <span class="src">Source: Periodic Labour Force Survey 2025, National Statistics Office, MoSPI, as reprinted in MoSPI's Women and Men in India 2025 (table 4.7). Urban wages, and hourly earnings by occupation, are in the data downloads.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://mospi.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Casual labour is daily-wage work: harvesting, construction, loading. Part of the gap is the kind of work each is given, part is a lower rate for the same work. Public works such as MGNREGA, which pay women and men the same rate, are counted separately and are not in this measure.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2025</span>
            <p>Rural casual wage: women <b id="ex-wg-f">₹{f0(wF)}</b>, men ₹{f0(wM)}. Highest for women: {wageRows[0].geo} (₹{f0(wageRows[0].women)}).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 08 time. Inputs: gender-t103 (TUS 2019), gender-t104 and gender-t098 (TUS 2024). -->
  <section>
    <div class="sec-head"><span class="no">08</span><h2>The working day nobody pays for</h2><span class="line"></span><span class="unit">Time Use Survey, minutes a day</span></div>
    <div class="break">
      <figure id="cb-time" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Women spend about {f1(time[0].b / 60)} hours a day on unpaid work at home, men under one hour, and the gap barely moved between the surveys</h3>
            <div class="sub">Average minutes a day per person aged 6 and over, India: Time Use Survey 2019 and 2024. Unpaid work at home in 2019 adds the survey's two unpaid categories (domestic and care work, and production for the household's own use).</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-time">{f0(time[0].b)}</div><div class="c">minutes, women, 2024</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-time" set:html={CH["time"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Time Use Survey 2019 and 2024, National Statistics Office, MoSPI, as reprinted in MoSPI's Women and Men in India 2025 (tables 4.21.1, 4.21.2). Every activity, by village and town and by age, is in the data downloads.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://mospi.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The survey asks each person to account for every half hour of the previous day. "Per person" averages over everyone, including those who did none of the activity; "per participant", in the downloads, averages only over those who did. Unpaid work at home is cooking, cleaning, fetching water and fuel, and looking after children and the old.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2024</span>
            <p>Unpaid work at home: women <b id="ex-tm-f">{f0(time[0].b)}</b> minutes a day, men {f0(time[1].b)}. Women who do domestic work spend {f0(careF)} minutes on it; men who do, {f0(careM)}.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 09 money. Inputs: gender-t108, gender-t109, gender-t111, gender-t113, gender-t114, gender-t115, gender-t118 (shares derived from their counts). -->
  <section>
    <div class="sec-head"><span class="no">09</span><h2>Money in women's names</h2><span class="line"></span><span class="unit">Women's share, per cent</span></div>
    <div class="break">
      <figure id="cb-money" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Women hold half or more of the accounts in most government schemes, and a fifth to a quarter of the investing</h3>
            <div class="sub">Women's share of accounts, enrolments or holders in each scheme or market, India, latest date each source reports. Computed from the counts the compendium prints, except NSE's, which it prints as a share.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-money">{f1(money.find((m) => /Jan Dhan/.test(m.label)).v)}<span class="pc">%</span></div><div class="c">of Jan Dhan accounts are women's</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-money" set:html={CH["money"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Department of Financial Services, Ministry of Finance (PMJDY, PMJJBY, PMSBY, APY, Stand-Up India); RBI, BSR-2 (deposits, March 2025); CDSL (demat); NSE (investors); as reprinted in MoSPI's Women and Men in India 2025 (tables 4.24 to 4.36). Shares computed by the Atlas from the printed counts.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://mospi.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>An account in a woman's name is not money she controls. Many scheme accounts were opened to receive government transfers; they show that the money reaches her name, not that she decides how it is spent. The investing figures are closer to choice, and there women are a small minority.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2025</span>
            <p>Jan Dhan accounts: <b id="ex-mo-jd">{f1(money.find((m) => /Jan Dhan/.test(m.label)).v)}%</b> women's. Demat accounts with CDSL: {f1(dematShare0)}% women's in March 2021, {f1(dematShare1)}% by October 2025. Bank deposits of individuals, by value: {f1(money.find((m) => /by value/.test(m.label)).v)}% women's.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 10 voice. Inputs: gender-t124 (share derived), gender-t125, gender-t126-total, gender-t127, gender-t123, gender-t130, gender-t131, gender-t172. -->
  <section>
    <div class="sec-head"><span class="no">10</span><h2>Voice and office</h2><span class="line"></span><span class="unit">Women's share, per cent</span></div>
    <div class="break">
      <figure id="cb-lok-sabha" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Women held {f1(lsFirst.value)}% of Lok Sabha seats in {lsFirst.period} and {f1(lsNow.value)}% in {lsNow.period}</h3>
            <div class="sub">Women elected to the Lok Sabha as a share of the seats, general elections {lsFirst.period} to {lsNow.period}. Computed from the counts the compendium prints.</div>
          </div>
          <div class="plate-val"><div class="v acc" id="pv-ls">{f1(lsNow.value)}<span class="pc">%</span></div><div class="c">{lsNow.period}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-lok-sabha" set:html={CH["lok-sabha"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Election Commission of India, as reprinted in MoSPI's Women and Men in India 2025 (table 5.2). Share computed by the Atlas: women elected divided by seats.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://eci.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Parliament passed the Constitution (106th Amendment) in 2023 to reserve a third of Lok Sabha and assembly seats for women; it takes effect only after the next census and delimitation of constituencies. Women who contest win more often than men do: parties field few women, and mostly in seats they expect to win.</p>
          </div>
          <div class="now">
            <span class="mk">As of {lsNow.period}</span>
            <p>{f0(lsW.at(-1).value)} women elected in {lsNow.period}, <b id="ex-ls-share">{f1(lsNow.value)}%</b> of the {f0(lsSeats.get(lsW.at(-1).iso))} seats that went to a poll, from {f0(lsCand.at(-1).value)} women candidates. The Lok Sabha Secretariat counts all {f0(value("gender-t125", "total_seats__all_india"))} seats, so the chart below shows {f1(value("gender-t125", "women__all_india"))}%.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-voice" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Half of panchayat members are women, where a law reserves the seats; in the other offices women hold {f1(voice.at(-1).v)}% to {f1(voice[1].v)}%</h3>
            <div class="sub">Women's share of members or holders, India, latest date each source reports.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-voice">{f1(voice[0].v)}<span class="pc">%</span></div><div class="c">{voice[0].label.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-voice" set:html={CH["voice"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Ministry of Panchayati Raj; Lok Sabha Secretariat; Department of Justice; Bureau of Police Research and Development; Election Commission of India; Ministry of Corporate Affairs; as reprinted in MoSPI's Women and Men in India 2025 (tables 5.1 to 5.11). Assembly and company shares computed by the Atlas from the printed counts.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://mospi.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The 73rd and 74th Amendments (1992) reserved a third of panchayat and municipal seats for women, and many states have raised that to half. No such rule applies to the courts, the police or company boards, apart from the Companies Act's requirement of at least one woman director on larger boards.</p>
          </div>
          <div class="now">
            <span class="mk">As of 2025</span>
            <p>Panchayats <b id="ex-vo-pri">{f1(voice.find((v) => /Panchayat/.test(v.label)).v)}%</b>; judges {f1(voice.find((v) => /judges/.test(v.label)).v)}%; police {f1(voice.find((v) => /Police/.test(v.label)).v)}%; senior company management {f1(voice.find((v) => /Senior/.test(v.label)).v)}%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 11 safety. Inputs: gender-t141, gender-t140, gender-t145, gender-t143-nfhs4/-nfhs5. -->
  <section>
    <div class="sec-head"><span class="no">11</span><h2>Safety</h2><span class="line"></span><span class="unit">National Crime Records Bureau, {crimeYear}</span></div>
    <div class="break">
      <figure id="cb-crime-states" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Recorded crimes against women: {f1(crimeAI)} for every 1,00,000 women, from {f1(crimeS.at(-1).v)} in {crimeS.at(-1).geo} to {f1(crimeS[0].v)} in {crimeS[0].geo}</h3>
            <div class="sub">Crimes against women registered by the police, per 1,00,000 women, by state and UT, {crimeYear}.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-crime">{f1(crimeAI)}</div><div class="c">India, per 1,00,000 women</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-crime-states" set:html={CH["crime-states"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Crime in India, National Crime Records Bureau, as reprinted in MoSPI's Women and Men in India 2025 (table 6.2). Rates by crime head for every state are in the data downloads.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ncrb.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>These are crimes the police registered, not crimes committed. A state where women are more willing, and police more ready, to file a case records more. A high rate can mean more crime, more reporting, or both; a very low one can mean women do not go to the police.</p>
          </div>
          <div class="now">
            <span class="mk">As of {crimeYear}</span>
            <p>India <b id="ex-cr-ai">{f1(crimeAI)}</b> per 1,00,000 women; {f0(allCases.at(-1).value)} cases registered, against {f0(allCases[0].value)} in {allCases[0].period}. Highest: {crimeS[0].geo} ({f1(crimeS[0].v)}). Lowest: {crimeS.at(-1).geo} ({f1(crimeS.at(-1).v)}).</p>
          </div>
        </div>
      </figure>

      <figure id="cb-crime-heads" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>The most common recorded crime against women is cruelty by a husband or his family</h3>
            <div class="sub">Cases registered under each head, India, {heads[0].from} and {heads[0].to}.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-heads">{f0(heads[0].b)}</div><div class="c">cases of cruelty by husband or relatives, {heads[0].to}</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-crime-heads" set:html={CH["crime-heads"](DATA, { from: heads[0].from, to: heads[0].to })} />
          <div class="plotfoot">
            <span class="src">Source: Crime in India, National Crime Records Bureau, as reprinted in MoSPI's Women and Men in India 2025 (table 6.1). Heads under the Indian Penal Code and special laws as NCRB reports them.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ncrb.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Section 498A of the Indian Penal Code makes cruelty by a husband or his relatives a crime; most of these cases arise from violence and dowry demands at home. The health survey asks women directly and finds far more violence by husbands than ever reaches a police station.</p>
          </div>
          <div class="now">
            <span class="mk">As of {heads[0].to}</span>
            <p>Cruelty by husband or relatives: <b id="ex-hd-cruelty">{f0(heads[0].b)}</b> cases. In the health survey, {f1(sv5)}% of married women aged 18 to 49 said a husband had been physically or sexually violent (NFHS-5), against {f1(sv4)}% in NFHS-4.</p>
          </div>
        </div>
      </figure>

      <figure id="cb-conviction" style="margin:56px 0 0">
        <div class="plate-head">
          <div class="t">
            <h3>Fewer than {Math.ceil(conv[0].v)} in 100 cases due for trial ended in a conviction within the year, whatever the crime</h3>
            <div class="sub">Cases that ended in conviction during the year, as a share of all cases due for trial (the year's new cases and those pending from earlier years), by crime head, India, {asOf("gender-t145")}.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-conviction">{f1(convAll)}<span class="pc">%</span></div><div class="c">all crimes against women</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-conviction" set:html={CH["conviction"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Crime in India, National Crime Records Bureau, as reprinted in MoSPI's Women and Men in India 2025 (table 6.6).</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://ncrb.gov.in" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>This is not the usual "conviction rate", which divides convictions by the trials completed. It divides by every case due for trial, including the backlog, so it shows how few cases end in a verdict at all in a year. The counts of convictions, acquittals and cases pending are in the data downloads.</p>
          </div>
          <div class="now">
            <span class="mk">As of {asOf("gender-t145")}</span>
            <p>All crimes against women <b id="ex-cv-all">{f1(convAll)}%</b>; highest {conv[0].label.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())} ({f1(conv[0].v)}%), lowest {conv.at(-1).label.replace(/^[A-Z](?![A-Z])/, (c) => c.toLowerCase())} ({f1(conv.at(-1).v)}%).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 12 health, briefly. Inputs: gender-t160. -->
  <section>
    <div class="sec-head"><span class="no">12</span><h2>What women and men die of</h2><span class="line"></span><span class="unit">Sample Registration System, {causePeriod}</span></div>
    <div class="break">
      <figure id="cb-causes" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>More than half of deaths are from non-communicable disease; injuries take {f1(causes[2].a)}% of men's deaths and {f1(causes[2].b)}% of women's</h3>
            <div class="sub">Share of deaths by broad cause, men and women, India, {causePeriod}.</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-causes">{f1(causes[0].b)}<span class="pc">%</span></div><div class="c">women's deaths from non-communicable disease</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-causes" set:html={CH["causes"](DATA)} />
          <div class="plotfoot">
            <span class="src">Source: Cause of Death Statistics, Sample Registration System, Office of the Registrar General of India, as reprinted in MoSPI's Women and Men in India 2025 (table 2.30). Disability, HIV, tuberculosis and other health tables are in the data downloads; the household health survey is in Family health.</span>
            <span class="dl"><button data-dl="svg">SVG</button><button data-dl="png">PNG</button><button data-dl="csv">CSV</button><a href="https://censusindia.gov.in/census.website/data/SRSSTAT" target="_blank" rel="noopener">Source</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Cause of death is assigned by trained staff from a structured interview with the family after the death, a "verbal autopsy", because most Indians die without a doctor certifying the cause. A larger share of women's deaths is left ill-defined.</p>
          </div>
          <div class="now">
            <span class="mk">As of {causePeriod}</span>
            <p>Non-communicable disease: women <b id="ex-cd-ncd">{f1(causes[0].b)}%</b>, men {f1(causes[0].a)}%. Communicable, maternal, newborn and nutritional: women {f1(causes[1].b)}%, men {f1(causes[1].a)}%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 13 how to misread: evergreen -->
  <section>
    <div class="sec-head"><span class="no">13</span><h2>How to misread these tables</h2><span class="line"></span></div>
    <ul class="misread">
      <li><span class="no">i.</span><div>
        <h3>"Women's work jumped in 2023."</h3>
        <p>The compendium's columns change instrument mid-way: agricultural years, then calendar years, then a revamped survey from 2025. A jump at a changeover can be the new ruler. Read change within one ruler only; the chart marks each changeover.</p>
      </div></li>
      <li><span class="no">ii.</span><div>
        <h3>"Literacy among women rose from 64.6% in 2011 to 70% in 2017."</h3>
        <p>The first figure is the census, the second a sample survey with a different questionnaire. The gap between them is not a measured change.</p>
      </div></li>
      <li><span class="no">iii.</span><div>
        <h3>"Crime against women is highest in Delhi."</h3>
        <p>Recorded crime is highest there. A high rate can mean more crime, more women willing to go to the police, or police more ready to register a case, and the rate divides by the women who live in Delhi, not the many more who work in or pass through it. Low rates in some states may mean less reporting, not less crime.</p>
      </div></li>
      <li><span class="no">iv.</span><div>
        <h3>"Women own more bank accounts than men, so they control the money."</h3>
        <p>The schemes counted here opened accounts for women in large numbers, often to receive government transfers. Ownership on paper is not control; in deposits by value and in investing, women hold far less.</p>
      </div></li>
      <li><span class="no">v.</span><div>
        <h3>"The sex ratio is improving, so the problem is solved."</h3>
        <p>The ratio at birth has risen, but most large states remain below the natural level, and the census sex ratio of the whole population cannot be updated until the census is taken.</p>
      </div></li>
      <li><span class="no">vi.</span><div>
        <h3>"The compendium is MoSPI's data."</h3>
        <p>MoSPI compiles it; each table belongs to the agency that collected it. Revisions, definitions and errors are that agency's, and the guide names it on every chart.</p>
      </div></li>
    </ul>
  </section>

