---
// /guides/<slug>/every-cut/<bundle>/[n/]: the long tail of one bundle, every series of it in
// one sortable table (src/components/EveryCut.astro links here for bundles longer than
// LONG_TAIL). Bundles longer than PAGE_ROWS split over numbered pages, whole groups kept
// together, so no page ships megabytes of HTML.
import Base from "../../../../../layouts/Base.astro";
import EveryCutTable from "../../../../../components/EveryCutTable.astro";
import { DOSSIERS, bySlug } from "../../../../../dossiers/registry.js";
import { rowsOf, guideBundles, bundleTitle, loadBundle, LONG_TAIL, paginate } from "../../../../../dossiers/everycut.js";
export function getStaticPaths() {
  const out = [];
  for (const d of DOSSIERS) {
    for (const b of guideBundles(d)) {
      const rows = rowsOf(b);
      if (rows.length <= LONG_TAIL) continue;
      const pages = paginate(rows);
      pages.forEach((p, i) => out.push({ params: { slug: d.slug, bundle: b, page: i ? String(i + 1) : undefined }, props: { n: i, total: pages.length } }));
    }
  }
  return out;
}
const { slug, bundle } = Astro.params;
const { n, total } = Astro.props;
const d = bySlug[slug];
const B = loadBundle(bundle);
const pages = paginate(rowsOf(bundle));
const rows = pages[n];
const title = bundleTitle(bundle);
const hasGroups = rows.some((r) => r.group);
const base = `/guides/${slug}/every-cut/${bundle}/`;
const href = (i) => (i ? `${base}${i + 1}/` : base);
const nAll = pages.reduce((a, p) => a + p.length, 0);
const src = String(B.meta?.source ?? "").replace(/ — /g, ": ").replace(/ · /g, ", ");
---
<Base
  title={`${title}: every series · India Atlas`}
  description={`Every series of ${title}, from the India Atlas guide to ${d.title.toLowerCase()}: latest values, change on a year earlier, and downloads.`}
  nav="guides"
  crumbLeft={`<a href="/guides/">Guides</a> / <a href="/guides/${slug}/">${d.crumbTitle}</a> / <b>Every cut</b>`}
  canonical={`https://atlas.thisindianlife.today${href(n)}`}
  ogImage={`/og/${slug}.png`}
>
<div class="page">
  <div class="titleblock break ec-page">
    <div class="kicker"><a href={`/guides/${slug}/#every-cut`}>{d.title}: every series, every cut</a></div>
    <h1>{title}</h1>
    <p class="lede">{nAll.toLocaleString("en-IN")} series, each with its latest value, its change on a year earlier and its trend.{total > 1 ? ` Page ${n + 1} of ${total}.` : ""}</p>
    <div class="meta">
      <span>Source <b>{src}</b></span>
      {B.meta?.base && <span>Base <b>{B.meta.base}</b></span>}
      <span>Frequency <b>{B.meta?.frequency}</b></span>
      <span>Vintage <b>{B.meta?.vintage}</b></span>
      <span>Download <b><a href={`/data/${bundle}.csv`} download>CSV</a>, <a href={`/data/${bundle}.json`} download>JSON</a></b></span>
    </div>
  </div>
  <div class="break">
    {total > 1 && (
      <nav class="ec-pages" aria-label="Pages">{pages.map((p, i) => i === n
        ? <b aria-current="page">{i + 1}</b>
        : <a href={href(i)}>{i + 1}</a>)}<span>{rows.length.toLocaleString("en-IN")} series on this page</span></nav>
    )}
    <EveryCutTable rows={rows} id={`ec-${bundle}`} titles={{ [bundle]: "" }} fold={rows.length} filterBy={hasGroups ? "group" : "cut"} />
    <p class="ec-back"><a href={`/guides/${slug}/`}>Back to the guide: {d.title}</a></p>
  </div>
</div>
<style is:global>
  .ec-page h1{font-size:clamp(1.7rem,3.4vw,2.6rem);max-width:30ch}
  .ec-page .lede{max-width:60ch;margin-top:14px}
  .ec-page .kicker a{color:inherit;text-decoration:none;border-bottom:1px solid var(--rule-2)}
  .ec-page .meta a{color:inherit}
  .ec-pages{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:baseline;font-family:var(--sans);font-size:.9rem;margin-top:8px}
  .ec-pages a{color:var(--ink-soft)}
  .ec-pages span{color:var(--muted);font-size:.82rem;margin-left:8px}
  .ec-back{margin:36px 0 80px;font-family:var(--sans);font-size:.92rem}
  .ec-back a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--ink)}
</style>
<script>
  import "../../../../../dossiers/guide.client.js";
</script>
</Base>
