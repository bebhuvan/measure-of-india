---
// /guides/<slug>/every-cut/<id>/[n/]: one long-tail view of a guide's every-cut table, linked
// from src/components/EveryCut.astro: a bundle longer than LONG_TAIL, a registry family of small
// bundles (everyCutFamilies), or the files past the guide page's inline cap ("more"). Views over
// PAGE_ROWS split into numbered pages, whole groups (or whole files, for families) kept together,
// so no page ships megabytes of HTML. The plan is src/dossiers/everycut.js everyCutPlan.
import {vintageText} from "../../../../../../scripts/lib/vintage.mjs";
import Base from "../../../../../layouts/Base.astro";
import EveryCutTable from "../../../../../components/EveryCutTable.astro";
import { DOSSIERS, bySlug } from "../../../../../dossiers/registry.js";
import {governedDownloadPlan} from "../../../../../dossiers/governed-downloads.js";
import { bundleTitle, loadBundle, everyCutPlan } from "../../../../../dossiers/everycut.js";
export function getStaticPaths() {
  // ATLAS_SKIP_EVERY_CUT=1: a local verification build of everything but these long-tail pages
  // (most of dist's 4.8 GB), for a machine short of memory. Never set in CI or a release build.
  if (process.env.ATLAS_SKIP_EVERY_CUT) return [];
  const out = [];
  for (const d of DOSSIERS) for (const t of everyCutPlan(d).tails)
    t.pages.forEach((_, i) => out.push({ params: { slug: d.slug, bundle: t.id, page: i ? String(i + 1) : undefined }, props: { n: i } }));
  return out;
}
const { slug, bundle: id } = Astro.params;
const { n } = Astro.props;
const d = bySlug[slug];
const t = everyCutPlan(d).tails.find((x) => x.id === id);
const pages = t.pages, total = pages.length, rows = pages[n];
const single = t.kind === "bundle";
const governed=d.sourceQualityMode==="required";
const downloadInfo=b=>governedDownloadPlan(b,loadBundle(b),{required:governed});
const snapshot = t.bundles.every(b=>loadBundle(b).meta.frequency === "cross-sectional");
const B = loadBundle(t.bundles[0]);
const title = single ? bundleTitle(id) : t.label;
const hasGroups = single && rows.some((r) => r.group);
const base = `/guides/${slug}/every-cut/${id}/`;
const href = (i) => (i ? `${base}${i + 1}/` : base);
const nAll = t.rows.length;
const clean = (x) => String(x ?? "").replace(/ — /g, ": ").replace(/ · /g, ", ");
const sources = [...new Set(t.bundles.map((b) => clean(loadBundle(b).meta?.source)))];
const src = sources.length === 1 ? sources[0] : `${sources.length} sources, named per file`;
const titles = Object.fromEntries((single ? [] : [...new Set(rows.map((r) => r.bundle))]).map((b) => [b, bundleTitle(b)]));
---
<Base
  title={`${title}: every series · India Atlas`}
  description={`Every series of ${title}, from the India Atlas guide to ${d.title.toLowerCase()}: ${governed ? "every series, with the publisher's original files" : snapshot ? "source estimates and downloads" : "latest values, change on a year earlier, and downloads"}.`}
  nav="guides"
  crumbLeft={`<a href="/guides/">Guides</a> / <a href="/guides/${slug}/">${d.crumbTitle}</a> / <b>Every cut</b>`}
  canonical={`https://atlas.thisindianlife.today${href(n)}`}
  ogImage={`/og/${slug}.png`}
>
<div class="page">
  <div class="titleblock break ec-page">
    <div class="kicker"><a href={`/guides/${slug}/#every-cut`}>{d.title}: every series, every cut</a></div>
    <h1>{title}</h1>
    <p class="lede">{nAll.toLocaleString("en-IN")} series{single ? "" : ` from ${t.bundles.length.toLocaleString("en-IN")} ${t.bundles.length === 1 ? "file" : "files"}`}{governed ? ". Series whose definitions we have checked show their figures; the rest are listed without a figure until we have." : <>, each with {snapshot ? "its source estimate and downloads" : "its latest value, its change on a year earlier and its trend"}.</>}{total > 1 ? ` Page ${n + 1} of ${total}.` : ""}</p>
    {d.everyCutChangeMode === "none" && <p>Derived changes are not supplied.</p>}
    <div class="meta">
      <span>Source <b>{src}</b></span>
      {single && B.meta?.base && <span>Base <b>{B.meta.base}</b></span>}
      {single && <span>Frequency <b>{B.meta?.frequency}</b></span>}
      {single && <span>Vintage <b>{vintageText(B.meta)}</b></span>}
      {single ? <span>Download <b><a href={`/data/${id}.csv`} download>{governed?(downloadInfo(id).eligible.length?"CSV":"CSV (list only)"):"CSV"}</a>, <a href={`/data/${id}.json`} download>JSON</a>{governed&&<>, <a href={downloadInfo(id).source.href} download>{downloadInfo(id).source.linkLabel||"Original workbook"}</a></>}</b></span>
        : <span>Download <b>{governed?"CSV, JSON and the publisher's original files":"each file's CSV from its rows"}</b></span>}
    </div>
  </div>
  <div class="break">
    {!single && (
      <details class="ec-files" id="files">
        <summary>All {t.bundles.length.toLocaleString("en-IN")} {t.bundles.length === 1 ? "file" : "files"}{governed?", with the publisher's original files":", to download whole"}</summary>
        <ul>{t.bundles.map((b) => <li>{bundleTitle(b)} <a href={`/data/${b}.csv`} download>{governed?(downloadInfo(b).eligible.length?"CSV":"CSV (list only)"):"CSV"}</a> <a href={`/data/${b}.json`} download>JSON</a>{governed&&<><small> {downloadInfo(b).eligible.length} checked, {downloadInfo(b).pending.length} still being checked </small><a href={downloadInfo(b).source.href} download>{downloadInfo(b).source.linkLabel||"Original workbook"}</a></>}</li>)}</ul>
      </details>
    )}
    {total > 1 && (
      <nav class="ec-pages" aria-label="Pages">{pages.map((p, i) => i === n
        ? <b aria-current="page">{i + 1}</b>
        : <a href={href(i)}>{i + 1}</a>)}<span>{rows.length.toLocaleString("en-IN")} series on this page</span></nav>
    )}
    <EveryCutTable policyNotes={d.sourcePolicyNotes==="per-page"} rows={rows} id={`ec-${id}`} titles={single ? { [id]: "" } : titles} fold={rows.length} filterBy={hasGroups ? "group" : "cut"} />
    <p class="ec-back"><a href={`/guides/${slug}/`}>Back to the guide: {d.title}</a></p>
  </div>
</div>
<style is:global>
  .ec-page h1{font-size:clamp(1.7rem,3.4vw,2.6rem);max-width:30ch}
  .ec-page .lede{max-width:60ch;margin-top:14px}
  .ec-page .kicker a{color:inherit;text-decoration:none;border-bottom:1px solid var(--rule-2)}
  .ec-page .meta a{color:inherit}
  .ec-pages{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:baseline;font-family:var(--sans);font-size:.9rem;margin-top:8px}
  .ec-pages a{color:var(--ink-soft)}
  .ec-pages span{color:var(--muted);font-size:.82rem;margin-left:8px}
  .ec-files{margin:6px 0 22px;font-family:var(--sans);font-size:.88rem}
  .ec-files summary{cursor:pointer;color:var(--ink)}
  .ec-files ul{list-style:none;margin:12px 0 0;columns:2 26em;column-gap:40px}
  .ec-files li{break-inside:avoid;color:var(--ink-soft);padding:3px 0;line-height:1.45}
  .ec-files a{color:var(--ink-soft);margin-left:6px}
  .ec-back{margin:36px 0 80px;font-family:var(--sans);font-size:.92rem}
  .ec-back a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--ink)}
</style>
<script>
  import "../../../../../dossiers/guide.client.js";
  // a link to #files (from the guide's Data and downloads) opens the file list
  const f = document.getElementById("files");
  if (f && location.hash === "#files") f.open = true;
</script>
</Base>
