---
import { mastheadStamp } from "../../dossiers/headline.js";
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import GuideData from "../../components/GuideData.astro";
import EveryCut from "../../components/EveryCut.astro";
import { bySlug, kicker } from "../../dossiers/registry.js";
import { dateStamp } from "../../dossiers/display.js";
const D = bySlug["jobs"];
import { period, word } from "../../dossiers/periods.js";
import cuts from "../../../data/series/plfs-cuts.json";
import qtr from "../../../data/series/plfs-quarterly.json";
// periods and counts named in the copy, read from the bundles (src/dossiers/periods.js)
const PM = period("plfs-monthly"), PC = period("plfs-cuts");
const cap = (t) => t[0].toUpperCase() + t.slice(1);
const C = cuts.series, lastC = (k) => C[k].data.at(-1);
const urGap = C.ur_female_urban.data.map((v, i) => v - C.ur_male_urban.data[i]);
const minGap = Math.min(...urGap);
const lfFU = C.lfpr_female_urban.data;
// the quarterly bulletin's latest quarter, and its range over the last three years
const QN = ["Jan–Mar", "Apr–Jun", "Jul–Sep", "Oct–Dec"];
const qLabel = (iso) => `${QN[Math.floor((+iso.slice(5, 7) - 1) / 3)]} ${iso.slice(0, 4)}`;
const qUr = qtr.series.ur.data, qDates = qtr.dates;
const q12 = qUr.slice(-12).filter((v) => v != null);
const q12From = qDates[qDates.length - 12].slice(0, 4);

// ---- the deep bundles the new plates draw, sliced at build time (src/dossiers/jobs.data.js) ----
import { load as J, dateAt, jobsData } from "../../dossiers/jobs.data.js";
import * as CH from "../../dossiers/jobs.charts.js";
const cyYear = dateAt("plfs-cy25-india").slice(0, 4);          // the latest calendar year, revamped design
const cyOldYears = J("plfs-cy-india").dates.map((d) => d.slice(0, 4));
const q25Last = dateAt("plfs-q25"), q25First = J("plfs-q25").dates[0];
const H = "__person_all__a15plus";
const DATA = jobsData();
const TX = CH.numbers();
// figures the hand-written notes name, read from the same slices (asof.mjs governs the notes)
const byDesc = (rows, k) => [...rows].sort((a, b) => b[k] - a[k]);
const W = byDesc(DATA.work, "f"), PAY = byDesc(DATA.pay, "p"), CAS = byDesc(DATA.pay, "cas"), KIND = byDesc(DATA.kinds, "rg"), YS = byDesc(DATA.youthStates, "y");
const f1 = (v) => v.toFixed(1);
const inr0 = (v) => "₹" + Math.round(v).toLocaleString("en-IN");
const soc = (g, k) => DATA.social.series[`lfpr_psss__${g}_all__a15plus__${k}`].data.at(-1);
const qn = (iso) => `${["Jan–Mar", "Apr–Jun", "Jul–Sep", "Oct–Dec"][Math.floor((+iso.slice(5, 7) - 1) / 3)]} ${iso.slice(0, 4)}`;
const condY = (k, i) => DATA.cond.series[k].data.at(i);
const condFirst = J("plfs-conditions").dates[0].slice(0, 4), condLast = J("plfs-conditions").dates.at(-1).slice(0, 4);
const agri = (y) => `${y}-${String(+y + 1).slice(2)}`;
// §04 the whole country: the title states the rural-urban order only while every quarter holds it
const q25S = J("plfs-q25").series, q25R = q25S.ur_cws__person_rural__a15plus.data, q25U = q25S.ur_cws__person_urban__a15plus.data;
const q25Title = q25R.every((v, i) => v == null || q25U[i] == null || v < q25U[i])
  ? "Villages enter the quarterly count: rural unemployment runs below urban, every quarter"
  : "Villages enter the quarterly count, beside the towns";
// the same quarter a year earlier, when the series has one
const q25Dates = J("plfs-q25").dates, q25YearAgo = q25Dates.indexOf(`${+q25Last.slice(0, 4) - 1}${q25Last.slice(4)}`);
// §09 social: the title states the ordering only while the data holds it
const socOrder = ["soc_scheduled_tribe", "soc_scheduled_caste", "soc_other_backward_class", "soc_others"].map((k) => soc("female", k));
const socTitle = socOrder.every((v, i) => i === 0 || v < socOrder[i - 1])
  ? `Women's work falls as caste rank rises: ${f1(socOrder[0])}% of tribal women are in the labour force, ${f1(socOrder[3])}% of women outside the reserved groups`
  : `Women's work differs by social group far more than men's: from ${f1(Math.max(...socOrder))}% to ${f1(Math.min(...socOrder))}%`;
// §03 seam: the latest year of the original design's calendar estimates against the first of the revamped
const sL0 = DATA.seam.cy.series["lfpr_psss" + H].data.at(-1), sL1 = DATA.seam.cy25.series["lfpr_psss" + H].data.at(-1);
const sU0 = DATA.seam.cy.series["ur_psss" + H].data.at(-1), sU1 = DATA.seam.cy25.series["ur_psss" + H].data.at(-1);
const seamTitle = Math.abs(sL1 - sL0) < 1 && Math.abs(sU1 - sU0) < 0.5
  ? "The redesigned survey picks up close to where the old one left off"
  : `The redesigned survey reads participation ${f1(Math.abs(sL1 - sL0))} points ${sL1 > sL0 ? "higher" : "lower"} than the old one did a year earlier`;
---
<Base
  title="Jobs · India Atlas"
  description={D.description}
  nav="guides"
  dateStamp={mastheadStamp(D)}
  crumbLeft={`<a href="/guides/">Guides</a> / ${D.section} / <b>${D.crumbTitle}</b>`}
  crumbRight={`${D.statusNote}, <b>${D.version}</b>`}
  canonical="https://atlas.thisindianlife.today/guides/jobs/"
  ogImage={`/og/${D.slug}.png`}
>
<div class="page">

  <div class="titleblock break">
    <div class="kicker">{kicker(D)}</div>
    <div class="hero-grid">
      <h1 set:html={D.headline} />
      <p class="lede">India's jobs number is not a count of jobs. It is a survey of people, what they did last week, what they did last year, and the answer changes depending on how you ask. This guide keeps the three answers side by side.</p>
    </div>
    <div class="meta">
      <span>Source <b>MoSPI, NSO</b></span>
      <span>Frequency <b>Monthly, quarterly, annual</b></span>
      <span>Population <b>Age 15 and above</b></span>
      <span>Coverage <b>All-India &amp; States/UTs</b></span>
      <span>Latest print <b>{PM.long}</b></span>
      <span>Bulletin <b>Monthly, from Apr 2025</b></span>
    </div>
    <div class="numbers">
      <div class="num"><div class="l">Unemployment, monthly, current weekly status (CWS)</div><div class="v acc" id="n-ur" set:html={TX["n-ur"]}></div><div class="d" id="d-ur" set:html={TX["d-ur"]}></div><div class="nspark" id="nspark-ur" set:html={CH.sparkUr()} /></div>
       <div class="num"><div class="l">Participation, LFPR</div><div class="v" id="n-lfpr" set:html={TX["n-lfpr"]}></div><div class="d" id="d-lfpr" set:html={TX["d-lfpr"]}></div></div>
      <div class="num"><div class="l">Urban women, unemployment rate (UR)</div><div class="v" id="n-fur" set:html={TX["n-fur"]}></div><div class="d" id="d-fur" set:html={TX["d-fur"]}></div></div>
      <div class="num"><div class="l">Annual UR, usual status</div><div class="v" id="n-psss" set:html={TX["n-psss"]}></div><div class="d" id="d-psss" set:html={TX["d-psss"]}></div></div>
    </div>
  </div>

  <!-- § 01 current reading -->
  <section>
    <div class="sec-head"><span class="no">01</span><h2>The current reading</h2><span class="line"></span><span class="unit">Monthly bulletin, {PM.long}</span></div>
    <div class="reading-top">
      <div><span class="rk">Current reading</span><div class="big" id="rb-big" set:html={TX["rb-big"]}></div></div>
      <p class="rt-cap">Unemployment rate, {PM.long}: everyone aged 15+ who had no work last week, was looking, and could start. The monthly bulletin is {PM.nWord} months old; treat any single month accordingly.</p>
      <div class="rt-side"><span class="rk">A year into the bulletin</span><div class="rt-side-v" id="rb-first" set:html={TX["rb-first"]}></div></div>
    </div>
    <div class="reading-cols">
      <div class="reading-col">
        <span class="mk">What the print says</span>
        <Prose slot="jobs.current-reading.what-the-print-says" />
      </div>
      <div class="reading-col now">
        <span class="mk">What it does not say</span>
        <Prose slot="jobs.current-reading.what-it-does-not-say" />
      </div>
    </div>
  </section>

  <!-- § 02 register -->
  <section>
    <div class="sec-head"><span class="no">02</span><h2>The register of series</h2><span class="line"></span><span class="unit">Latest, previous</span></div>
    <div class="break ledger">
      <table>
        <thead>
          <tr><th>Series</th><th>Latest</th><th>vs prev.</th><th>Year ago</th><th class="spark">History</th></tr>
        </thead>
        <tbody id="ledger-body" set:html={TX["ledger-body"]}></tbody>
      </table>
    </div>
  </section>

  <!-- § 03 three stopwatches -->
  <section>
    <div class="sec-head"><span class="no">03</span><h2>One question, three stopwatches</h2><span class="line"></span><span class="unit">per cent, annual, agriculture years</span></div>
    <div class="break">
      <figure id="cb-annual" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Last week or last year: the answer depends on the question</h3>
            <div class="sub">All-India unemployment rate, 15+, current weekly status vs usual status (PS+SS), 2017-18 to 2023-24</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-annual" set:html={TX["pv-annual"]}></div><div class="c">2023-24, usual status</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-annual" set:html={CH.annual()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports, agriculture years (Jul–Jun) plotted at July, the gap between the lines is underemployment: work that exists for the year but not for the week</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Ask about the whole year, did you work, more often than not, and 3.2 per cent of the labour force says no. Ask about last week and the answer is roughly double. The vertical distance between these lines is the casualisation of Indian work: hundreds of millions who are employed in principle and idle in practice, week to week.</p>
            <p>Both lines fall through the window. The post-pandemic recovery in work is real, on both stopwatches: the question each answers is simply different.</p>
          </div>
          <div class="now">
            <span class="mk">The annual series ends 2023-24</span>
            <p>Annual usual-status unemployment has nearly halved in six years, from <b id="ex-p0" set:html={TX["ex-p0"]}></b> to <b id="ex-p1" set:html={TX["ex-p1"]}></b>. The weekly measure fell in step and remains near twice the annual one: the recovery closed neither the gap nor the question of job quality.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-lfpr-ann" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Seven years of joining the count</h3>
            <div class="sub">All-India labour force participation rate, 15+, usual status (PS+SS) vs weekly status (CWS), 2017-18 to 2023-24</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-lfpr-ann" set:html={TX["pv-lfpr-ann"]}></div><div class="c">2023-24, usual status</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-lfpr-ann" set:html={CH.lfprAnn()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports, agriculture years (Jul–Jun) plotted at July, the monthly participation plate (§06) runs from Apr 2025; this annual view runs seven years and shows the structural rise the bulletin cannot yet see</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The monthly participation plate in §06 is {PM.nWord} months old and shows a snapshot. This annual companion runs seven agriculture years and shows the trend: participation has climbed steeply and steadily, on both stopwatches. Most of the climb is rural women re-entering the count, through self-employment, as the next section shows, not urban job-seekers flooding in.</p>
            <p>The usual-status line sits above the weekly one because it catches attachment to work across the year, not just the week surveyed. Both rise in lockstep: the recovery in participation is real on either stopwatch.</p>
          </div>
          <div class="now">
            <span class="mk">The annual series ends 2023-24</span>
            <p>Usual-status LFPR rose from <b id="ex-lf0" set:html={TX["ex-lf0"]}></b> to <b id="ex-lf1" set:html={TX["ex-lf1"]}></b>: <b id="ex-lf-d" set:html={TX["ex-lf-d"]}></b> in seven years. The weekly measure rose from <b id="ex-lfc0" set:html={TX["ex-lfc0"]}></b> to <b id="ex-lfc1" set:html={TX["ex-lfc1"]}></b>. No {PC.nWord}-month bulletin could show a shape this clear.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-seam" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>{seamTitle}</h3>
            <div class="sub">Participation (left) and unemployment (right), 15+, usual status (PS+SS), All India: agriculture years 2017-18 to 2023-24, calendar years {cyOldYears[0]} to {cyOldYears.at(-1)} on the original design, and {cyYear} on the revamped design, three rulers, never joined</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-seam" set:html={TX["pv-seam"]}></div><div class="c">{cyYear}, participation, revamped design</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-seam" set:html={CH.seam()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports (agriculture years) and calendar-year estimates, each year drawn at its middle, the dashed rule is January 2025, when MoSPI replaced the survey's sample design and estimation; MoSPI publishes no link between the two designs, so the lines never meet</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>In January 2025 MoSPI rebuilt the survey: a new sample, households visited four months running, villages added to the quarterly count, and annual figures on the calendar year instead of July to June. A new design is a new ruler. Its first year cannot be read as a rise or fall from the old one's last, however tempting the two numbers side by side.</p>
            <p>The agriculture-year and calendar-year lines are the same old survey over two different twelve-month windows, so they overlap and nearly agree. The blue dot is the new survey's first full year. Where it sits next to the grey lines says how differently the two rulers read the same country, not what happened to jobs.</p>
          </div>
          <div class="now">
            <span class="mk">As of the {cyYear} calendar-year estimates</span>
            <p>The original design's last calendar year, {cyOldYears.at(-1)}, put usual-status participation at {f1(sL0)}% and unemployment at {f1(sU0)}%. The revamped design's {cyYear} reads {f1(sL1)}% and {f1(sU1)}%. We do not know how much of the difference is the economy and how much the ruler: MoSPI has published no year measured both ways.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 04 plate 1 -->
  <section>
    <div class="sec-head"><span class="no">04</span><h2>Plate 1: the long arc, and the whole country since 2025</h2><span class="line"></span><span class="unit">per cent, quarterly, CWS</span></div>
    <div class="break">
      <figure id="cb-main" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Seven years of urban unemployment, including the quarter everything stopped, then a new survey</h3>
            <div class="sub">Urban unemployment rate, 15+, current weekly status: the original quarterly bulletin, Apr–Jun 2018 to {qLabel(qDates.at(-1))}, beside the revamped survey's urban figure from {qn(q25First)}, two rulers, never joined</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-main" set:html={TX["pv-main"]}></div><div class="c">{qn(q25Last)}, urban, revamped design</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-main" set:html={CH.main()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS quarterly bulletins, gaps: Apr–Jun 2019 (a mislabelled source cell, the published figure is 8.9; quarantined, disclosed in metadata) and Jan–Mar 2025 (never published: the survey was redesigned that quarter), the dashed rule marks January 2025, the redesign</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The quarterly bulletin was the oldest continuous stopwatch: urban India, last-week status, from 2018 to the end of 2024. The spike is the lockdown quarter: one urban worker in five counted unemployed in April–June 2020. What matters after the spike is the slow grind down: six years to retrace a few points.</p>
            <p>From April–June 2025 the bulletin runs on the new survey design. Its urban line is drawn beside the old one, not joined to it: the two read the same cities through different samples, and the closeness of the levels is not proof that they agree.</p>
          </div>
          <div class="now">
            <span class="mk">As of the {qn(q25Last)} quarter</span>
            <p>On the original design the urban rate ended at <b id="ex-q1" set:html={TX["ex-q1"]}></b> in {qLabel(qDates.at(-1))}, against <b id="ex-q0" set:html={TX["ex-q0"]}></b> when the bulletin began; in its last twelve quarters it held between {Math.min(...q12).toFixed(1)}% and {Math.max(...q12).toFixed(1)}%. The revamped survey reads urban unemployment at <b id="ex-q25u" set:html={TX["ex-q25u"]}></b> in {qn(q25Last)}.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-q25" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>{q25Title}</h3>
            <div class="sub">Unemployment rate, 15+, current weekly status, rural, urban and all India, revamped design, {qn(q25First)} to {qn(q25Last)}</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-q25" set:html={TX["pv-q25"]}></div><div class="c">{qn(q25Last)}, all India</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-q25" set:html={CH.q25()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS quarterly bulletin (revamped design), all India, persons 15+, CWS</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Before 2025 the quarterly count stopped at the city limits. Now it covers the whole country, every quarter. Rural unemployment prints lower because village work is mostly the family farm or the family shop: a person helping on the land counts as working, even in a lean week. The rural line moves with the seasons; read it a year at a time, not quarter to quarter.</p>
          </div>
          <div class="now">
            <span class="mk">As of {qn(q25Last)}</span>
            <p>Unemployment reads <b id="ex-q25a" set:html={TX["ex-q25a"]}></b> for the country, <b id="ex-q25r" set:html={TX["ex-q25r"]}></b> in villages and <b id="ex-q25ub" set:html={TX["ex-q25ub"]}></b> in towns and cities. Participation is <b id="ex-q25l" set:html={TX["ex-q25l"]}></b>.{q25YearAgo >= 0 ? ` A year earlier, in ${qn(q25Dates[q25YearAgo])}, unemployment read ${f1(q25S["ur_cws" + H].data[q25YearAgo])}% and participation ${f1(q25S["lfpr_cws" + H].data[q25YearAgo])}%: the first comparison the new survey allows that the seasons cannot distort.` : " The series is too young for a same-quarter comparison a year apart."}</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-ystates" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>{YS[0].name}'s young people face the longest queue for work; {YS.at(-1).name}'s the shortest</h3>
            <div class="sub">Unemployment rate, ages 15 to 29 (dark dot) beside everyone 15 and above (pale dot), rural + urban, CWS, the {DATA.youthStates.length} states the bulletin publishes, {qn(q25Last)}</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-ystates" set:html={TX["pv-ystates"]}></div><div class="c">{qn(q25Last)}, ages 15 to 29, all India</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-ystates" set:html={CH.ystates()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS quarterly bulletin (revamped design), state tables, the vertical rule is the all-India youth rate; state figures rest on smaller samples than all-India ones, so a one-quarter move of a few points can be noise</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The gap between the two dots on a row is how much harder it is to be young and looking for work in that state. Everywhere the young dot sits to the right: a first job is the hardest one to find, and a young person with a family to fall back on can afford to wait for a better offer. The widest gaps are in states with many educated young people and few salaried openings near home.</p>
          </div>
          <div class="now">
            <span class="mk">As of {qn(q25Last)}</span>
            <p>Among 15-to-29-year-olds, {YS[0].name} prints {f1(YS[0].y)}% and {YS.at(-1).name} {f1(YS.at(-1).y)}%, around an all-India youth rate of {f1(DATA.youthAi.y)}%, against {f1(DATA.youthAi.all)}% for everyone 15 and above. In a classroom of twenty young people looking for work in {YS[0].name}, about {word(Math.round(YS[0].y / 5))} would be without it.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 05 the measure -->
  <section>
    <div class="sec-head"><span class="no">05</span><h2>What this measures</h2><span class="line"></span></div>
    <div class="wm-grid">
      <div>
        <p>Three ratios, one survey. The labour force is everyone working or actively seeking work. The participation rate, LFPR, is that group as a share of the population. The worker-population ratio is the share actually working. Unemployment is the gap between them: seekers as a share of seekers-plus-workers. When we say unemployment is 5.5 per cent, we mean <b>5.5 per cent of the labour force</b>: not of the country.</p>
        <p>The status questions do the real work. Usual status asks about the reference year and catches attachment to work; current weekly status asks about the seven days before the surveyor's knock and catches idleness inside employment. India publishes both because both are true.</p>
        <p>And it is a survey: sample-based, household by household. The monthly bulletin is young, the quarterly one was urban-only until 2025, and the annual one ran on agriculture years until 2024. They are different instruments, and this guide never splices them into one line.</p>
        <p>In January 2025 MoSPI redesigned the survey itself. The new sample visits each household four months running, covers villages every quarter, and reports the year January to December. Everything before is one ruler (the original design: agriculture years 2017-18 to 2023-24, calendar years {cyOldYears[0]} to {cyOldYears.at(-1)}, the urban quarterly bulletin to the end of 2024); everything since is another. This guide draws them side by side with a marked seam (§03, §04) and never reads a change across it as a change in the labour market.</p>
        <p>Two other guides read Indian work from different angles. <a href="/guides/ilo/">Work, as the ILO counts it</a> holds two other readings: the International Labour Organization's modelled estimates, which fill the years no survey covered so every country sits on one definition, and the ILO's own recomputation of PLFS unit data on its definitions. Both differ from the figures here, which are MoSPI's own tables as published, and both are right about what they measure. <a href="/guides/services/">Services</a> takes PLFS's industry tables for the service trades. This guide is the survey itself, at every cut MoSPI serves.</p>
      </div>
      <div class="wm-rail">
        <aside class="margin-note">
          <span class="mk">Margin note, i</span>
          <b>Unemployment needs a seeker.</b> A person who stops looking leaves the labour force: and the rate falls without a single job created. Read UR beside LFPR, always. </aside>
        <aside class="margin-note">
          <span class="mk">Margin note, ii</span>
          <b>Low is not the same as good.</b> In an informal economy, open unemployment is a luxury good. The Indian rate understates distress by construction.
        </aside>
        <aside class="margin-note">
          <span class="mk">Margin note, iii</span>
          <b>Bad cells, quarantined.</b> MoSPI's data service carries a mislabelled 2019 quarter, values garbled by character recognition ("l0.8" for 10.8) and two quarters whose state labels slipped one row. Every such cell is withheld, said so on its series, and kept in the raw archive.
        </aside>
        <aside class="margin-note">
          <span class="mk">Margin note, iv</span>
          <b>A new survey is a new ruler.</b> The January 2025 redesign changed the sample and the year. A 2025 figure beside a 2024 one is two instruments, not a trend.
        </aside>
      </div>
    </div>
  </section>

  <!-- § 06 component plates -->
  <section>
    <div class="sec-head"><span class="no">06</span><h2>The parts, one plate each</h2><span class="line"></span><span class="unit">per cent, monthly bulletin</span></div>

    <div class="break">
      <figure id="cb-cuts" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Four labour markets in one country</h3>
            <div class="sub">Unemployment rate by gender × sector, CWS, {PC.span}</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-cuts" set:html={TX["pv-cuts"]}></div><div class="c">{PC.short}, urban women</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-cuts" set:html={CH.cuts()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS monthly bulletin, 15+, current weekly status</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The national rate is an average of four very different markets. Urban women seek work in a market twice as tight as urban men's; the rural lines bunch lower, where work is seasonal, family-based and rarely "sought" in the survey's sense. The monthly bulletin is young, so read the levels more than the wiggles.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PC.stamp}</span>
            <p>Urban women: <b id="ex-fu" set:html={TX["ex-fu"]}></b>. Urban men: <b id="ex-mu" set:html={TX["ex-mu"]}></b>. {minGap >= 2 ? `The gap has stayed above two points in every one of the bulletin's ${PC.nWord} months: a structure, not a fluctuation.` : `The gap has ranged from ${minGap.toFixed(1)} to ${Math.max(...urGap).toFixed(1)} points over the bulletin's ${PC.nWord} months.`}</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-lfpr" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>The participation chasm</h3>
            <div class="sub">Labour force participation rate by gender × sector, CWS, {PC.span}</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-lfpr" set:html={TX["pv-lfpr"]}></div><div class="c">{PC.short}, urban women</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-lfpr" set:html={CH.lfpr()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS monthly bulletin, share of the population working or seeking work</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>This is the more important chart. Three-quarters of urban men are in the labour force; one urban woman in four is. Rural women participate more, farm and family enterprise absorb labour the city does not, but still at barely half the male rate. No single policy moves this line; childcare, safety, transport and social permission all move it at once.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PC.stamp}</span>
            <p>Urban women's participation: <b id="ex-fl" set:html={TX["ex-fl"]}></b>. Over the bulletin's {PC.nWord} months it has moved only between {Math.min(...lfFU).toFixed(1)}% and {Math.max(...lfFU).toFixed(1)}%. Its gap to urban men's participation, {(lastC("lfpr_male_urban") - lastC("lfpr_female_urban")).toFixed(1)} points, is the widest in this cut.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-wpr" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Who is actually working</h3>
            <div class="sub">Worker population ratio by gender × sector, CWS, {PC.span}, the gap between this line and the participation line above is the unemployment rate</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-wpr" set:html={TX["pv-wpr"]}></div><div class="c">{PC.short}, urban men</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-wpr" set:html={CH.wpr()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS monthly bulletin, the share of the population actually at work, distinct from the share willing to work (LFPR)</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Participation asks who is in the pool; this asks who is actually in a job. The two lines move together for men, because most men who want work find it. They part sharply for women: many women counted as participating are still searching, so the WPR line sits well below the LFPR line. That vertical gap, read alongside the UR plate, is the unemployment rate made visible.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PC.stamp}</span>
            <p>Of urban men, {lastC("wpr_male_urban").toFixed(1)}% are at work, against {lastC("wpr_female_urban").toFixed(1)}% of urban women. The male lines hold steady; the female lines are where a recovering labour market would show it: a WPR rising without LFPR rising means existing seekers are finding work, not new ones joining.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-youth" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Young women in cities queue longest for work</h3>
            <div class="sub">Unemployment rate, ages 15 to 29, by gender and sector, current weekly status, monthly bulletin, {PC.span}</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-youth" set:html={TX["pv-youth"]}></div><div class="c">{PC.short}, young urban women</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-youth" set:html={CH.youth()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS monthly bulletin, ages 15 to 29, the age band the bulletin publishes beside 15+ and all ages</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The same four labour markets as the plates above, for the young alone. Every line sits well above its 15+ cousin: the young are new to the queue, and many are waiting for a particular kind of job. The top line is the one to watch: young women in towns and cities, often educated, looking for work that is safe, near home and salaried, and finding it rarely.</p>
          </div>
          <div class="now">
            <span class="mk">As of {PC.stamp}</span>
            <p>Among the young, urban women print <b id="ex-y-fu" set:html={TX["ex-y-fu"]}></b>, urban men <b id="ex-y-mu" set:html={TX["ex-y-mu"]}></b>, rural women <b id="ex-y-fr" set:html={TX["ex-y-fr"]}></b> and rural men <b id="ex-y-mr" set:html={TX["ex-y-mr"]}></b>; all young people together, <b id="ex-y-all" set:html={TX["ex-y-all"]}></b>. Of young urban women looking for work, about one in <b id="ex-y-one" set:html={TX["ex-y-one"]}></b> has none.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 07 what work is -->
  <section>
    <div class="sec-head"><span class="no">07</span><h2>What work is</h2><span class="line"></span><span class="unit">share of workers, per cent, annual reports</span></div>

    <div class="break basket">
      <div class="bar" id="bk-st-bar" set:html={TX["bk-st-bar"]}></div>
      <div class="labels" id="bk-st-labels" set:html={TX["bk-st-labels"]}></div>
    </div>
    <div class="break basket" style="margin-top:26px">
      <div class="bar" id="bk-in-bar" set:html={TX["bk-in-bar"]}></div>
      <div class="labels" id="bk-in-labels" set:html={TX["bk-in-labels"]}></div>
      <p class="note">Two ways to split the same workforce, 2023-24. By status: a majority works for itself. By industry: the farm still employs more Indians than any other place: on the weekly stopwatch, where seasonal work is counted as it happens.</p>
    </div>

    <div class="break" style="margin-top:72px">
      <figure id="cb-status" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>The self-employed majority, the salaried minority</h3>
            <div class="sub">Share of workers by broad status in employment, 15+, usual status (PS+SS), 2017-18 to 2023-24</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-status" set:html={TX["pv-status"]}></div><div class="c">2023-24, self-employed share</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-status" set:html={CH.status()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports, shares of all workers, person, rural + urban, the three statuses sum to 100, agriculture years plotted at July</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The unemployment rate counts people without work. This plate counts the kinds of work the employed actually have. Self-employment, the farm, the shop, the loom, is the Indian norm; the salaried payroll job is the minority; casual labour is the day-rate rest. The underemployment gap in §03 lives here: own-account work absorbs people a payroll never would, at whatever the week offers.</p>
            <p>Rising self-employment is not simply rising enterprise. Part of it is unpaid: helpers in household enterprises are counted as self-employed workers, and earn no separate wage at all.</p>
          </div>
          <div class="now">
            <span class="mk">The 2023-24 register</span>
            <p>Self-employment is <b id="ex-st-se" set:html={TX["ex-st-se"]}></b> of all workers: <b id="ex-st-oa" set:html={TX["ex-st-oa"]}></b> own-account and employers, <b id="ex-st-hp" set:html={TX["ex-st-hp"]}></b> household helpers. Regular wage work is <b id="ex-st-rg" set:html={TX["ex-st-rg"]}></b>; casual labour <b id="ex-st-cs" set:html={TX["ex-st-cs"]}></b>. Since 2017-18 the self-employed share has risen <b id="ex-st-dse" set:html={TX["ex-st-dse"]}></b> while casual work fell <b id="ex-st-dcs" set:html={TX["ex-st-dcs"]}></b>: the recovery in work has been a movement into working for oneself, not onto payrolls.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-gender" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>The same workforce, asked by gender</h3>
            <div class="sub">Share of workers by status in employment, usual status (PS+SS), men (left) vs women (right), 2017-18 to 2023-24, same colours, same scale</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-gender" set:html={TX["pv-gender"]}></div><div class="c">2023-24, women self-employed</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-gender" set:html={CH.gender()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports, shares of all male and all female workers separately, each panel sums to 100, same three colours as the person-level plate above, agriculture years plotted at July</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Split the person-level plate above by gender and the averages dissolve. Men hold steady across the three statuses: roughly half self-employed, a quarter salaried, a fifth casual, barely moving in seven years. Women do not. Female self-employment has climbed fifteen points, almost entirely into unpaid household-enterprise helper roles; female regular-wage work has fallen by five. Women are not joining the salaried minority: they are joining the family firm.</p>
            <p>Read the two right-hand lines together: female casual labour has fallen faster than male. The woman leaving casual work is not moving to a salary; she is moving to a family enterprise that pays no separate wage at all.</p>
          </div>
          <div class="now">
            <span class="mk">The 2023-24 register, by gender</span>
            <p>Self-employment: <b id="ex-g-se-m" set:html={TX["ex-g-se-m"]}></b> of men, <b id="ex-g-se-f" set:html={TX["ex-g-se-f"]}></b> of women: up from <b id="ex-g-se-f0" set:html={TX["ex-g-se-f0"]}></b> in 2017-18. Regular wage: <b id="ex-g-rg-m" set:html={TX["ex-g-rg-m"]}></b> of men against <b id="ex-g-rg-f" set:html={TX["ex-g-rg-f"]}></b> of women. Casual labour: <b id="ex-g-cs-m" set:html={TX["ex-g-cs-m"]}></b> of men, <b id="ex-g-cs-f" set:html={TX["ex-g-cs-f"]}></b> of women. The female self-employment line is the structural story behind the participation rise in §03.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-kinds" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>In {DATA.kinds.filter((r) => r.rg < 30).length} of {DATA.kinds.length} states and UTs, fewer than three workers in ten draw a regular wage</h3>
            <div class="sub">Share of workers in regular wage or salaried jobs (dark dot) and in casual labour (pale dot), every state and UT, 15+, usual status (PS+SS), rural + urban, {cyYear}; the rest are self-employed</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-kinds" set:html={TX["pv-kinds"]}></div><div class="c">{cyYear}, spread in salaried share, highest to lowest</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-kinds" set:html={CH.kinds()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS calendar-year estimates (revamped design), share of all workers in each state, the three statuses add to 100; NIC section, occupation and enterprise-type shares for every state are in the every-cut table below</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Each row is a state, sorted by the share of its workers with a regular wage or salary: a payslip every month, whatever its size. The pale dot is casual labour, work hired by the day. Whatever is left of a hundred is self-employment: the farm, the shop, the auto-rickshaw. Small, urban territories sit at the top because their economies are offices and services; the large farming states sit low, where most people work for themselves.</p>
          </div>
          <div class="now">
            <span class="mk">As of the {cyYear} estimates</span>
            <p>{KIND[0].name} has {f1(KIND[0].rg)}% of its workers on a regular wage; {KIND.at(-1).name}, {f1(KIND.at(-1).rg)}%. Among the ten most populous states, {byDesc(DATA.kinds.filter((r) => ["Uttar Pradesh", "Bihar", "Maharashtra", "West Bengal", "Madhya Pradesh", "Rajasthan", "Tamil Nadu", "Karnataka", "Gujarat", "Andhra Pradesh"].includes(r.name)), "rg")[0].name} has the largest salaried share and {byDesc(DATA.kinds.filter((r) => ["Uttar Pradesh", "Bihar", "Maharashtra", "West Bengal", "Madhya Pradesh", "Rajasthan", "Tamil Nadu", "Karnataka", "Gujarat", "Andhra Pradesh"].includes(r.name)), "rg").at(-1).name} the smallest. Casual labour is largest in {byDesc(DATA.kinds, "cs")[0].name}, at {f1(byDesc(DATA.kinds, "cs")[0].cs)}%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 08 what work pays -->
  <section>
    <div class="sec-head"><span class="no">08</span><h2>What work pays</h2><span class="line"></span><span class="unit">₹, nominal, annual reports, quarterly grain</span></div>

    <div class="break">
      <figure id="cb-pay" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>The pay hierarchy: a month of work, four prices</h3>
            <div class="sub">Regular wage/salary earnings (₹ per month) and gross earnings from self-employment (₹ per 30 days), by gender, rural + urban, 2017-18 to 2023-24</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-pay" set:html={TX["pv-pay"]}></div><div class="c">Apr–Jun 2024, regular wage, person</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-pay" set:html={CH.pay()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports, nominal ₹, all-India, regular wages are per month, self-employment earnings per 30 days, near-equal windows, plotted together; the casual day-rate has its own plate below, 2017-18 all-India aggregates quarantined (see provenance)</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The unemployment rate says who lacks work. This plate says what the work that exists is worth. Four lines, one shape: the salaried man on top; the salaried woman and the self-employed man close enough to trade places; the self-employed woman far beneath all three. The gaps are the structure: they have not closed anywhere in the window.</p>
            <p>These are nominal rupees. Some of the climb is pay; some is the price level climbing with it.</p>
          </div>
          <div class="now">
            <span class="mk">As of Apr–Jun 2024</span>
            <p>A regular job pays <b id="ex-pay-rg" set:html={TX["ex-pay-rg"]}></b> a month for men, <b id="ex-pay-rgf" set:html={TX["ex-pay-rgf"]}></b> for women. Self-employment grosses <b id="ex-pay-se" set:html={TX["ex-pay-se"]}></b> per 30 days for men and <b id="ex-pay-sef" set:html={TX["ex-pay-sef"]}></b> for women: the widest gap on the plate, roughly <b id="ex-pay-ratio" set:html={TX["ex-pay-ratio"]}></b> between the salaried man and the self-employed woman. Most of the self-employed majority in §07 lives on the lower two lines.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-casual" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>The casual day</h3>
            <div class="sub">Average wage per day from casual labour, other than public works, rural + urban, 2017-18 to 2023-24</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-casual" set:html={TX["pv-casual"]}></div><div class="c">Apr–Jun 2024, person, per day</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-casual" set:html={CH.casual()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports, nominal ₹ per day, all-India, casual work is priced by the day, so it is never drawn on the monthly axis above</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>This is the price of a day's labour for the fifth of Indian workers hired by the day. It has no leave, no contract and no next week attached. The male and female lines never touch: the day is priced differently depending on whose it is.</p>
          </div>
          <div class="now">
            <span class="mk">As of Apr–Jun 2024</span>
            <p>A casual day pays <b id="ex-cas-p" set:html={TX["ex-cas-p"]}></b>: <b id="ex-cas-m" set:html={TX["ex-cas-m"]}></b> for men, <b id="ex-cas-f" set:html={TX["ex-cas-f"]}></b> for women. Seven years earlier it paid <b id="ex-cas-0" set:html={TX["ex-cas-0"]}></b>; the rise is <b id="ex-cas-r" set:html={TX["ex-cas-r"]}></b> in nominal terms, over years in which the cost of living rose too. At twenty-six days a month, the casual month comes to <b id="ex-cas-mo" set:html={TX["ex-cas-mo"]}></b>: about half the salaried one.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-paystates" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>A regular job pays {inr0(PAY[0].p)} a month in {PAY[0].name} and {inr0(PAY.at(-1).p)} in {PAY.at(-1).name}</h3>
            <div class="sub">Average monthly earnings from regular wage or salaried work, all workers (dark dot) and women (pale dot), every state and UT, rural + urban, {cyYear}, nominal ₹</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-paystates" set:html={TX["pv-paystates"]}></div><div class="c">{cyYear}, all India, regular wage, a month</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-paystates" set:html={CH.paystates()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS calendar-year estimates (revamped design), wage or salary earned in the calendar month before the survey, the vertical rule is the all-India average; small UTs rest on few sampled workers; casual day wages and self-employment earnings for every state and sector are in the every-cut table below</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>The same kind of job, a regular wage or salary, pays very differently depending on where it is. The top of the strip is mostly small territories and the north-east, where government and organised employers are a large share of the few salaried jobs. The big farming states pay least. The pale dot, women's pay, sits left of the dark one in almost every row.</p>
            <p>These are nominal rupees, and the cost of living differs by state as well. A rupee buys more rent in Bihar than in Delhi.</p>
          </div>
          <div class="now">
            <span class="mk">As of the {cyYear} estimates</span>
            <p>A regular job pays <b id="ex-ps-ai" set:html={TX["ex-ps-ai"]}></b> a month across India: <b id="ex-ps-m" set:html={TX["ex-ps-m"]}></b> for men and <b id="ex-ps-f" set:html={TX["ex-ps-f"]}></b> for women. A casual day pays most in {CAS[0].name}, {inr0(CAS[0].cas)}, and least in {CAS.at(-1).name}, {inr0(CAS.at(-1).cas)}: the same day's labour, priced {f1(CAS[0].cas / CAS.at(-1).cas)} times higher in one state than another.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-cond" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>More salaried workers have a written contract; the share with no protection at all has {condY("none_of_three__person_all", -1) >= condY("none_of_three__person_all", 0) ? "not fallen" : "barely fallen"}</h3>
            <div class="sub">Per cent of regular wage or salaried employees with no written job contract, not eligible for paid leave, without any social security benefit, and with none of the three, all India, usual status, agriculture years {agri(condFirst)} to {agri(condLast)}</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-cond" set:html={TX["pv-cond"]}></div><div class="c">{agri(condLast)}, none of the three</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-cond" set:html={CH.cond()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports, regular wage or salaried employees (usual status), agriculture years plotted at July; every state, gender and sector is in the every-cut table below</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>A regular job is the best kind of work the survey counts, and still, for many, it comes without a contract, without paid leave and without provident fund, pension or health cover. The blue line is the hard core: employees with none of the three. It is the share of India's "good jobs" that a sick week or a manager's whim can end without notice or pay.</p>
          </div>
          <div class="now">
            <span class="mk">As of {agri(condLast)}</span>
            <p>Regular employees without a written contract fell from <b id="ex-c-nc0" set:html={TX["ex-c-nc0"]}></b> to <b id="ex-c-nc1" set:html={TX["ex-c-nc1"]}></b>. Those with none of the three protections were <b id="ex-c-n0" set:html={TX["ex-c-n0"]}></b> in {agri(condFirst)} and <b id="ex-c-n1" set:html={TX["ex-c-n1"]}></b> in {agri(condLast)}. Of every ten salaried workers, about <b id="ex-c-ten" set:html={TX["ex-c-ten"]}></b> still have no contract, no paid leave and no social security. These tables end with the original design: the revamped survey's calendar-year contract table is served without its labels, so it cannot be read (see the provenance notes).</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 09 the educated queue -->
  <section>
    <div class="sec-head"><span class="no">09</span><h2>The educated queue</h2><span class="line"></span><span class="unit">per cent, annual, usual status</span></div>
    <div class="break">
      <figure id="cb-edu" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Unemployment climbs the ladder of degrees</h3>
            <div class="sub">Unemployment rate by general education level, 15+, usual status (PS+SS), 2023-24, with 2017-18 as pale dots</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-edu" set:html={TX["pv-edu"]}></div><div class="c">2023-24, graduates</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-edu" set:html={CH.edu()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual reports, all-India, person, rural + urban, 15+, rows in ladder order, not sorted by value, the vertical rule is the all-India rate, every level of education together</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>In most rich countries, unemployment falls as schooling rises. In India it rises with every rung. The reason is the denominator's cousin from §05: open unemployment needs a seeker who can wait. A worker who never went to school cannot afford a jobless week and takes whatever the day offers; a graduate, often young, often with a family behind them, queues for the formal post the degree was meant to buy. The ladder measures who can afford to search, and who cannot afford not to work.</p>
          </div>
          <div class="now">
            <span class="mk">The 2023-24 register</span>
            <p>Graduate unemployment prints at <b id="ex-edu-g" set:html={TX["ex-edu-g"]}></b> against <b id="ex-edu-nl" set:html={TX["ex-edu-nl"]}></b> for those who never learned to read: <b id="ex-edu-x" set:html={TX["ex-edu-x"]}></b> the rate, in the same country, the same year. The queue is young as well as educated: among 15-to-29-year-olds the rate is <b id="ex-edu-y" set:html={TX["ex-edu-y"]}></b>, against <b id="ex-edu-all" set:html={TX["ex-edu-all"]}></b> for everyone 15 and above. The concession the window offers: the graduate rate has fallen from <b id="ex-edu-g0" set:html={TX["ex-edu-g0"]}></b> in 2017-18, and the youth rate from <b id="ex-edu-y0" set:html={TX["ex-edu-y0"]}></b>.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-social" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>{socTitle}</h3>
            <div class="sub">Labour force participation rate, 15+, usual status (PS+SS), rural + urban, by social group and by religion, women (dark dot) beside men (pale dot), all India, {cyYear}</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-social" set:html={TX["pv-social"]}></div><div class="c">{cyYear}, all women 15+</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-social" set:html={CH.social()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS calendar-year estimates (revamped design), all India; social groups are the survey's: Scheduled Tribe, Scheduled Caste, Other Backward Class and "others", the groups outside the three; religions are the four the survey publishes, the vertical rule is all women</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Men's participation barely varies by caste or creed: about four men in five work or seek work, whatever their group. Women's varies enormously. Tribal women work most, often on their own land and forest produce, in communities where women's work outside the home carries less stigma. As social rank rises, a household's standing can come to rest on keeping its women at home, and participation falls. The religion rows tell a similar story about social norms, not ability or willingness.</p>
            <p>"Others" in the survey means households outside the Scheduled Tribes, Scheduled Castes and Other Backward Classes: largely, though not only, the upper castes.</p>
          </div>
          <div class="now">
            <span class="mk">As of the {cyYear} estimates</span>
            <p>Of every hundred women aged 15 and above, {Math.round(soc("female", "soc_scheduled_tribe"))} in tribal households are working or seeking work, {Math.round(soc("female", "soc_scheduled_caste"))} in Dalit households, {Math.round(soc("female", "soc_other_backward_class"))} in OBC households and {Math.round(soc("female", "soc_others"))} in the rest. By religion: Christian women {f1(soc("female", "rel_christianity"))}%, Hindu {f1(soc("female", "rel_hinduism"))}%, Sikh {f1(soc("female", "rel_sikhism"))}%, Muslim {f1(soc("female", "rel_islam"))}%. Men range only from {f1(Math.min(...["soc_scheduled_tribe", "soc_scheduled_caste", "soc_other_backward_class", "soc_others", "rel_hinduism", "rel_islam", "rel_christianity", "rel_sikhism"].map((k) => soc("male", k))))}% to {f1(Math.max(...["soc_scheduled_tribe", "soc_scheduled_caste", "soc_other_backward_class", "soc_others", "rel_hinduism", "rel_islam", "rel_christianity", "rel_sikhism"].map((k) => soc("male", k))))}%.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 10 states -->
  <section>
    <div class="sec-head"><span class="no">10</span><h2>A country of labour markets</h2><span class="line"></span><span class="unit">per cent, annual, States/UTs</span></div>
    <div class="break">
      <figure id="cb-states" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Thirty-six markets, one national average</h3>
            <div class="sub">Unemployment rate by State/UT, 15+, usual status (PS+SS) beside weekly status (CWS), 2023-24</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-states" set:html={TX["pv-states"]}></div><div class="c">2023-24, spread, highest to lowest, PS+SS</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-states" set:html={CH.states()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS annual report 2023-24, States/UTs, 15+, rural + urban, usual status sorts the strip; the pale dot is the same year on the weekly stopwatch, paired, never averaged, Dadra &amp; Nagar Haveli and Daman &amp; Diu merged in 2020 and appear as one UT</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>Each row is a State or Union Territory, sorted by the annual usual-status rate: the dark dot. The pale dot is the same year asked about last week instead; the two stopwatches sit side by side and are never averaged. The vertical rule is All-India. Blue marks the places printing at twice the national rate or more.</p>
            <p>The top of the strip is not simply distress, and the bottom is not simply health. Open unemployment needs a seeker who can afford to wait: Kerala's graduates queue for formal work and are counted; Gujarat's farms and workshops absorb almost everyone at some wage, and the queue never forms. A high rate can mean a labour market worth waiting for. A low one can mean an economy too poor to permit the wait. The strip ranks the searching, not the suffering.</p>
          </div>
          <div class="now">
            <span class="mk">The 2023-24 register</span>
            <p>The spread is the story. The highest usual-status rate is <b id="st-max" set:html={TX["st-max"]}></b> and the lowest <b id="st-min" set:html={TX["st-min"]}></b>: <b id="st-spread" set:html={TX["st-spread"]}></b> apart, around an All-India figure of <b id="st-ai" set:html={TX["st-ai"]}></b>. Kerala stands at <b id="st-kerala" set:html={TX["st-kerala"]}></b> against Gujarat's <b id="st-gujarat" set:html={TX["st-gujarat"]}></b>: one educated labour force searching, one informal economy absorbing. Of the thirty-six, <b id="st-nout" set:html={TX["st-nout"]}></b> cross twice the national rate.</p>
            <p>Against 2022-23, the largest fall is <b id="st-fall" set:html={TX["st-fall"]}></b>; the largest rise is <b id="st-rise" set:html={TX["st-rise"]}></b>. A one-year state move in a sample survey deserves suspicion before applause: the small UTs swing hardest for exactly that reason.</p>
          </div>
        </div>
      </figure>
    </div>

    <div class="break" style="margin-top:104px">
      <figure id="cb-work" style="margin:0">
        <div class="plate-head">
          <div class="t">
            <h3>Men work at much the same rate everywhere; women's work is what separates the states</h3>
            <div class="sub">Worker population ratio (the share of people aged 15+ who are working), women (dark dot) and men (pale dot), every state and UT, usual status (PS+SS), rural + urban, {cyYear}, sorted by women</div>
          </div>
          <div class="plate-val"><div class="v" id="pv-work" set:html={TX["pv-work"]}></div><div class="c">{cyYear}, women at work, highest to lowest state</div></div>
        </div>
        <div class="frame">
          <div class="plotzone" id="plot-work" set:html={CH.work()} />
          <div class="plotfoot">
            <span class="src">Source: MoSPI, PLFS calendar-year estimates (revamped design), the vertical rule is all-India women; every state's participation, worker and unemployment rates by gender, sector, age band and education level, on both designs, are in the every-cut table below</span>
            <span class="dl"><button data-dl="svg">SVG</button><span class="sep"></span><button data-dl="png">PNG</button><span class="sep"></span><button data-dl="csv">CSV</button><span class="sep"></span><a href="https://www.mospi.gov.in" target="_blank" rel="noopener">Source ↗</a></span>
          </div>
        </div>
        <div class="explain">
          <div class="ev">
            <span class="mk">How to read this</span>
            <p>This is the answer to "how many people in my state work". Read along a row: the pale dot is the share of the state's men aged 15 and over who are working, the dark dot the share of its women. The men's dots form a tight column. The women's dots scatter across the chart. States where women farm their own land, trade and gather forest produce sit near the top; states where women's work outside the home is rarer, and the city-territories, sit near the bottom.</p>
          </div>
          <div class="now">
            <span class="mk">As of the {cyYear} estimates</span>
            <p>In {W[0].name}, {Math.round(W[0].f)} of every hundred women aged 15 and above are working; in {W.at(-1).name}, {Math.round(W.at(-1).f)}. Across India it is {Math.round(DATA.workAi.f)} women in a hundred, against {Math.round(DATA.workAi.m)} men. The spread between states is {f1(W[0].f - W.at(-1).f)} points for women and {f1(Math.max(...DATA.work.map((r) => r.m)) - Math.min(...DATA.work.map((r) => r.m)))} for men.</p>
          </div>
        </div>
      </figure>
    </div>
  </section>

  <!-- § 11 misread -->
  <section>
    <div class="sec-head"><span class="no">11</span><h2>How to misread this number</h2><span class="line"></span></div>
    <ul class="misread">
      <li>
        <span class="no">i.</span>
        <div>
          <h3>"Unemployment is 5.5%, so 94.5% have jobs."</h3>
          <p>The denominator is the labour force, not the population. The employed share of everyone aged 15+ is the worker-population ratio, and it is only a little over half: participation itself runs in the mid-fifties. Nearly half the working-age population is outside the count entirely, most of them women.</p>
        </div>
      </li>
      <li>
        <span class="no">ii.</span>
        <div>
          <h3>"The rate fell, so things improved."</h3>
          <p>Maybe. Or seekers gave up and left the labour force, which also lowers the rate. The pair to watch is unemployment <em>and</em> participation; one without the other is a Rorschach test.</p>
        </div>
      </li>
      <li>
        <span class="no">iii.</span>
        <div>
          <h3>"The monthly, quarterly and annual numbers disagree."</h3>
          <p>They measure differently: last week versus the usual year, urban-only versus all-India. A weekly urban rate beside an annual all-India rate is not a contradiction; it is two instruments reading two things. Never chart them as one line.</p>
        </div>
      </li>
      <li>
        <span class="no">iv.</span>
        <div>
          <h3>"3% unemployment is full employment."</h3>
          <p>Open unemployment in India is rationed by poverty: most people cannot afford to seek without working. The usual-status rate coexists with vast underemployment, which is precisely the gap between the two stopwatches in §03.</p>
        </div>
      </li>
      <li>
        <span class="no">v.</span>
        <div>
          <h3>"The survey counts the informal sector."</h3>
          <p>It counts <em>people</em>, including the informally employed: but employment here is a yes, not a description. A street vendor working two hours a day is employed in these tables. The annual reports do price the work and count the contracts, paid leave and social security that come with salaried jobs (§08). A job and a good job are different facts.</p>
        </div>
      </li>
      <li>
        <span class="no">vi.</span>
        <div>
          <h3>"Unemployment changed between 2024 and 2025."</h3>
          <p>Perhaps, but the survey cannot tell you. In January 2025 MoSPI replaced the sample and the method; the 2025 figures come from a different instrument. A difference across that line mixes the economy with the ruler, and MoSPI has published no year measured both ways that would separate them (§03).</p>
        </div>
      </li>
      <li>
        <span class="no">vii.</span>
        <div>
          <h3>"My state's unemployment jumped this quarter."</h3>
          <p>A state's quarterly figure rests on a few thousand households, so a move of a point or two is often sampling noise. And check the source table itself: twice since 2025 MoSPI's data service has served state figures under the wrong state's name. This guide withholds those quarters and says so on each series.</p>
        </div>
      </li>
    </ul>
  </section>

