<Base
  title="India Atlas — Consumption · Dossier 07"
  description="Dossier 07 — the Household Consumption Expenditure Survey: what India spends per person per month, rung by rung, state by state."
  nav="dossiers"
  dateStamp="August 2026"
  crumbLeft='<a href="/" style="color:inherit">Dossiers</a> / Consumption / <b>Household Consumption · HCES</b>'
  crumbRight='Two survey rounds · final on release · <b>v1.0</b>'
