---
// /offline/: what the installed app shows when a page is asked for with no connection and no
// saved copy (public/sw.js). It lists the pages this device has saved, read from the service
// worker's caches by the script below, each with the day it was saved, so a reader can see how
// old a copy is before opening it. Never indexed.
import Base from "../layouts/Base.astro";
import { SITE } from "../site.js";
import "../styles/pages.css";
---
<Base
  title={`Offline · ${SITE.name}`}
  description="You are offline. Pages you have opened before are saved on this device."
  crumbLeft="<b>Offline</b>"
  noindex
  charts={false}
>
<div class="page spage off">
  <header class="titleblock">
    <div class="kicker">Offline</div>
    <h1>No connection, and no saved copy of this page.</h1>
    <p class="lede">Pages you have opened before are kept on this device and open without a connection. Their figures are as they were on the day each was saved; reconnect for the latest.</p>
  </header>
  <section class="nf-list off-list" aria-labelledby="off-h">
    <h2 id="off-h" class="off-h">Saved on this device</h2>
    <ul class="fd-list" id="off-list"><li><span>Looking for saved pages…</span></li></ul>
    <p class="off-more"><a href="/" id="off-retry">Try the front page again</a></p>
  </section>
</div>
<script is:inline>
(async () => {
  const list = document.getElementById("off-list");
  const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  const day = (t) => { const d = new Date(t); return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`; };
  try {
    const rows = [];
    for (const name of (await caches.keys()).filter((k) => k.startsWith("moi-pages-"))) {
      const c = await caches.open(name);
      for (const req of await c.keys()) {
        const u = new URL(req.url);
        if (!u.pathname.endsWith("/") || u.pathname === "/offline/") continue;
        const r = await c.match(req), saved = r?.headers.get("x-moi-saved");
        const title = (r ? (await r.clone().text()).match(/<title>([^<]*)<\/title>/)?.[1] : "") || u.pathname;
        rows.push({ href: u.pathname, title: title.replace(/ · [^·]*$/, "").replace(/&#39;/g, "'").replace(/&amp;/g, "&"), saved: saved ? +saved : 0 });
      }
    }
    rows.sort((a, b) => b.saved - a.saved);
    list.innerHTML = rows.length ? rows.map((r) => `<li><a href="${r.href}"></a><span>${r.saved ? "Saved " + day(r.saved) : ""}</span></li>`).join("") : "<li><span>None yet. Pages are saved as you read them.</span></li>";
    list.querySelectorAll("a").forEach((a, i) => { a.textContent = rows[i].title; });
  } catch { list.innerHTML = "<li><span>This browser does not keep pages for offline reading.</span></li>"; }
})();
</script>
<style>
  .off-list{padding:80px 0 112px}
  .off-h{font-family:var(--serif);font-weight:500;font-size:2.125rem;letter-spacing:-.015em;padding-bottom:14px;border-bottom:1px solid var(--ink)}
  .off .fd-list{margin-top:0}
  .off .fd-list li:first-child{border-top:0}
  .off-more{margin-top:40px;font-family:var(--sans);font-size:.9375rem}
  .off-more a{color:var(--ink-soft);text-decoration:none;border-bottom:1px solid var(--rule-2)}
</style>
</Base>
