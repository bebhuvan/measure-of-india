---
import Base from "../../layouts/Base.astro";
import { EXPLAINERS } from "../../learn/registry.js";
---
<Base
  title="Learn · Measure of India"
  description="Deep, visual explanations of the big economic concepts: inflation, GDP, base effects, real vs nominal, written for the layperson, illustrated with real Indian data."
  nav="learn"
  dateStamp="Evergreen"
  crumbLeft='<a href="/" style="color:inherit">Home</a> / <b>Learn</b>'
  crumbRight='Evergreen, concept notes, <b>new entries added over time</b>'
  canonical="/learn/"
>
<div class="page">
  <div class="titleblock">
    <div class="kicker">Learn: the concepts behind the numbers</div>
    <div class="hero-grid">
      <h1>Read the economy <i>without being fooled.</i></h1>
      <p class="lede">The big ideas behind the headlines: inflation, growth, base effects, real versus nominal. Each taken apart slowly, in plain language, and illustrated with real Indian data.</p>
    </div>
    <div class="meta">
      <span>Audience <b>The layperson</b></span>
      <span>Register <b>Evergreen</b></span>
      <span>Illustrations <b>Live from the data</b></span>
      <span>Entries <b>{EXPLAINERS.filter((e) => e.live).length}</b></span>
    </div>
  </div>

  <section>
    <div class="sec-head"><span class="no">01</span><h2>Concepts</h2><span class="line"></span><span class="unit">New entries added over time</span></div>
    <div class="break ledger">
      <table>
        <thead>
          <tr><th><span class="vh">Number</span></th><th>Entry</th><th>Illustrated with</th><th>Read</th></tr>
        </thead>
        <tbody>
          {EXPLAINERS.filter((e) => e.live).map((e) => (
            <tr>
              <td class="chg">{e.no}</td>
              <td class="name"><a href={"/learn/" + e.slug + "/"} style="color:inherit">{e.title}</a><small>{e.blurb}</small></td>
              <td class="chg">{e.illustratedWith}</td>
              <td class="chg">{e.minutes} min</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <footer class="provenance">
    <div class="cols">
      <div>
        <h6>What this section is</h6>
        <p>The guides track the numbers; this section explains the ideas behind them. Each entry is evergreen, written to survive the next print, and every chart redraws from the baked data on each build.</p>
      </div>
      <div>
        <h6>Who it is for</h6>
        <p>The layperson. No prior economics assumed, no jargon left unexplained, and no talking down: the definitions are the precise ones, plain in their wording.</p>
      </div>
      <div>
        <h6>Companion reading</h6>
        <p>Each concept note links to the guide where its series lives: <a href="/guides/cpi/">Consumer Price Index</a>, <a href="/guides/gdp/">National Accounts</a>.</p>
      </div>
    </div>
    <div class="fine">
      <span>Measure of India, Learn</span>
      <span>Evergreen, v1.0</span>
      <span>Set in Newsreader and Libre Franklin</span>
    </div>
  </footer>
</div>
</Base>
