---
import Base from "../layouts/Base.astro";
import { SITE } from "../site.js";
import "../styles/pages.css";
import fs from "node:fs";
import { DOSSIERS, bySlug } from "../dossiers/registry.js";
import { vintageLabel } from "../dossiers/display.js";
import { headlineOf } from "../dossiers/headline.js";
import { COVER, cover, LEDGER, ST, ACROSS, tiles } from "../dossiers/home.charts.js";
import { STATES } from "../dossiers/states-key.js";   // profiles (lb/profiles)
import { MONTHS_FULL as MF } from "../../pipeline/lib/periods.mjs";
import { EXPLAINERS } from "../learn/registry.js";
import { qualityRegistryVersion } from '../explore/source-quality.js';
import { BY_ID as PROFILE, commonDate, measureAll, periodOf, FMT } from "../dossiers/profiles.js";
const MONTHS_FULL = MF.map((m) => m[0].toUpperCase() + m.slice(1));

// The front page is a briefing: what the latest data says, in sentences computed from the
// bundles at build time. Nothing here is typed by hand, so it can never describe a stale print.
const SERIES_FILES = fs.readdirSync("data/series").filter((f) => f.endsWith(".json"));
// datasets, not series (2026-10-18): six in ten "series" were one survey cell, so the count a reader
// can check is the published tables themselves, each a page under /data/
const N = SERIES_FILES.length.toLocaleString("en-IN");

const SECTIONS = [...new Set(DOSSIERS.map((d) => d.section))];
const UNITS = [...STATES].sort((a, b) => a.name.localeCompare(b.name, "en-IN"));
const nStates = UNITS.filter((u) => u.kind === "state").length, nUTs = UNITS.length - nStates;
const LEARN = EXPLAINERS.filter((e) => e.live);
const WORDS = ["No", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve"];
const LEARN_FAMILIES = [...new Set(LEARN.map((e) => e.family))];
// the state tiles: each unit's income per person in the year most of them have published (the
// profiles' comparison year), a thin bar against the highest; a unit without that year says so
const PC = PROFILE.pc, PC_ISO = commonDate(PC), PC_PERIOD = periodOf(PC, PC_ISO);
const PC_BY = new Map(measureAll(PC, PC_ISO).map((x) => [x.slug, x.v]));
const PC_MAX = Math.max(...PC_BY.values());
---
<Base
  title={`${SITE.name}: ${SITE.tagline}`}
  description={`What the latest official figures say about prices, growth, factories and jobs, with plain-language guides to every statistic and ${N} series to search and download.`}
  nav="home"
  crumbLeft={`Latest release: <b>consumer prices for ${COVER.month}</b>${COVER.release ? `, published ${+COVER.release.slice(8, 10)} ${MONTHS_FULL[+COVER.release.slice(5, 7) - 1]} ${COVER.release.slice(0, 4)}` : ""}`}
  canonical="/"
>
<div class="page home spage">

  <section class="hm-sec hm-promise hm-row" aria-label={`About ${SITE.name}`}>
    <div class="hm-m"><div class="hm-lab"><a href="/about/">About the site</a></div></div>
    <div>
      <p class="hm-pitch">India publishes a staggering amount of data and hides most of it on websites that feel like punishment. This site breaks it out and puts it in one place, every figure from the agency that published it, every chart explained.</p>
      <ul class="hm-proof">
        <li><b>{DOSSIERS.length}</b> guides</li>
        <li><b>{UNITS.length}</b> states and union territories</li>
        <li><a href="/data/"><b>{N}</b> datasets</a></li>
        <li><b>{LEARN.length}</b> notes on the ideas</li>
        <li>No trackers, no cookies</li>
      </ul>
      <p class="hm-follow">Follow every new figure by <a href="/feeds/releases.xml">RSS</a> or <a href="/feeds/">a feed per guide</a>. The code is open on <a href={SITE.repo}>GitHub</a>; <a href="/contribute/">help build it</a>.</p>
      <div class="find" id="find" role="search" data-quality-version={qualityRegistryVersion}>
        <label id="find-l" for="q">Search every guide, chart and series</label>
        <div class="qwrap">
          <input id="q" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder="Inflation in Kerala, the rupee, wheat"
            aria-labelledby="find-l">
          <div id="results" class="sx-panel" hidden></div>
        </div>
      </div>
    </div>
  </section>

  <section class="hm-sec hm-cover hm-row" aria-labelledby="cv-h">
    <div class="hm-m">
      <div class="hm-kicker"><span class="dot"></span>Latest release</div>
      <div class="fig-xl">{COVER.value}<small>%</small></div>
      <div class="hm-delta"><b>Consumer prices</b>, {COVER.month}<br>{COVER.delta}</div>
    </div>
    <div>
      <h1 id="cv-h" class="cover-h">{COVER.finding}</h1>
      <p class="hm-lede">{COVER.lede}</p>
      <figure class="hm-fig">
        <div class="plotzone" set:html={cover()} />
        <div class="plotfoot"><span class="src">Consumer Price Index, all India, year on year, per cent, base 2024=100; lighter before January 2025, where the statistics office's back-cast gives way to the live print. Source: MoSPI.</span>
          <span class="dl"><a href="/guides/cpi/">Read the guide</a><button type="button" data-dl="csv">CSV</button><button type="button" data-dl="png">PNG</button></span></div>
      </figure>
    </div>
  </section>

  <section class="hm-sec" aria-labelledby="lg-h">
    <div class="hm-ph hm-row"><div class="hm-m"><div class="hm-lab">The ledger</div></div><div><h2 id="lg-h">{WORDS[LEDGER.length]} measures that move every month or quarter, as they last printed</h2><p>Newest first. Change is on the print before; the trend is the last three years.</p></div></div>
    <div class="hm-ledger">
      <table>
        <thead><tr><th>Measure</th><th class="pd">Period</th><th>Latest</th><th>Change</th><th class="ya">A year ago</th><th class="sp">Last three years</th></tr></thead>
        <tbody>{LEDGER.map((r) => (
          <tr><td><a href={`/guides/${r.slug}/`}><span class="nm">{r.name}</span><span class="wh">{r.what}</span></a></td>
            <td class="pd">{r.period}</td><td><span class="lv">{r.value}<small>{r.suffix}</small></span></td>
            <td class="ch">{r.change}</td><td class="ya">{r.yearAgo}</td><td class="sp" set:html={r.spark} /></tr>
        ))}</tbody>
      </table>
    </div>
  </section>

  <section class="hm-sec" aria-labelledby="ai-h">
    <div class="hm-ph hm-row"><div class="hm-m"><div class="hm-lab">Across India</div></div><div><h2 id="ai-h">Prices rose fastest in {ACROSS.top.name} and slowest in {ACROSS.bottom.name}</h2><p>Consumer prices by state and union territory, {ACROSS.month}, year on year. Each is one equal tile, so Goa counts as much as Rajasthan.</p></div></div>
    <div class="hm-row">
      <div class="hm-m">
        <ol class="hm-rank">
          {ST.slice(0, 5).map((r) => <li><span>{r.name}</span><b>{r.v.toFixed(1)}%</b></li>)}
          <li class="gap" aria-hidden="true">…</li>
          {ST.slice(-3).map((r) => <li><span>{r.name}</span><b>{r.v.toFixed(1)}%</b></li>)}
        </ol>
        <p class="hm-more"><a href="/states/">All {UNITS.length} state profiles</a></p>
      </div>
      <figure class="hm-fig hm-tiles"><div class="plotzone" set:html={tiles()} /></figure>
    </div>
  </section>

  <section class="hm-sec" aria-labelledby="ix-h">
    <div class="hm-ph hm-row"><div class="hm-m"><div class="hm-lab">The guides</div></div><div><h2 id="ix-h">{DOSSIERS.length} guides to India's statistics, each with its latest figure</h2><p>Every guide explains what a number measures, how it is made and how to read it, with every published series and cut to download.</p></div></div>
    <div class="dossiers hm-index">
      {SECTIONS.map((sec) => (
        <div class="ix-grp">
          <h3>{sec}</h3>
          <ul>
            {DOSSIERS.filter((d) => d.section === sec).map((d) => { const h = headlineOf(d); return (
              <li data-slug={d.slug}><a href={`/guides/${d.slug}/`}>
                <span class="ix-n">{d.title}</span><span class="ix-l" aria-hidden="true"></span>
                <span class="ix-v" id={`v-${d.slug}`}>{h.value}</span>
                <span class="ix-w"><i>{h.what.replace(/^./, (c) => c.toUpperCase())}</i>, {h.period}</span>
                <span class="vt">{vintageLabel(d)}</span>
              </a></li>
            ); })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="hm-sec st-entry" aria-labelledby="st-h">
    <div class="hm-ph hm-row"><div class="hm-m"><div class="hm-lab"><a href="/states/">All {UNITS.length}, compared</a></div></div><div><h2 id="st-h">States and union territories</h2><p>A page for each of the {nStates} states and {nUTs} union territories: how it earns, spends, works, borrows and falls ill, against India and its neighbours.</p></div></div>
    <p class="st-cap">Income per person, {PC_PERIOD}, at current prices</p>
    <ul class="st-tiles">{UNITS.map((u) => { const v = PC_BY.get(u.slug); return (
      <li><a href={`/states/${u.slug}/`}>
        <span class="st-n">{u.short ?? u.name}</span>
        {v != null ? <span class="st-v">{FMT[PC.fmt](v)}</span> : <span class="st-v st-na">Not yet published</span>}
        <span class="st-bar" aria-hidden="true"><i style={v != null ? `width:${(v / PC_MAX * 100).toFixed(1)}%` : "width:0"}></i></span>
      </a></li>
    ); })}</ul>
  </section>

  <section class="hm-sec learn" aria-labelledby="ln-h">
    <div class="hm-ph hm-row"><div class="hm-m"><div class="hm-lab"><a href="/learn/">All {LEARN.length} notes</a></div></div><div><h2 id="ln-h">The ideas behind the numbers</h2></div></div>
    {LEARN_FAMILIES.map((f) => (
      <div class="ln-grp hm-row">
        <h3 class="hm-m">{f}</h3>
        <ul>{LEARN.filter((e) => e.family === f).map((e) => <li><a href={`/learn/${e.slug}/`}>{e.title}</a></li>)}</ul>
      </div>
    ))}
  </section>

  <footer class="provenance">
    <div class="cols">
      <div><h6>{SITE.name}</h6><p>A reference work on Indian economic statistics, revised as each figure is released. All data comes from the statistical agencies and is built into the page; nothing is estimated unless a chart says so.</p></div>
      <div><h6>Sources</h6><p>MoSPI and the National Statistics Office, the Reserve Bank of India, the Office of the Economic Adviser, the Registrar General, the ministries of agriculture, education, health, commerce and renewable energy, and, for the comparisons with the world, the World Bank, the UN, the ILO and the BIS. Each guide cites its release.</p></div>
      <div><h6>Before you cite</h6><p>Read <a href="/method/">how we work</a>. Every chart downloads as an image or as data, with its source attached.</p></div>
    </div>
  </footer>
</div>
<script>
  import "../dossiers/home.client.js";
</script>
</Base>
