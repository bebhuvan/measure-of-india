---
import Base from "../layouts/Base.astro";
import "../styles/pages.css";
import fs from "node:fs";
import { DOSSIERS } from "../dossiers/registry.js";
import { makePeriodLabel, MONTHS_FULL, MONTHS_SHORT } from "../../pipeline/lib/periods.mjs";

// counts are computed, never hardcoded — the front page must never disagree
// with the register after a coverage wave lands
const SERIES_FILES = fs.readdirSync("data/series").filter((f) => f.endsWith(".json"));
const N_SERIES = SERIES_FILES.reduce((n, f) => n + Object.keys(JSON.parse(fs.readFileSync("data/series/" + f, "utf8")).series).length, 0);
const N_DOSSIERS = DOSSIERS.length;

// freshness is derived, never typed: every date on this page comes from the
// bundles themselves, so a new print can never leave a stale label behind
const read = (s) => JSON.parse(fs.readFileSync("data/series/" + s + ".json", "utf8"));
const cpiNew = read("cpi-2024"), cpiOld = read("cpi"), gdpNew = read("gdp-2022");
const mLab = makePeriodLabel("monthly", "fiscal-apr");
const qLab = makePeriodLabel("quarterly", "fiscal-apr");
const baseOf = (b) => b.meta.base?.replace("=100", "") ?? "";
const cpiLatest = mLab(cpiNew.dates.at(-1));          // "Jun 2026"
const cpiPrevMo = MONTHS_SHORT[Number(cpiNew.dates.at(-2).slice(5, 7)) - 1];
const cpiOldLast = mLab(cpiOld.dates.at(-1));         // "Dec 2025"
const gdpLatest = qLab(gdpNew.dates.at(-1));          // "Q4 FY26"
const gdpPrevQ = qLab(gdpNew.dates.at(-2)).split(" ")[0];
// the page stamp is the CPI release month — the freshest print on the board
const rel = cpiNew.meta.releaseDate ?? cpiNew.meta.vintage;
const stamp = `${MONTHS_FULL[Number(rel.slice(5, 7)) - 1]} ${rel.slice(0, 4)}`;
const STAMP = stamp[0].toUpperCase() + stamp.slice(1);
---
<Base
  title="India Atlas — India's economic data, one dossier at a time"
  description="Not another dashboard. Long-form dossiers on Indian economic statistics — charts, meaning, the latest print, and the ways each number is misread."
  nav="dossiers"
  dateStamp={STAMP}
  crumbLeft="Home"
  crumbRight={`<b>${N_DOSSIERS}</b> dossiers published · <b>${N_SERIES.toLocaleString("en-IN")}</b> series baked`}
  canonical="https://atlas.thisindianlife.today/"
>
<div class="page home spage">

  <div class="hero break">
    <div class="kicker">India Atlas · A statistical monograph, continuously revised</div>
    <div class="hero-grid">
      <h1>India's economic data, <i>one dossier at a time.</i></h1>
      <p class="lede">Not another dashboard. Each dossier devotes a whole page to a single statistical concept — the charts, the meaning, the latest print, and the ways the number is most often misread.</p>
    </div>
  </div>

  <div class="frontis break">
    <div id="frontis-plot"></div>
    <div class="frontis-cap">
      <span>Headline CPI, year-on-year · {mLab(cpiOld.dates[0])} – {cpiLatest} · base {baseOf(cpiOld)} to {cpiOldLast}, base {baseOf(cpiNew)} from {mLab(cpiNew.dates[0])} — never joined · shaded: RBI tolerance band</span>
      <a href="/dossiers/cpi/">The full plate · Dossier 01 →</a>
    </div>
  </div>

  <div class="prints break">
    <div class="ph">
      <span class="t">The latest prints · {STAMP}</span>
      <a href="/register/">Full register →</a>
    </div>
    <div class="grid">
      <div class="cell">
        <div class="l">CPI inflation · {cpiLatest} · y/y · base {baseOf(cpiNew)}</div>
        <div class="v" id="v-cpi">–</div>
        <div class="d"><b id="d-cpi">–</b> vs {cpiPrevMo} · <a href="/dossiers/cpi/">Dossier 01 →</a></div>
        <div class="nspark" id="sp-cpi"></div>
      </div>
      <div class="cell">
        <div class="l">GDP growth · {gdpLatest} · y/y · base {baseOf(gdpNew)}</div>
        <div class="v" id="v-gdp">–</div>
        <div class="d"><b id="d-gdp">–</b> vs {gdpPrevQ} · <a href="/dossiers/gdp/">Dossier 02 →</a></div>
        <div class="nspark" id="sp-gdp"></div>
      </div>
      <div class="cell">
        <div class="l">Core CPI · {cpiOldLast} · y/y · derived · base {baseOf(cpiOld)}, to {cpiOldLast}</div>
        <div class="v" id="v-core">–</div>
        <div class="d"><b id="d-core">–</b> vs {MONTHS_SHORT[Number(cpiOld.dates.at(-2).slice(5, 7)) - 1]} · <a href="/dossiers/cpi/">Dossier 01 →</a></div>
        <div class="nspark" id="sp-core"></div>
      </div>
    </div>
  </div>

  <section id="dossiers">
    <div class="sec-head"><span class="no">§</span><h2>The dossiers</h2><span class="line"></span><span class="unit">№ 01 – {String(N_DOSSIERS).padStart(2, "0")} · all published</span></div>
    <ul class="dossiers">
      {DOSSIERS.map((d) => (
        <li><a href={`/dossiers/${d.slug}/`}>
          <span class="no">№ {d.no}</span>
          <span class="nm">{d.name}</span>
          <span class="ds">{d.blurb}</span>
          <span class="dspark" id={`ds-${d.slug}`}></span>
          <span class="vt"><b>Current</b><br>{d.vintageLabel}</span>
        </a></li>
      ))}
    </ul>

    <div class="note-block">
      <div>
        <h3>How to use this site</h3>
        <p>Start with a dossier's <b>current reading</b> if you came for the news; read it end to end if you came to understand. Every chart downloads as SVG, PNG or CSV, and every number on the page is computed from the same data the charts use.</p>
      </div>
      <div>
        <h3>What we promise</h3>
        <p>Every observation traceable to its source. Derived series labelled as derived. Conflicting statistics shown side by side, never reconciled. And where something is not measured, the page says <b>we do not know</b>.</p>
      </div>
    </div>
  </section>

  <footer class="provenance">
    <div class="cols">
      <div>
        <h6>India Atlas</h6>
        <p>A static-first reference work for Indian economic statistics. Published continuously; each dossier carries its vintage and revision history. All data is sourced from the statistical agencies and baked into the page at build time.</p>
      </div>
      <div>
        <h6>Sources</h6>
        <p>MoSPI / NSO for prices and national accounts; Office of the Economic Adviser for wholesale prices. Each dossier cites its exact press release and release date.</p>
      </div>
      <div>
        <h6>Before you cite</h6>
        <p>Read <a href="/method/">how we work</a> before citing us.</p>
      </div>
    </div>
    <div class="fine">
      <span>India Atlas · Home</span>
      <span>Static · no trackers · no cookies</span>
      <span>Set in Archivo, Newsreader &amp; Plex Mono</span>
    </div>
  </footer>

</div>
<script>
  import "../dossiers/home.client.js";
</script>
</Base>
