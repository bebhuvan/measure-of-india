---
import Base from "../layouts/Base.astro";
import "../styles/pages.css";
import fs from "node:fs";
import { DOSSIERS } from "../dossiers/registry.js";
import { dateStamp } from "../dossiers/display.js";
import { fillPeriods } from "../dossiers/periods.js";
import { BODY } from "../dossiers/register.charts.js";

// same computed counts as the front page — the two must never disagree
const SERIES_FILES = fs.readdirSync("data/series").filter((f) => f.endsWith(".json"));
const N_SERIES = SERIES_FILES.reduce((n, f) => n + Object.keys(JSON.parse(fs.readFileSync("data/series/" + f, "utf8")).series).length, 0);
const N_DOSSIERS = DOSSIERS.length;
---
<Base
  title="Indicators · India Atlas"
  description="Every series India Atlas tracks: what it is, who publishes it, its latest reading, and its shape over the decade."
  nav="register"
  dateStamp={dateStamp(DOSSIERS[0])}
  crumbLeft="<b>The Register</b>"
  crumbRight={`<b>${N_SERIES.toLocaleString("en-IN")}</b> series baked, ${N_DOSSIERS} guides, updated with each print`}
  canonical="https://atlas.thisindianlife.today/register/"
>
<div class="page register spage">

  <div class="titleblock">
    <div class="kicker">The Register</div>
    <h1>Every series we track, <i>in one ledger.</i></h1>
    <p class="lede">The complete inventory of India Atlas data: what each series is, who publishes it, its latest reading, and its shape over the decade. Derived series are tagged.</p>
  </div>

  {DOSSIERS.map((d) => (
    <section>
      <div class="sec-head"><span class="no">{d.no}</span><h2>{d.register.label}, Guide {d.no}</h2><span class="line"></span><span class="unit">{fillPeriods(d.register.unit, d.currentBundle)}</span></div>
      <div class="break ledger">
        <table>
          <thead><tr><th>Series</th><th>Code</th><th>{d.register.latestCol ?? "Latest"}</th><th>{d.register.agoCol ?? "Year ago"}</th><th>Vintage</th><th class="spark">{fillPeriods(d.register.historyCol, d.currentBundle)}</th></tr></thead>
          <tbody id={d.register.id} set:html={BODY[d.register.id] ?? ""} />
        </table>
      </div>
    </section>
  ))}

  <footer class="provenance">
    <div class="fine">
      <span>India Atlas, Register</span>
      <span>Data: the agencies each guide names, vintages as shown</span>
      <span>Set in Newsreader and Libre Franklin</span>
    </div>
  </footer>

</div>
</Base>
