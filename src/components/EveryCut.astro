---
// "Every series, every cut": the long-tail explorer every guide carries (PLAN-launch §2,
// docs/CONTRACT-dossier-structure.md). Lists every series of every bundle the guide uses,
// built at render time from the baked bundles. The page inlines at most INLINE_CAP rows (or the
// registry's `everyCutInline`); bundles over LONG_TAIL series, registry `everyCutFamilies`, and
// the bundles past the cap get paged long-tail views (/guides/<slug>/every-cut/<id>/), linked
// from here, so a guide page never ships thousands of rows.
//   <EveryCut slug="cpi" />                     place it just before <GuideData slug=... />
//   <EveryCut slug="cpi" cuts={{ "cpi-2024": "Division" }} />   override a bundle's cut name
import { bySlug } from "../dossiers/registry.js";
import { guideBundles, bundleTitle, everyCutPlan } from "../dossiers/everycut.js";
import { archiveFor } from "../dossiers/archive.js";
import EveryCutTable from "./EveryCutTable.astro";
import { inlineSpec, packLink } from "../dossiers/everycut-html.js";
interface Props { slug: string; cuts?: Record<string, string> }
const { slug, cuts = {} } = Astro.props;
const d = bySlug[slug];
// where each series appears (src/dossiers/everycut.js everyCutPlan): inline up to the guide's
// cap, long bundles on their own pages, registry families and the overflow on paged views
const plan = everyCutPlan(d, { cuts });
const titles = Object.fromEntries(plan.inline.map((b) => [b, bundleTitle(b)]));
const nAll = plan.inlineRows.length + plan.tails.reduce((a, t) => a + t.rows.length, 0);
const nFiles = guideBundles(d).length;
const fmtN = (n) => n.toLocaleString("en-IN");
const governed=d.sourceQualityMode==="required";
// bundles whose finer grain is in the deep archive (data/archive/manifest.json)
const arcs = guideBundles(d).map((b) => ({ b, a: archiveFor(b) })).filter((x) => x.a);
const note = (t) => {
  const pages = t.pages.length > 1 ? `, over ${t.pages.length} pages` : "";
  if (t.kind === "bundle") { const g = new Set(t.rows.map((r) => r.group).filter(Boolean)).size; return `${t.rows[0]?.cut ?? ""}${g ? `, in ${g} groups` : ""}${pages}.`; }
  return t.bundles.length === 1 ? `One file${pages}.` : `${fmtN(t.bundles.length)} files${pages}, filterable by file.`;
};
---
<section class="endmatter everycut" aria-labelledby="ec-h" id="every-cut" data-series={nAll}>
  <div class="em-head"><h2 id="ec-h">Every series, every cut</h2>
    {governed?<p>All {fmtN(nAll)} series behind this guide, from {fmtN(nFiles)} files. Series whose definitions we have checked against the source show their figures. The rest are listed by name and period, without a figure, until we have; the original files hold every published number.{d.everyCutChangeMode === "none" && <> Changes on a year earlier are not shown for these series.</>}</p>:<p>All {fmtN(nAll)} series behind this guide, from {fmtN(nFiles)} {nFiles === 1 ? "file" : "files"}, at every level the source publishes them, including the ones no chart above draws. Find a state, an item or a sector, sort by the latest value or by the change on a year earlier, and download any file whole. A dash means no published figure for that cut, no figure for a year earlier, or a change that would mean nothing. Where a source explicitly leaves a survey cut unpublished, its known period and reason stay visible.</p>}</div>
  {plan.tails.length > 0 && (
    <ul class="ec-tails">
      {plan.tails.map((t) => (
        <li><a href={`/guides/${slug}/every-cut/${t.id}/`}>{fmtN(t.rows.length)} series: {t.label}</a>
          <small>{note(t)} Sortable and searchable.</small></li>
      ))}
    </ul>
  )}
  {arcs.length > 0 && (
    <div class="ec-arc">
      <p>Finer detail than these files carry is in Measure of India data archive, as Parquet and CSV:</p>
      <ul>{arcs.map(({ b, a }) => <li><a class="archive-link" href={a.href}>Finer detail: {fmtN(a.tables)} {a.tables === 1 ? "table" : "tables"} in the archive</a> <small>under {bundleTitle(b)}</small></li>)}</ul>
    </div>
  )}
  {plan.inlineRows.length > 0 && <EveryCutTable policyNotes={d.sourcePolicyNotes==="per-page"} rows={plan.inlineRows} id={`ec-${slug}`} titles={titles} pack={Object.keys(cuts).length ? null : packLink(slug, inlineSpec(d))} />}
</section>
<style is:global>
  .ec-arc{margin:18px 0 6px;font-family:var(--sans);font-size:.88rem;color:var(--ink-soft)}
  .ec-arc ul{list-style:none;margin:8px 0 0;display:grid;gap:6px}
  .ec-arc a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-2)}
  .ec-arc small{color:var(--muted);font-size:.8rem}
  .ec-tails{list-style:none;margin:22px 0 4px;font-family:var(--sans);font-size:.92rem;display:grid;gap:10px}
  .ec-tails a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--rule-2)}
  .ec-tails a:hover{border-bottom-color:var(--ink)}
  .ec-tails a::after{content:" →"}
  .ec-tails small{display:block;font-size:.8rem;color:var(--muted);margin-top:2px}
</style>
