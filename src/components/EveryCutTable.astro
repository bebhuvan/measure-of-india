---
// The every-cut table itself: rows from src/dossiers/everycut.js, sorting and filtering by
// src/dossiers/everycut.client.js. Used by EveryCut.astro on a guide and by the long-tail
// pages (/guides/<slug>/every-cut/<bundle>/). The first SSR_ROWS rows are in the HTML, so the
// table reads without script; the rest of the page's rows arrive in its pack, which the script
// streams in after first paint (then sorting, filtering and find-in-page cover every row).
import { rowHTML, SSR_ROWS, policyNotesId as notesId } from "../dossiers/everycut-html.js";
// pack: the rest of the rows, past SSR_ROWS, as a gzip file the client streams in (everycut-html.js)
interface Props { rows: any[]; id: string; titles: Record<string, string>; fold?: number; filterBy?: "cut" | "group"; policyNotes?: boolean; pack?: { href: string; rows: number } | null }
const { rows, id, titles, fold = 25, filterBy = "cut", policyNotes = false, pack = null } = Astro.props;
const policyNotesId=q=>notesId(id,q);
const shown = pack ? rows.slice(0, SSR_ROWS) : rows;
if (pack && pack.rows !== rows.length - shown.length) throw new Error(`EveryCutTable ${id}: pack holds ${pack.rows} rows, ${rows.length - shown.length} expected`);
const notes=policyNotes?[...new Map(rows.filter(r=>r.sourceQuality).map(r=>[r.sourceQuality.id,r])).values()]:[];
const changesWithheld=rows.some(r=>r.changeMode==="none");
const facet = (r) => (filterBy === "group" ? r.group : r.cut) || "Other";
const facets = [...new Set(rows.map(facet))];
const files = [...new Set(rows.map((r) => r.bundle))];
---
<div class="ec" id={id} data-fold={fold} data-total={rows.length} data-pack={pack?.href}>
  {policyNotes&&<details class="ec-policy-notes"><summary>Source review definitions for this page</summary>{notes.map(r=><div id={policyNotesId(r.sourceQuality)}><p><b>{r.sourceQuality.publicTitle||r.sourceQuality.status}</b>: {r.sourceDefinition}{r.referenceBasis&&` Reference basis: ${r.referenceBasis}`}</p></div>)}</details>}
  <div class="ec-tools">
    <label class="ec-q"><span>Find</span><input type="search" placeholder="A state, an item, a sector" autocomplete="off" /></label>
    {facets.length > 1 && (
      <label><span>{filterBy === "group" ? "Group" : "Cut"}</span>
        <select data-f="facet"><option value="">All</option>{facets.map((c) => <option value={c}>{c}</option>)}</select></label>
    )}
    {files.length > 1 && (
      <label><span>Data</span>
        <select data-f="file"><option value="">All files</option>{files.map((b) => <option value={b}>{titles[b] ?? b}</option>)}</select></label>
    )}
    <span class="ec-n" aria-live="polite">{rows.length.toLocaleString("en-IN")} series</span>
  </div>
  <div class="ec-wrap">
    <table>
      <thead><tr>
        <th scope="col"><button type="button" data-sort="label">Series</button></th>
        <th scope="col"><button type="button" data-sort="facet">{filterBy === "group" ? "Group" : "Cut"}</button></th>
        <th scope="col" class="n"><button type="button" data-sort="v">{rows.some(r => r.expected) ? "Published value / expected schedule" : "Latest"}</button></th>
        <th scope="col" class="n"><button type="button" data-sort="c">{changesWithheld ? "Derived changes not supplied" : "Change on a year earlier"}</button></th>
        <th scope="col" class="sp">Trend</th>
        <th scope="col" class="n">Data</th>
      </tr></thead>
      <tbody>
        <Fragment set:html={shown.map((r, i) => rowHTML(r, i, { filterBy, policyNotes, tableId: id })).join("")} />
      </tbody>
    </table>
  </div>
  {rows.length > fold && <button type="button" class="ec-more" hidden>Show all {rows.length.toLocaleString("en-IN")} series</button>}
  <p class="ec-none" hidden>No series match. Clear the search to see them all.</p>
</div>
<script>
  import "../dossiers/everycut.client.js";
</script>
<style is:global>
  .ec{margin-top:26px;font-family:var(--sans)}
  .ec-tools{display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px 20px;padding-bottom:16px;border-bottom:1px solid var(--rule-2)}
  .ec-tools label{display:flex;flex-direction:column;gap:6px;font-size:.8125rem;color:var(--ink-soft)}
  /* controls (DESIGN §0.7): a 1px box, square, 40px tall; focus is the ultramarine ring */
  .ec-tools input,.ec-tools select{font:inherit;font-size:.9375rem;color:var(--ink);background:var(--bg);border:1px solid var(--rule-2);height:40px;padding:0 12px;min-width:12em;max-width:22em;border-radius:0;transition:border-color .15s ease}
  .ec-tools select{appearance:none;-webkit-appearance:none;padding-right:34px;background-image:linear-gradient(45deg,transparent 50%,var(--ink-soft) 50%),linear-gradient(135deg,var(--ink-soft) 50%,transparent 50%);background-position:calc(100% - 17px) 17px,calc(100% - 12px) 17px;background-size:5px 5px;background-repeat:no-repeat}
  .ec-tools input:hover,.ec-tools select:hover{border-color:var(--ink-soft)}
  .ec-tools input:focus-visible,.ec-tools select:focus-visible{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:0}
  .ec-tools input::placeholder{color:var(--muted)}
  .ec-q input{min-width:16em}
  .ec-n{margin-left:auto;font-size:.8125rem;color:var(--muted);font-variant-numeric:tabular-nums;padding-bottom:11px}
  .ec-wrap{overflow-x:auto}   /* a wide table scrolls inside the page, never widens it (debt at 390px was 417px) */
  .ec-wrap table{width:100%;border-collapse:collapse;font-size:.88rem}
  .ec-wrap tr[hidden]{display:none !important}
  .ec-wrap th{font-weight:400;font-size:.8125rem;color:var(--muted);text-align:left;padding:12px 14px 8px 0;border-bottom:1px solid var(--rule-2);vertical-align:bottom}
  .ec-wrap th button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;text-align:inherit}
  .ec-wrap th button:hover{color:var(--ink)}
  .ec-wrap th[aria-sort] button{color:var(--ink)}
  .ec-wrap th[aria-sort="ascending"] button::after{content:" ↑"}
  .ec-wrap th[aria-sort="descending"] button::after{content:" ↓"}
  .ec-wrap td{padding:9px 14px 9px 0;border-bottom:1px solid var(--rule);vertical-align:top;color:var(--ink-soft)}
  .ec-wrap td.w{color:var(--ink);max-width:30em}
  .ec-wrap tr:target td,.ec-wrap tr.ec-hit td{background:var(--band)}
  .ec-wrap tr{scroll-margin-top:96px}
  .ec-wrap small{display:block;font-size:.78rem;color:var(--muted);margin-top:1px;line-height:1.4}
  .ec-wrap .n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
  .ec-wrap td.v{color:var(--ink)}
  .ec-wrap td.ct{font-size:.8rem;color:var(--muted);max-width:16em;line-height:1.45}
  .ec-wrap .sp{width:80px;padding-top:11px}
  .ec-wrap svg{display:block;overflow:visible}
  .ec-wrap svg path{fill:none;stroke:var(--grey1);stroke-width:1.25;stroke-linejoin:round;stroke-linecap:round}
  .ec-wrap svg line{stroke:var(--rule-2);stroke-width:1}
  .ec-wrap svg circle{fill:var(--accent)}
  .ec-wrap td a{color:var(--ink-soft);text-decoration:none;border-bottom:1px solid var(--rule-2)}
  .ec-wrap td a:hover{color:var(--ink);border-bottom-color:var(--ink)}
  .ec-more{margin-top:18px;font:inherit;font-size:.9375rem;color:var(--ink);background:none;border:1px solid var(--rule-2);height:40px;padding:0 16px;cursor:pointer;transition:border-color .15s ease}
  .ec-more:hover{border-color:var(--ink-soft)}
  .ec-none{margin-top:16px;font-size:.88rem;color:var(--muted)}
  @media (max-width:680px){
    .ec-tools label,.ec-q{flex:1 1 100%}
    .ec-tools input,.ec-tools select{min-width:0;max-width:none;width:100%}
    .ec-n{margin-left:0}
    .ec-wrap thead tr{display:flex;flex-wrap:wrap;gap:4px 16px;padding-bottom:8px;border-bottom:1px solid var(--rule-2)}
    .ec-wrap thead th{padding:0;border:0}
    .ec-wrap thead th.sp,.ec-wrap thead th:last-child{display:none}
    .ec-wrap tbody tr{display:grid;grid-template-columns:1fr auto auto;gap:2px 12px;padding:11px 0;border-bottom:1px solid var(--rule)}
    .ec-wrap tbody td{border:0;padding:0}
    .ec-wrap td.w{grid-column:1 / -1;max-width:none}
    .ec-wrap td.ct{grid-column:1 / -1;order:2}
    .ec-wrap td.v{grid-column:1;text-align:left;order:3}
    .ec-wrap td.v small{display:inline;margin-left:6px}
    .ec-wrap td.c{order:4}
    .ec-wrap td.sp{order:5;width:auto;padding-top:2px}
    .ec-wrap td:last-child{display:none}
  }
</style>
