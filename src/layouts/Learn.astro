---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  slug: string;        // used for the canonical URL
  kicker: string;      // e.g. "Learn № 01 — Concepts · Inflation"
  h1: string;          // html — may contain <i>
  lede: string;
  meta: [string, string][]; // [label, value] pairs for the meta strip
  dateStamp?: string;
  crumbTitle: string;  // last crumb segment
  ogImage?: string;
}
const { title, description, slug, kicker, h1, lede, meta, dateStamp = "Evergreen", crumbTitle, ogImage } = Astro.props;
import { EXPLAINERS } from "../learn/registry.js";
// a page whose charts draw a retired ruler says so above the first section, and points to the current one
const RULERS = {
  cpi2012: 'The charts on this page draw the consumer price index on its 2012 base, the series that ran to December 2025. From January 2026 the NSO publishes the index on a new base, 2024 = 100. The idea on this page works the same on either ruler; the latest figures are in the <a href="/guides/cpi/">Consumer prices guide</a>.',
  gdp2011: 'The charts on this page draw the national accounts at 2011-12 prices, the series that ran to July to September 2025. The NSO now publishes GDP at 2022-23 prices. The idea on this page works the same on either ruler; the latest figures are in the <a href="/guides/gdp/">GDP guide</a>.',
};
const ruler = RULERS[EXPLAINERS.find((e) => e.slug === slug)?.ruler];
---
<Base
  title={title}
  description={description}
  nav="learn"
  dateStamp={dateStamp}
  crumbLeft={`<a href="/learn/" style="color:inherit">Learn</a> / Concepts / <b>${crumbTitle}</b>`}
  crumbRight="Evergreen, concept notes, <b>v1.0</b>"
  canonical={"https://atlas.thisindianlife.today/learn/" + slug + "/"}
  ogImage={ogImage}
>
<div class="page">
  <div class="titleblock break">
    <div class="kicker">{kicker}</div>
    <div class="hero-grid">
      <h1 set:html={h1} />
      <p class="lede">{lede}</p>
    </div>
    <div class="meta">
      {meta.map(([l, v]) => <span>{l} <b>{v}</b></span>)}
    </div>
  </div>

  {ruler && <p class="ruler-note" set:html={ruler} />}

  <slot />

  <footer class="provenance">
    <div class="cols">
      <slot name="prov-source" />
      <slot name="prov-revision" />
      <slot name="prov-note" />
    </div>
    <div class="fine">
      <span>India Atlas, Learn, {crumbTitle}</span>
      <span>Evergreen, review with each base revision</span>
      <span>Set in Newsreader and Libre Franklin</span>
    </div>
  </footer>
</div>
</Base>
<style>
  .ruler-note{max-width:68ch;margin:32px 0 0;padding:14px 20px;background:var(--wash);border-left:2px solid var(--rule-2);font-family:var(--sans);font-size:.92rem;line-height:1.55;color:var(--ink-soft)}
  .ruler-note a{color:inherit}
</style>
