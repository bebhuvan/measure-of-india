---
import "../styles/atlas.css";

interface Props {
  title: string;
  description?: string;
  nav?: "dossiers" | "learn" | "register" | "method" | "about";
  dateStamp?: string;
  crumbLeft?: string;   // html
  crumbRight?: string;  // html
  canonical?: string;
  ogImage?: string;
}
const {
  title,
  description = "India Atlas — long-form dossiers on Indian economic statistics.",
  nav,
  dateStamp = "",
  crumbLeft = "",
  crumbRight = "",
  canonical,
  ogImage = "/og/site.png",
} = Astro.props;
const ogUrl = "https://indiaatlas.in" + ogImage;
const home = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{canonical && <link rel="canonical" href={canonical}>}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="article">
<meta property="og:image" content={ogUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogUrl}>
<link rel="preload" href="/fonts/archivo-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/newsreader-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/plex-mono-400.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
<header class="sitehead">
  <div class="sh-in">
    <a class="brand" href="/"><span class="mark"></span>India Atlas</a>
    <nav class="sh-nav">
      <a href="/#dossiers" aria-current={nav === "dossiers" ? "page" : undefined}>Dossiers</a><a href="/learn/" aria-current={nav === "learn" ? "page" : undefined}>Learn</a><a href="/register/" aria-current={nav === "register" ? "page" : undefined}>Register</a><a href="/method/" aria-current={nav === "method" ? "page" : undefined}>Method</a><a href="/about/" aria-current={nav === "about" ? "page" : undefined}>About</a>
    </nav>
    <span class="sh-date">{dateStamp}</span>
  </div>
</header>
{crumbLeft && (
  <div class="crumb">
    <div class="crumb-in">
      <span set:html={crumbLeft} />
      <span set:html={crumbRight} />
    </div>
  </div>
)}
<slot />
</body>
</html>
