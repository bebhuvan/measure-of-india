---
import "../styles/atlas.css";

interface Props {
  title: string;
  description?: string;
  nav?: "guides" | "home" | "learn" | "register" | "method" | "about" | "states";
  dateStamp?: string;
  crumbLeft?: string;   // html
  crumbRight?: string;  // html
  canonical?: string;
  ogImage?: string;
}
const {
  title,
  description = "India Atlas: plain-language guides to India's official economic statistics, with charts you can download and share.",
  nav,
  dateStamp = "",
  crumbLeft = "",
  crumbRight = "",
  canonical,
  ogImage = "/og/site.png",
} = Astro.props;
const ogUrl = "https://atlas.thisindianlife.today" + ogImage;
const canonicalUrl = canonical ?? "https://atlas.thisindianlife.today/";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{canonical && <link rel="canonical" href={canonical}>}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="India Atlas: guide revisions" href="/rss.xml">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="article">
<meta property="og:url" content={canonicalUrl}>
<meta property="og:site_name" content="India Atlas">
<meta property="og:image" content={ogUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={ogUrl}>
<link rel="preload" href="/fonts/source-serif-4-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/golos-text-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="sitehead">
  <div class="sh-in">
    <a class="brand" href="/">India Atlas</a>
    <nav class="sh-nav" aria-label="Main">
      <a href="/guides/" aria-current={nav === "guides" ? "page" : undefined}>Guides</a><!-- profiles (lb/profiles) --><a href="/states/" aria-current={nav === "states" ? "page" : undefined}>States</a><!-- end profiles --><a href="/learn/" aria-current={nav === "learn" ? "page" : undefined}>Learn</a><a href="/explore/" aria-current={nav === "register" ? "page" : undefined}>Indicators</a><a href="/method/" aria-current={nav === "method" ? "page" : undefined}>Method</a><a href="/about/" aria-current={nav === "about" ? "page" : undefined}>About</a>
    </nav>
    <a class="sh-search" href="/#find">Search <kbd>/</kbd></a>
    <span class="sh-date">{dateStamp}</span>
  </div>
</header>
{crumbLeft && (
  <div class="crumb">
    <div class="crumb-in">
      <span set:html={crumbLeft} />
      <span set:html={crumbRight} />
    </div>
  </div>
)}
<main id="main"><slot /></main>
</body>
</html>
