---
import Base from '../layouts/Base.astro';
import {DOSSIERS} from '../dossiers/registry.js';
import {rowAnchor,loadBundle,periodLabel} from '../dossiers/everycut.js';
import {qualityRegistryVersion} from './source-quality.js';
import {identity,seriesURL} from './model.js';
const {initial} = Astro.props;
const examples=[['cpi-2024','headline','Retail inflation, current instrument'],['cpi','headline','Retail inflation, earlier instrument']].map(([b,k,title])=>({id:identity(b,rowAnchor(b,k)),title}));
const canonical=initial?`https://atlas.thisindianlife.today/explore/${initial.slug}/`:'https://atlas.thisindianlife.today/explore/';
const B=initial?loadBundle(initial.bundle):null,S=B?.series[initial.key];
---
<Base title={`${initial?.title || 'Explore individual indicators'} | India Atlas`} nav="register" canonical={canonical} description="Find an individual Indian economic series, inspect its complete published history and source, download exact observations and compare compatible cuts.">
<div class="page explore-page" id="explorer" data-quality-version={qualityRegistryVersion} data-series={initial ? identity(initial.bundle,rowAnchor(initial.bundle,initial.key)) : undefined}>
  <div class="titleblock"><h1>Explore individual indicators</h1><p class="lede">Follow one measure through its published history, or compare compatible cuts. Each instrument keeps its own identity, source and limits.</p></div>
  <form id="explore-search-form" class="explore-search"><label for="explore-search">Find a series</label><div><input id="explore-search" type="search" placeholder="Food inflation, a state, a survey cut" autocomplete="off"/><button type="submit">Search</button></div></form>
  <ul id="explore-results" aria-label="Series search results"></ul>
  <p id="explore-status" role="status" aria-live="polite"></p>
  <section id="explore-intro"><h2>Start with a published instrument</h2><ul>{examples.map((e,i)=><li><a href={i===0?'/explore/retail-inflation/':'/explore/retail-inflation-2012/'}>{e.title}</a></li>)}<li><a href={seriesURL([identity('cpi-2024',rowAnchor('cpi-2024','headline')),identity('cpi-2024',rowAnchor('cpi-2024','food_and_beverages'))])}>Compare food and headline inflation, base 2024</a></li><li><a href='/explore/household-land-snapshot/'>A household survey snapshot with observed state and rural/urban comparisons</a></li></ul><p>For survey cuts, open a series from any guide’s Every cut table or search its exact label. Single-period estimates appear as snapshots.</p><h2>Browse the explanatory guides</h2><ul class="explore-guide-list">{DOSSIERS.map(d=><li><a href={`/guides/${d.slug}/#every-cut`}>{d.title}</a></li>)}</ul></section>
  {initial&&B&&S&&<section id="explore-static"><h2>{initial.title}</h2><p>{B.meta.coverage}</p><p>{B.meta.source}. {B.meta.base}. Unit: {S.unit || B.meta.unit}.</p><a href={seriesURL([identity(initial.bundle,rowAnchor(initial.bundle,initial.key))])}>Open this series with date controls and downloads</a><div class="explore-table"><table><thead><tr><th>Period</th><th>Published value</th></tr></thead><tbody>{B.dates.map((date,i)=><tr><th>{periodLabel(initial.bundle,B,date)}</th><td>{S.data[i]??'—'}</td></tr>)}</tbody></table></div><a href={`/guides/${B.meta.dossier}/`}>Read the guide</a></section>}
  <noscript><p>Interactive exact-series views and comparisons need JavaScript. Every cut tables and the guides remain readable without it, with published data downloads.</p></noscript>
  <section id="explore-quality" hidden>
    <h2 id="explore-quality-title">Source record under review</h2><p id="explore-quality-reason"></p>
    <p>Numeric charts, latest-value interpretation, comparisons and selected observation/image exports are withheld. The record's identity and original source mapping remain available for inspection.</p>
    <p id="explore-quality-status"></p><div id="explore-quality-links"></div><button id="explore-quality-copy">Copy record link</button>
    <details><summary>Inspect original canonical mapping, under review</summary><p>This archival mapping preserves original fields. Its labels and units are not validated interpretations of the values.</p><pre id="explore-quality-record"></pre></details>
  </section>
  <section id="explore-view" hidden>
    <h2 id="explore-title"></h2><p id="explore-definition"></p><ul id="explore-selected"></ul>
    <form id="explore-range"><label>From date <input id="explore-from" type="date"/></label><label>To date <input id="explore-to" type="date"/></label><button type="submit">Apply dates</button></form>
    <figure class="explore-figure"><p id="explore-unit"></p><div id="explore-chart"></div><figcaption id="explore-chart-note"></figcaption><div class="explore-actions"><button id="explore-svg">Download SVG</button><button id="explore-png">Download PNG</button><button id="explore-csv">Download selected CSV</button><button id="explore-json">Download selected JSON</button><button id="explore-copy">Copy link</button></div></figure>
    <p id="explore-compatibility"></p><h3>Related compatible series</h3><div id="explore-related"></div>
    <h3>Published values</h3><p id="explore-table-count"></p><div class="explore-table"><table><thead id="explore-head"></thead><tbody id="explore-body"></tbody></table></div><div class="explore-actions"><button id="explore-prev">Earlier page</button><button id="explore-next">Next page</button></div>
    <h3>Source, instrument and missing observations</h3><dl id="explore-provenance"></dl><h3>Understand the measure</h3><div id="explore-guides"></div>
  </section>
</div>
<script>import './explore.client.js';</script>
<style is:global>
.explore-page h1,.explore-page h2,.explore-page h3,.explore-page li strong,.explore-page p,.explore-page a{overflow-wrap:anywhere}.explore-page pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:36em;overflow:auto;font-family:var(--sans);font-size:.85rem;line-height:1.5}.explore-page details{margin:24px 0}.explore-page section{margin-top:24px}.explore-page [hidden]{display:none!important}.explore-page{padding-bottom:64px}.explore-page h1{font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.12}.explore-page h2{font-size:2rem;margin:32px 0 16px}.explore-page h3{margin:32px 0 14px}.explore-page p{max-width:75ch;line-height:1.6}.explore-page input,.explore-page button{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--rule-2);border-radius:0;min-height:44px;padding:8px 12px}.explore-page button{cursor:pointer}.explore-page button:disabled{color:var(--muted);cursor:default}.explore-page :focus-visible{outline:2px solid var(--accent);outline-offset:3px}.explore-search{font-family:var(--sans);margin:28px 0}.explore-search label{display:block;margin-bottom:8px}.explore-search>div{display:flex;gap:12px}.explore-search input{flex:1;min-width:0}.explore-page ul{padding-left:20px}.explore-page li{margin:10px 0;line-height:1.5}.explore-page li small,.explore-page li span{display:block;color:var(--ink-soft);font-family:var(--sans);font-size:.9rem}.explore-page li button{margin-top:8px}#explore-results{list-style:none;padding:0;font-family:var(--sans)}#explore-status{font-family:var(--sans);color:var(--ink-soft);min-height:1.6em}#explore-selected{padding:0;list-style:none}#explore-selected li .series-mark{display:inline-block;width:28px;margin-right:10px;vertical-align:middle;border-top:2px solid var(--accent)}#explore-selected li:nth-child(2) .series-mark{border-color:var(--gold);border-top-style:dashed}#explore-selected li:nth-child(3) .series-mark{border-color:var(--grey1);border-top-style:dotted}#explore-selected li:nth-child(4) .series-mark{border-color:var(--grey2);border-top-style:double}#explore-selected li{padding:12px 0;border-bottom:1px solid var(--rule)}#explore-range{display:flex;flex-wrap:wrap;align-items:flex-end;gap:16px;font-family:var(--sans);margin:24px 0}#explore-range label{display:flex;flex-direction:column;gap:6px;font-size:.9rem}.explore-figure{margin:24px 0}#explore-unit,figcaption{font-family:var(--sans);font-size:.9rem;line-height:1.5}#explore-chart{width:100%;overflow-x:auto}#explore-chart svg{display:block;max-width:none}.explore-actions,#explore-related{display:flex;flex-wrap:wrap;gap:12px;margin:16px 0;font-family:var(--sans);font-size:.875rem}#explore-related button{text-align:left;max-width:100%}.explore-table{overflow-x:auto;max-width:100%;font-family:var(--sans)}.explore-table table{width:100%;border-collapse:collapse;font-size:.9rem}.explore-table td,.explore-table th{padding:10px 12px;border-bottom:1px solid var(--rule);text-align:right;font-weight:400;min-width:120px;font-variant-numeric:tabular-nums}.explore-table th:first-child{text-align:left}.explore-table thead th{font-weight:600;max-width:280px}.explore-table td small{display:block;font-size:.8rem}#explore-provenance{display:grid;grid-template-columns:160px 1fr;gap:12px 24px;font-family:var(--sans);font-size:.9rem;line-height:1.6}#explore-provenance dt{color:var(--ink-soft)}#explore-provenance dd{margin:0;overflow-wrap:anywhere}#explore-guides a{display:block;margin:12px 0}.explore-guide-list{columns:2}@media(max-width:680px){#explore-provenance{grid-template-columns:1fr;gap:6px}#explore-provenance dd{margin-bottom:12px}.explore-guide-list{columns:1}#explore-range label{flex:1;min-width:125px}.explore-page h2{font-size:1.7rem}}
</style>
