    {
      "id": "TUS-R1",
      "priority": "required",
      "file": "src/dossiers/time-use.model.js",
      "line": 100,
      "finding": "Location rates overlap; the caption implies a distribution, and the title promises unpaid work while the filter selects paid work only.",
      "evidence": {
        "sourceTable": "t39",
        "femalePaidLocationRates": [
          28.2,
          78.7,
          0.5
        ],
        "sum": 107.4,
        "groupsWithOverlappingRates": 27,
        "totalGroups": 27,
        "pairedLocationTimeMaximumResidualMinutes": 0.664
      },
      "remedy": "Explain overlapping location participation, name its participant universe, distinguish paid and unpaid panels, and keep the all-locations control separate from actual locations.",
      "resolution": {
        "status": "implemented",
        "change": "Six paid/unpaid/combined location plates, explicit overlap and participant universe, control excluded from plotted locations, 27 rounding-bounded duration identities."
      }
    },
    {
      "id": "TUS-R2",
      "priority": "required",
      "file": "src/dossiers/time-use.model.js",
      "line": 90,
      "finding": "All six age participation captions refer to participant-duration companions, but the age-duration plots use Table 8 per-person time.",
      "remedy": "Use measure-specific age explanations and name population averages and participant averages consistently.",
      "resolution": {
        "status": "implemented",
        "change": "Age participation explicitly paired with per-person time; measure stored in chart payload and facts."
      }
    },
    {
      "id": "TUS-R3",
      "priority": "required for the stated comprehensive edition",
      "file": "src/dossiers/time-use.model.js",
      "line": 86,
      "finding": "The six-category allowlist omits volunteering, social/religious time and personal care/sleep across the six detailed dimensions.",
      "remedy": "Review and explain those published cuts; EveryCut access alone does not complete the analytical treatment.",
      "resolution": {
        "status": "implemented",
        "change": "All nine divisions now shown for all six demographic dimensions and rural/urban comparisons."
      }
    },
    {
      "id": "TUS-R4",
      "priority": "editorial improvement",
      "file": "src/dossiers/time-use.model.js",
      "line": 82,
      "finding": "Spending groups are sector-relative fifths from the survey short consumption module; source labels 0-20 to 80-100 are opaque in standalone charts.",
      "remedy": "Use lowest-to-highest fifth labels and explain sector-specific ranks beside the lead claim, with no implied rupee, income or HCES equivalence.",
      "resolution": {
        "status": "implemented",
        "change": "Human fifth labels and sector-relative short-module definitions beside lead claims and at chapter level."
      }
    },
    {
      "id": "TUS-R5",
      "priority": "editorial improvement",
      "file": "src/dossiers/time-use.model.js",
      "line": 19,
      "finding": "121 plates use only 33 distinct explainers, frequently reusing methodological caveats without a data-specific reading.",
      "remedy": "Give each substantive comparison a source-traced takeaway; put recurring methodological notes at chapter level.",
      "resolution": {
        "status": "implemented",
        "change": "Every plate now has a deterministic reading from plotted source cells, retained in facts and checked by rendered QC; recurring dimension definitions moved to chapters."
      }
    },
